/** A member's family and its own effort (null when it has none). */
export const memberOf = (m) => (isObj(m) ? { family: m.family, effort: m.effort } : { family: m, effort: null });

/** Role names a family should not be given. A name no role has is allowed here: avoidWarnings reports it. */
function roleList(where, v) {
