let usagePaintGen = 0;
async function paintUsage() {
  const c = $('content');
  // Only the newest paint may land: the 60 s timer and a Refresh can overlap.
  const gen = ++usagePaintGen;
  let u, paused;
  try {
    // The pauses are read beside the usage, never instead of it: without them each row just offers no switch.
    [u, paused] = await Promise.all([api('GET', '/api/usage'), api('GET', '/api/pause').catch(() => null)]);
  }
  catch (e) { if (gen === usagePaintGen) c.innerHTML = `<div class="scope"><div class="scope-sub">${esc(e.message)}</div></div>`; return; }
  if (S.view !== 'usage' || gen !== usagePaintGen) return;   // the view changed, or a newer paint started

  const seats = rankSeats(u.seats);
  }
}

/** --role / --flavor / --roles, with --json anywhere among them. */
function rolesCli(argv, R) {
  const die = (why, stdout = '') => {
    process.stderr.write(`model-id: ${why}\n`);
    process.stdout.write(stdout);
    process.exit(2);
  };
  const opts = { json: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--json') opts.json = true;
    else if (a === '--no-alt') opts.noAlt = true;
    else if (a === '--roles') opts.roles = true;
    else if (a === '--role' || a === '--flavor' || a === '--effort') {
      const v = argv[++i];
      if (v === undefined || v.startsWith('-')) die(`${a} needs a name`);
      opts[a.slice(2)] = v;
    } else die(`unexpected argument ${JSON.stringify(a)} — ${FULL_USAGE}`);
  }
  // With --effort, --role names the roles to look in, not a role to print.
  const asked = opts.effort !== undefined ? [opts.effort, opts.flavor, opts.roles] : [opts.role, opts.flavor, opts.roles];
  if (asked.filter((v) => v !== undefined).length !== 1) {
    die(`ask one thing at a time — ${FULL_USAGE}`);
  }
  if (R.missing) die(R.missing, opts.role !== undefined && opts.effort === undefined && !opts.json ? unresolvedRole(opts.role) : '');
  if (opts.noAlt && opts.effort === undefined) die('--no-alt goes with --effort');
  const { familyEffort, loadRoles, resolveFlavor, resolveRole } = R;
  if (opts.effort !== undefined) {
    const roles = opts.role === undefined ? [] : opts.role.split(',').map((n) => n.trim());
    if (roles.some((n) => !n)) die('--role takes role names separated by commas');
    const e = familyEffort(opts.effort, roles, { alt: !opts.noAlt });
    if (e.error) die(e.error);
    if (opts.json) process.stdout.write(JSON.stringify(e, null, 2) + '\n');
    else if (e.effort) process.stdout.write(`${e.effort}\n`);
  } else if (opts.role !== undefined) {
    const r = resolveRole(opts.role);
    pauseNotes(R, [r]);
    if (r.error) die(r.error, opts.json ? '' : unresolvedRole(opts.role));
    if (opts.json) process.stdout.write(JSON.stringify(r, null, 2) + '\n');
    else process.stdout.write(`family=${r.family} id=${r.id} effort=${r.effort} alt=${r.alt}\n`);
  } else if (opts.flavor !== undefined) {
    const f = resolveFlavor(opts.flavor);
    if (f.error) die(f.error);
    if (opts.json) process.stdout.write(JSON.stringify(f, null, 2) + '\n');
    else process.stdout.write(f.text);
  } else if (opts.json) {
    const loaded = loadRoles();
    if (loaded.error) die(`roles are invalid — ${loaded.error}`);
    const roles = Object.fromEntries(Object.keys(loaded.roles).sort().map((n) => [n, resolveRole(n)]));
    pauseNotes(R, Object.values(roles));
    const unset = loaded.unset?.length ? { unset: loaded.unset } : {};
    process.stdout.write(JSON.stringify({ roles, ...unset, flavor: loaded.flavor, provenance: loaded.provenance, source: loaded.source }, null, 2) + '\n');
    if (Object.values(roles).some((r) => r.error)) process.exit(2);
  } else {
    const s = rolesSection(R);
    if (s.error) die(R.missing || `roles are invalid — ${s.error}`);
    process.stdout.write(s.text);
    if (s.failed) process.exit(2);
  }
}
