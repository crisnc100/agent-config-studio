diff --git a/tests/pause-cli.mjs b/tests/pause-cli.mjs
new file mode 100644
index 0000000..c856176
--- /dev/null
+++ b/tests/pause-cli.mjs
@@ -0,0 +1,116 @@
+/**
+ * `acs pause` / `acs resume` and the one writer behind them, lib/pause.js
+ * (builds/pause-account R1, R6, R9): run through bin/acs against temp HOMEs.
+ * A stale installed resolver refuses a pause before anything is written.
+ */
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const ACS = path.join(ROOT, 'bin', 'acs');
+const J = JSON.stringify;
+let pass = 0, fail = 0;
+const ok = (name, cond, detail = '') => {
+  if (cond) { pass++; console.log(`  ok   ${name}`); }
+  else { fail++; console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ''}`); }
+};
+
+const tmp = fs.realpathSync(tempDir('acs-pause-cli-'));
+const write = (file, body) => { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, body); };
+let n = 0;
+function home({ roles = { version: 2, roles: { reviewer: { use: ['fable', 'sol'] }, builder: { use: ['opus', 'sol'] }, advisor: { use: 'fable' } } }, snapshot } = {}) {
+  const h = path.join(tmp, `home-${++n}`);
+  write(path.join(h, '.agent-config-studio', 'roles.json'), J(roles));
+  if (snapshot) write(path.join(h, '.agent-config-studio', 'usage-snapshot.json'), J(snapshot));
+  return h;
+}
+const pausedFile = (h) => path.join(h, '.agent-config-studio', 'paused.json');
+const readPausedFile = (h) => { try { return JSON.parse(fs.readFileSync(pausedFile(h), 'utf8')); } catch { return null; } };
+const acs = (h, ...args) => {
+  const r = spawnSync('/bin/sh', [ACS, ...args], { encoding: 'utf8', env: { HOME: h, PATH: `${path.dirname(process.execPath)}:/usr/bin:/bin`, NO_COLOR: '1', ACS_NO_UPDATE: '1', ACS_NO_OPEN: '1' } });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+};
+const HOUR = 3600_000;
+
+console.log('\npause cli: R9 — pause, list, resume');
+{
+  const h = home();
+  const empty = acs(h, 'pause');
+  ok('acs pause with nothing paused: says so, exit 0, writes nothing', empty.code === 0 && empty.out === 'Nothing is paused.\n' && !fs.existsSync(pausedFile(h)), J(empty));
+
+  const p = acs(h, 'pause', 'claude', '--until-resume');
+  ok('acs pause claude --until-resume: exit 0, says until you resume', p.code === 0 && p.out === 'claude paused until you resume.\n', J(p));
+  ok('…paused.json holds one entry with no until', J(readPausedFile(h)) === J({ version: 1, paused: [{ name: 'claude' }] }), J(readPausedFile(h)));
+  const roles = fs.readFileSync(path.join(h, '.agent-config-studio', 'roles.json'), 'utf8');
+
+  const l = acs(h, 'pause');
+  ok('acs pause lists it and what each role answers now', l.code === 0 && /^claude paused until you resume$/m.test(l.out)
+    && /^ {2}reviewer → sol \(skipped fable\)$/m.test(l.out) && /^ {2}builder → sol \(skipped opus\)$/m.test(l.out) && /^ {2}advisor: refuses — every model for it is paused$/m.test(l.out), l.out);
+  ok('…and the same-vendor note when builder and reviewer now share one', /builder and reviewer both run on codex now, so codex checks its own work\./.test(l.out), l.out);
+
+  const at = new Date(Date.now() + 2 * HOUR).toISOString();
+  const f = acs(h, 'pause', 'fable', '--until', at);
+  ok('acs pause fable --until <time>: exit 0, stored as given', f.code === 0 && J(readPausedFile(h).paused) === J([{ name: 'claude' }, { name: 'fable', until: at }]), J({ f, file: readPausedFile(h) }));
+
+  const r = acs(h, 'resume', 'claude');
+  ok('acs resume claude: exit 0, its entry gone, the other kept', r.code === 0 && r.out === 'claude resumed.\n' && J(readPausedFile(h).paused) === J([{ name: 'fable', until: at }]), J({ r, file: readPausedFile(h) }));
+  ok('roles.json was never written', fs.readFileSync(path.join(h, '.agent-config-studio', 'roles.json'), 'utf8') === roles);
+
+  const again = acs(h, 'resume', 'claude');
+  ok('resuming what is not paused: exit 1, says so', again.code === 1 && /claude is not paused/.test(again.err), J(again));
+  const unknown = acs(h, 'pause', 'opuss', '--until-resume');
+  ok('an unknown name: exit 2, lists what can be paused', unknown.code === 2 && /"opuss" is not an account \(claude, codex, grok\) or a model family/.test(unknown.err), J(unknown));
+  const past = acs(h, 'pause', 'codex', '--until', new Date(Date.now() - HOUR).toISOString());
+  ok('a time already passed: exit 2, nothing written', past.code === 2 && /has already passed/.test(past.err) && !readPausedFile(h).paused.some((e) => e.name === 'codex'), J(past));
+  const junk = acs(h, 'pause', 'codex', '--until', 'soonish');
+  ok('a time that is not one: exit 2', junk.code === 2 && /is not a date and time/.test(junk.err), J(junk));
+  const usage = acs(h, 'pause', 'codex', '--bogus');
+  ok('an unknown flag: exit 2 with the usage line', usage.code === 2 && /usage: acs pause/.test(usage.err), J(usage));
+}
+
+console.log('\npause cli: with no flag, a pause ends at the account\'s reset when a reading has one');
+{
+  const reset = Date.now() + 3 * HOUR;
+  const h = home({ snapshot: { takenAt: Date.now(), seats: [
+    { seatId: 'c1', vendor: 'claude', ok: true, windows: [{ label: '5h', usedPercent: 40, resetsAt: Date.now() + HOUR }, { label: 'week', usedPercent: 97, resetsAt: reset }] },
+    { seatId: 'x1', vendor: 'codex', ok: true, windows: [{ label: 'week', usedPercent: 99, resetsAt: Date.now() + 9 * HOUR }] },
+  ] } });
+  const p = acs(h, 'pause', 'claude');
+  ok('acs pause claude: until the tightest claude window resets', p.code === 0 && readPausedFile(h).paused[0].until === new Date(reset).toISOString(), J({ p, file: readPausedFile(h) }));
+  const fam = acs(h, 'pause', 'opus');
+  ok('a family takes its vendor\'s reset', fam.code === 0 && readPausedFile(h).paused[1].until === new Date(reset).toISOString(), J(readPausedFile(h)));
+  const g = acs(h, 'pause', 'grok');
+  ok('no reading for that vendor: until you resume, and it says how to end it', g.code === 0 && !('until' in readPausedFile(h).paused[2]) && /run acs resume when it has room again/.test(g.out), J(g));
+}
+
+console.log('\npause cli: an invalid paused.json is reported, never rewritten');
+{
+  const h = home();
+  write(pausedFile(h), '{ nope');
+  const l = acs(h, 'pause');
+  ok('acs pause: exit 1, names the file and that nothing is paused', l.code === 1 && /paused\.json: not valid JSON/.test(l.err) && /Nothing is paused until it is fixed or deleted/.test(l.err), J(l));
+  const p = acs(h, 'pause', 'claude', '--until-resume');
+  ok('pausing refuses, and the file keeps its bytes', p.code === 1 && /paused\.json is invalid/.test(p.err) && fs.readFileSync(pausedFile(h), 'utf8') === '{ nope', J(p));
+}
+
+console.log('\npause cli: R6 — a stale installed resolver refuses the pause');
+{
+  const h = home();
+  const installed = path.join(h, '.agent-config-studio', 'resolver', 'lib', 'roles.js');
+  write(installed, '// an older roles.js, from before paused.json\n');
+  const p = acs(h, 'pause', 'claude', '--until-resume');
+  ok('refused, with the re-install fix', p.code === 1 && p.err.includes('Your installed model-id is older than this version of ACS and would ignore a pause. Run: acs install-model-id, then pause again.'), J(p));
+  ok('…and nothing is written', !fs.existsSync(pausedFile(h)));
+  fs.copyFileSync(path.join(ROOT, 'lib', 'roles.js'), installed);
+  const same = acs(h, 'pause', 'claude', '--until-resume');
+  ok('an installed copy identical to this one: the pause goes through', same.code === 0 && readPausedFile(h)?.paused?.[0]?.name === 'claude', J(same));
+  write(installed, '// stale again\n');
+  const r = acs(h, 'resume', 'claude');
+  ok('resuming is never refused for a stale resolver (an old one ignores pauses anyway)', r.code === 0 && J(readPausedFile(h).paused) === '[]', J(r));
+}
+
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/tests/pause-routes.mjs b/tests/pause-routes.mjs
new file mode 100644
index 0000000..19dfe37
--- /dev/null
+++ b/tests/pause-routes.mjs
@@ -0,0 +1,121 @@
+/**
+ * The pause routes through the real server (builds/pause-account R6, R7, R8):
+ * a `node server.js` with HOME redirected to a temp dir. Strict same-origin,
+ * the stale-resolver refusal before any write, and the Roles view's notice
+ * data. roles.json is never written.
+ */
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { snapshotRealHomes, assertRealHomesUnchanged } from './real-home.mjs';
+import { tempDir, track } from './fixtures/cleanup.mjs';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const realBefore = snapshotRealHomes();
+const J = JSON.stringify;
+let pass = 0, fail = 0;
+const ok = (name, cond, detail = '') => {
+  if (cond) { pass++; console.log(`  ok   ${name}`); }
+  else { fail++; console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ''}`); }
+};
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const s = net.createServer();
+    s.once('error', reject);
+    s.listen(0, '127.0.0.1', () => { const p = s.address().port; s.close(() => resolve(p)); });
+  });
+}
+
+const home = fs.realpathSync(tempDir('acs-pause-routes-'));
+const studio = path.join(home, '.agent-config-studio');
+fs.mkdirSync(studio, { recursive: true });
+const ROLES = J({ version: 2, roles: { builder: { use: ['opus', 'sol'] }, reviewer: { use: ['fable', 'sol'] }, advisor: { use: 'fable', alt: 'astra' } } });
+fs.writeFileSync(path.join(studio, 'roles.json'), ROLES);
+const pausedFile = path.join(studio, 'paused.json');
+const readPaused = () => { try { return JSON.parse(fs.readFileSync(pausedFile, 'utf8')); } catch { return null; } };
+
+const port = await freePort();
+const child = spawn(process.execPath, [path.join(ROOT, 'server.js')], {
+  cwd: ROOT, env: { HOME: home, PORT: String(port), PATH: `${path.dirname(process.execPath)}:/usr/bin:/bin`, TMPDIR: os.tmpdir() }, stdio: ['ignore', 'pipe', 'pipe'],
+}); track(child);
+let log = '';
+child.stdout.on('data', (d) => { log += d; });
+child.stderr.on('data', (d) => { log += d; });
+const base = `http://localhost:${port}`;
+let up = false;
+for (let i = 0; i < 100 && !up; i++) {
+  try { up = (await fetch(`${base}/api/health`)).ok; } catch {}
+  if (!up) await sleep(100);
+}
+if (!up) { console.log(`server did not start: ${log.slice(-600)}`); process.exit(1); }
+
+const SAME = { 'sec-fetch-site': 'same-origin' };
+async function call(method, route, body, headers = SAME) {
+  const r = await fetch(`${base}${route}`, { method, headers: { 'content-type': 'application/json', ...headers }, body: body === undefined ? undefined : J(body) });
+  const text = await r.text();
+  let json = null;
+  try { json = JSON.parse(text); } catch {}
+  return { status: r.status, body: json };
+}
+
+try {
+  console.log('\npause routes: strict same-origin, before any write');
+  for (const [route, method, body] of [['/api/pause', 'GET'], ['/api/pause', 'POST', { name: 'claude', until: null }], ['/api/pause/resume', 'POST', { name: 'claude' }]]) {
+    const r = await call(method, route, body, { origin: 'https://evil.example', 'sec-fetch-site': 'cross-site' });
+    ok(`${method} ${route} from another site → 403`, r.status === 403, J(r));
+  }
+  ok('…and nothing was written', !fs.existsSync(pausedFile));
+
+  console.log('\npause routes: R7 — pause and resume');
+  const g = await call('GET', '/api/pause');
+  ok('GET /api/pause: nothing paused', g.status === 200 && J(g.body.entries) === '[]' && g.body.error === null && g.body.resolverStale === false, J(g));
+  const until = new Date(Date.now() + 3600_000).toISOString();
+  const p = await call('POST', '/api/pause', { name: 'claude', until });
+  ok('POST /api/pause: claude until a time', p.status === 200 && J(readPaused()) === J({ version: 1, paused: [{ name: 'claude', until }] }), J({ p, file: readPaused() }));
+  ok('…the answer lists it as in force, with its vendor', J(p.body.entries) === J([{ name: 'claude', kind: 'vendor', vendor: 'claude', until, active: true }]), J(p.body));
+  const fam = await call('POST', '/api/pause', { name: 'sol', until: null });
+  ok('a family, until resumed: its vendor comes from its id', fam.status === 200 && fam.body.entries.find((e) => e.name === 'sol')?.vendor === 'codex', J(fam.body));
+  const bad = await call('POST', '/api/pause', { name: 'nobody', until: null });
+  ok('an unknown name → 400', bad.status === 400 && /is not an account/.test(bad.body.error), J(bad));
+  const past = await call('POST', '/api/pause', { name: 'codex', until: '2001-01-01T00:00:00Z' });
+  ok('a past time → 400', past.status === 400 && /already passed/.test(past.body.error), J(past));
+
+  console.log('\npause routes: R8 — the Roles view carries what the pauses do');
+  const v = await call('GET', '/api/models/roles');
+  const by = Object.fromEntries((v.body.pause?.roles || []).map((r) => [r.name, r]));
+  ok('the roles view has the pause state', v.status === 200 && J(v.body.pause.active) === J(['claude', 'sol']), J(v.body.pause));
+  ok('advisor refuses (fable only), reviewer and builder refuse too with sol also paused', by.advisor?.refuses === true && by.reviewer?.refuses === true && by.builder?.refuses === true, J(by));
+  await call('POST', '/api/pause/resume', { name: 'sol' });
+  const v2 = (await call('GET', '/api/models/roles')).body.pause;
+  const by2 = Object.fromEntries(v2.roles.map((r) => [r.name, r]));
+  ok('with only claude paused: reviewer → sol (skipped fable), builder → sol', by2.reviewer.family === 'sol' && J(by2.reviewer.skipped) === J([{ family: 'fable', by: 'claude' }]) && by2.builder.family === 'sol', J(by2));
+  ok('…and builder and reviewer now share codex', v2.sameVendor === 'codex', J(v2));
+  ok('roles.json was never written', fs.readFileSync(path.join(studio, 'roles.json'), 'utf8') === ROLES);
+  const r = await call('POST', '/api/pause/resume', { name: 'claude' });
+  ok('POST /api/pause/resume: nothing left paused', r.status === 200 && J(readPaused()) === J({ version: 1, paused: [] }), J(readPaused()));
+  ok('the roles view then has no effect to show', J((await call('GET', '/api/models/roles')).body.pause.roles) === '[]');
+
+  console.log('\npause routes: R6 — a stale installed resolver refuses the pause');
+  const installed = path.join(studio, 'resolver', 'lib', 'roles.js');
+  fs.mkdirSync(path.dirname(installed), { recursive: true });
+  fs.writeFileSync(installed, '// an older roles.js\n');
+  const before = fs.readFileSync(pausedFile, 'utf8');
+  const s = await call('GET', '/api/pause');
+  ok('GET says so, with the fix', s.body.resolverStale === true && /would ignore a pause\. Run: acs install-model-id/.test(s.body.staleFix), J(s.body));
+  const refused = await call('POST', '/api/pause', { name: 'claude', until: null });
+  ok('POST → 409 naming acs install-model-id', refused.status === 409 && /Run: acs install-model-id, then pause again/.test(refused.body.error), J(refused));
+  ok('…and nothing is written', fs.readFileSync(pausedFile, 'utf8') === before);
+  fs.copyFileSync(path.join(ROOT, 'lib', 'roles.js'), installed);
+  const fine = await call('POST', '/api/pause', { name: 'claude', until: null });
+  ok('an identical installed copy: the pause goes through', fine.status === 200 && readPaused().paused[0]?.name === 'claude', J(fine));
+} finally {
+  child.kill('SIGKILL');
+}
+assertRealHomesUnchanged(realBefore, ok);
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/tests/pause-ui.mjs b/tests/pause-ui.mjs
new file mode 100644
index 0000000..30807b2
--- /dev/null
+++ b/tests/pause-ui.mjs
@@ -0,0 +1,167 @@
+/**
+ * The Pause switch on Usage and its effect on Models → Roles
+ * (builds/pause-account R7, R8, R11) in the fake DOM against stubbed routes:
+ * what each row offers, what each button sends, and the notice the Roles
+ * section shows while anything is paused. No server, no HOME.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { ROOT, bootPage, routesFor, settle } from './fixtures/shell-page.mjs';
+
+let pass = 0, fail = 0;
+const ok = (name, cond, detail = '') => {
+  if (cond) { pass++; console.log(`  ok   ${name}`); }
+  else { fail++; console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ''}`); }
+};
+const J = JSON.stringify;
+const HOUR = 3600_000;
+const RESET = Date.now() + 5 * HOUR;
+const SEATS = [
+  { seatId: 'c1', label: 'Claude Max', vendor: 'claude', ok: true, windows: [
+    { label: '5h', usedPercent: 30, resetsAt: Date.now() + HOUR }, { label: 'week', usedPercent: 92, resetsAt: RESET }] },
+  { seatId: 'x1', label: 'Codex Pro', vendor: 'codex', ok: true, windows: [{ label: 'week', usedPercent: 10 }] },
+];
+const state = (entries = [], over = {}) => ({
+  entries, active: entries.filter((e) => e.active).map((e) => e.name), error: null, resolverStale: false, staleFix: null, vendors: ['claude', 'codex', 'grok'], ...over,
+});
+const text = (n) => n.textContent.replace(/\s+/g, ' ').trim();
+const buttons = (root) => root.querySelectorAll('button');
+const button = (root, t) => buttons(root).find((b) => text(b) === t || text(b).startsWith(t));
+const card = (p, id) => p.$('content').querySelectorAll('.usage-seat').find((c) => c.dataset.seat === id);
+const posts = (p, route) => p.requests.filter((r) => r.method === 'POST' && r.path === route);
+
+async function usage(pause, extra = {}) {
+  const st = { pause };
+  const routes = routesFor({
+    'GET /api/usage': () => ({ seats: SEATS }),
+    'GET /api/pause': () => (typeof st.pause === 'function' ? st.pause() : st.pause),
+    'POST /api/pause': (b) => { st.pause = state([{ name: b.name, kind: 'vendor', vendor: b.name, until: b.until, active: true }]); return st.pause; },
+    'POST /api/pause/resume': () => { st.pause = state(); return st.pause; },
+    ...extra,
+  });
+  const p = await bootPage({ routes, hash: '#usage' });
+  await settle(20);
+  return p;
+}
+
+console.log('\npause ui: R7 — the switch on each Usage row');
+{
+  const p = await usage(state());
+  const c = card(p, 'c1');
+  const pause = button(c, 'Pause');
+  ok('each account row has a Pause button, styled as a secondary button', pause && pause.className === 'btn' && button(card(p, 'x1'), 'Pause'), c && text(c));
+  pause.click();
+  await settle(10);
+  const c2 = card(p, 'c1');
+  const at = buttons(c2).find((b) => /^Until it resets \(/.test(text(b)));
+  ok('pausing offers "until it resets", pre-filled from the reading, as the primary choice', at && at.className === 'btn primary' && text(at).includes(new Date(RESET).toLocaleString([], { hour: 'numeric', minute: '2-digit' })), c2 && text(c2));
+  ok('…"Until I resume" as the secondary, and Cancel as a quiet button', button(c2, 'Until I resume')?.className === 'btn' && button(c2, 'Cancel')?.className === 'btn ghost');
+  at.click();
+  await settle(20);
+  const sent = posts(p, '/api/pause');
+  ok('"until it resets" sends the vendor and the reset time', sent.length === 1 && sent[0].body.name === 'claude' && sent[0].body.until === new Date(RESET).toISOString(), J(sent));
+  const c3 = card(p, 'c1');
+  ok('a paused account shows "Paused until …" and a Resume button', /Paused until .* — roles skip claude models/.test(text(c3)) && button(c3, 'Resume')?.className === 'btn', text(c3));
+  button(c3, 'Resume').click();
+  await settle(20);
+  ok('Resume sends the name', posts(p, '/api/pause/resume').length === 1 && posts(p, '/api/pause/resume')[0].body.name === 'claude');
+  ok('…and the row offers Pause again', button(card(p, 'c1'), 'Pause') && !/Paused/.test(text(card(p, 'c1'))));
+}
+{
+  const p = await usage(state());
+  button(card(p, 'x1'), 'Pause').click();
+  await settle(10);
+  const c = card(p, 'x1');
+  ok('a reading with no reset time: only "Until I resume" (primary), no reset choice', !buttons(c).some((b) => /Until it resets/.test(text(b))) && button(c, 'Until I resume')?.className === 'btn primary', text(c));
+  button(c, 'Until I resume').click();
+  await settle(20);
+  const sent = posts(p, '/api/pause');
+  ok('"Until I resume" sends until: null', sent.length === 1 && J(sent[0].body) === J({ name: 'codex', until: null }), J(sent));
+  ok('…and the row says "Paused until you resume"', /Paused until you resume/.test(text(card(p, 'x1'))));
+}
+{
+  const p = await usage(state([{ name: 'claude', kind: 'vendor', vendor: 'claude', until: null, active: true },
+    { name: 'sol', kind: 'family', vendor: 'codex', until: new Date(RESET).toISOString(), active: true }]));
+  ok('a family paused by name shows on its vendor\'s row with its own Resume', /sol paused until/.test(text(card(p, 'x1'))) && button(card(p, 'x1'), 'Resume sol')?.className === 'btn ghost', text(card(p, 'x1')));
+  ok('…and the vendor is still offered a Pause of its own', !!button(card(p, 'x1'), 'Pause'));
+}
+{
+  const fix = 'Your installed model-id is older than this version of ACS and would ignore a pause. Run: acs install-model-id, then pause again.';
+  const p = await usage(state([], { resolverStale: true, staleFix: fix }));
+  const b = button(card(p, 'c1'), 'Pause');
+  ok('a stale resolver: Pause is disabled and the row names the fix', b?.disabled === true && text(card(p, 'c1')).includes(fix), text(card(p, 'c1')));
+  const refused = await usage(state(), { 'POST /api/pause': () => { throw { status: 409, body: { error: fix } }; } });
+  button(card(refused, 'c1'), 'Pause').click();
+  await settle(10);
+  button(card(refused, 'c1'), 'Until I resume').click();
+  await settle(20);
+  ok('a refusal from the server is shown as given', text(refused.$('notice-slot')).includes(fix), text(refused.$('notice-slot')));
+}
+{
+  const p = await usage(state([], { error: '~/.agent-config-studio/paused.json: not valid JSON' }));
+  ok('an invalid paused.json: one error naming it, and Pause disabled', /paused\.json is invalid, so nothing is paused/.test(text(p.$('content'))) && button(card(p, 'c1'), 'Pause')?.disabled === true, text(p.$('content')));
+  const none = await usage(null, { 'GET /api/pause': () => { throw { status: 500, body: { error: 'boom' } }; } });
+  ok('the pause state unreadable: usage still shows, with no switch', !!card(none, 'c1') && !button(card(none, 'c1'), 'Pause'));
+}
+
+console.log('\npause ui: R8 — the effect on Models → Roles');
+const ROLES_VIEW = (pause) => ({
+  roles: [
+    { name: 'builder', use: ['opus', 'sol'], ids: ['opus-id', 'sol-id'], effort: 'medium', resolvedEffort: 'medium', alt: '', altId: '', note: '', custom: false, provenance: {}, defaults: null, warnings: [] },
+    { name: 'reviewer', use: ['fable', 'sol'], ids: ['fable-id', 'sol-id'], effort: '', resolvedEffort: '', alt: '', altId: '', note: '', custom: false, provenance: {}, defaults: null, warnings: [] },
+  ],
+  flavor: [], families: ['fable', 'opus', 'sol'], efforts: ['low', 'medium', 'high', 'xhigh', 'max'],
+  limits: { brief: 600, item: 160, items: 12, note: 160, use: 8 }, base: 'sha256:b', userText: '{}\n', error: null, userFile: '~/.agent-config-studio/roles.json',
+  describe: { harness: 'claude', label: 'Claude', installed: true, model: 'm', modelLabel: 'M', ready: true, why: null, running: false, limits: { description: 4000 } },
+  pause,
+});
+async function roles(pause) {
+  const routes = routesFor({
+    'GET /api/models': () => ({ pending: 0, checkedAt: Date.now(), catalogs: [], claudeVersion: null, rows: [] }),
+    'GET /api/models/roles': () => ROLES_VIEW(pause),
+    'GET /api/usage': () => ({ seats: SEATS }),
+    'GET /api/pause': () => state(),
+  });
+  const p = await bootPage({ routes, hash: '#models' });
+  await settle(20);
+  return p;
+}
+{
+  const p = await roles({ ...state([{ name: 'claude', kind: 'vendor', vendor: 'claude', until: null, active: true }]),
+    roles: [
+      { name: 'advisor', refuses: true, error: 'every model for advisor is paused', family: '', skipped: [{ family: 'fable', by: 'claude' }], altSkipped: null },
+      { name: 'builder', refuses: false, error: null, family: 'sol', skipped: [{ family: 'opus', by: 'claude' }], altSkipped: null, alt: '' },
+      { name: 'reviewer', refuses: false, error: null, family: 'sol', skipped: [{ family: 'fable', by: 'claude' }], altSkipped: { family: 'astra', by: 'codex' }, alt: '' },
+      { name: 'scout', refuses: false, error: null, family: 'sol', skipped: [], altSkipped: null, alt: '' },
+    ],
+    sameVendor: 'codex' });
+  const n = p.$('content').querySelector('.roles-pause');
+  const t = n ? text(n) : '';
+  ok('a notice on Roles names what is paused', n && /Paused: claude until you resume/.test(t), t);
+  ok('…each role\'s answer now, with what it skips', /builder → sol \(skips opus\)/.test(t) && /reviewer → sol \(skips fable; no second opinion \(astra is paused\)\)/.test(t) && /scout → sol/.test(t), t);
+  ok('…marks a role that would refuse', /advisor: refuses — every model for it is paused/.test(t), t);
+  ok('…and the same-vendor note', /Builder and reviewer both run on codex now, so codex checks its own work\./.test(t), t);
+  const go = button(n, 'Pause or resume on Usage');
+  ok('…with a quiet button to the switch', go?.className === 'btn ghost');
+  go.click();
+  await settle(20);
+  ok('…which opens Usage', p.$('content').querySelectorAll('.usage-seat').length === 2);
+}
+{
+  const p = await roles({ ...state(), roles: [], sameVendor: null });
+  ok('nothing paused: no notice on Roles', !p.$('content').querySelector('.roles-pause'));
+}
+
+console.log('\npause ui: R11 — styles');
+{
+  const css = fs.readFileSync(path.join(ROOT, 'public', 'styles.css'), 'utf8').replace(/\/\*[\s\S]*?\*\//g, '');
+  const rules = [...css.matchAll(/([^{}]+)\{([^{}]*)\}/g)].filter((m) => /(usage-pause|roles-pause)/.test(m[1]));
+  ok('the pause rules exist', rules.length >= 5, String(rules.length));
+  const small = rules.flatMap((m) => [...m[2].matchAll(/font(?:-size)?\s*:\s*[^;]*?(\d*\.?\d+)px/g)].map((v) => Number(v[1]))).filter((v) => v < 12);
+  ok('no pause text under 12px', small.length === 0, J(small));
+  const literal = rules.filter((m) => /#[0-9a-f]{3,8}\b|rgb\(/i.test(m[2]));
+  ok('colours come from the theme variables, so light and dark both hold', literal.length === 0, J(literal.map((m) => m[1])));
+}
+
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/tests/roles-pause.mjs b/tests/roles-pause.mjs
new file mode 100644
index 0000000..10104cb
--- /dev/null
+++ b/tests/roles-pause.mjs
@@ -0,0 +1,237 @@
+/**
+ * Paused accounts in the resolver (builds/pause-account R1–R5): resolveRole
+ * in process, then model-id, ask-model and the review gate's reviewer pool
+ * as real child processes against temp HOMEs. No model is called: the CLIs
+ * on PATH are stubs.
+ */
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+import { guideText, loadRoles, pauseLine, readPaused, resolveRole } from '../lib/roles.js';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const MODEL_ID = path.join(ROOT, 'bin', 'model-id.mjs');
+const ASK = path.join(ROOT, 'tools', 'ask-model.mjs');
+const REVIEW = path.join(ROOT, 'packs', 'review-gate', 'runtime', 'review.mjs');
+const IDS = JSON.parse(fs.readFileSync(path.join(ROOT, 'models.default.json'), 'utf8')).models;
+const J = JSON.stringify;
+
+let pass = 0, fail = 0;
+const ok = (name, cond, detail = '') => {
+  if (cond) { pass++; console.log(`  ok   ${name}`); }
+  else { fail++; console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ''}`); }
+};
+
+const tmp = fs.realpathSync(tempDir('acs-pause-'));
+const write = (file, body) => { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, body); };
+const ROLES = {
+  version: 2,
+  roles: {
+    reviewer: { use: ['fable', 'sol'] },
+    advisor: { use: 'fable', alt: 'astra' },
+    writer: { use: ['opus'] },
+    builder: { use: [{ family: 'sol', effort: 'high' }, { family: 'opus', effort: 'medium' }], alt: 'fable' },
+    investigator: { use: ['fable', 'opus'] },
+  },
+};
+let n = 0;
+/** A HOME with these roles and, unless undefined, this paused.json (an object is written as JSON, a string as is). */
+function home(paused, roles = ROLES) {
+  const h = path.join(tmp, `home-${++n}`);
+  write(path.join(h, '.agent-config-studio', 'roles.json'), J(roles));
+  if (paused !== undefined) write(path.join(h, '.agent-config-studio', 'paused.json'), typeof paused === 'string' ? paused : J(paused));
+  return h;
+}
+const rolesBytes = (h) => fs.readFileSync(path.join(h, '.agent-config-studio', 'roles.json'), 'utf8');
+const HOUR = 3600_000;
+const later = new Date(Date.now() + HOUR).toISOString();
+const earlier = new Date(Date.now() - HOUR).toISOString();
+
+console.log('\npause: R1 — the file');
+{
+  const none = home(undefined);
+  const r = resolveRole('reviewer', { home: none });
+  ok('no paused.json: nothing is paused, the role answers as written', r.family === 'fable' && J(r.use) === J(['fable', 'sol']), J(r));
+  ok('…and the answer carries no pause fields at all', !('paused' in r) && !('skipped' in r) && !('altSkipped' in r) && !('pauseError' in r), J(r));
+  ok('readPaused on no file: empty, no error', J(readPaused({ home: none })) === J({ entries: [], active: [], error: null, file: path.join(none, '.agent-config-studio', 'paused.json') }));
+
+  for (const [label, body] of [
+    ['not JSON', '{ nope'],
+    ['an unknown key', { paused: [], extra: 1 }],
+    ['an unknown name', { paused: [{ name: 'opuss' }] }],
+    ['a bad until', { paused: [{ name: 'claude', until: 'tomorrow-ish' }] }],
+    ['a newer version', { version: 9, paused: [] }],
+  ]) {
+    const h = home(body);
+    const p = readPaused({ home: h });
+    const rr = resolveRole('reviewer', { home: h });
+    ok(`invalid (${label}): reported, nothing paused, no throw`, p.error && !p.active.length && rr.family === 'fable' && typeof rr.pauseError === 'string', J({ p, rr }));
+  }
+  const newer = readPaused({ home: home({ version: 9, paused: [] }) });
+  ok('a newer version names the fix', /newer than this resolver understands — run: acs install-model-id/.test(newer.error), newer.error);
+  const h = home({ paused: [{ name: 'claude' }] });
+  const before = rolesBytes(h);
+  resolveRole('reviewer', { home: h });
+  ok('resolving under a pause never writes roles.json', rolesBytes(h) === before);
+}
+
+console.log('\npause: R2 — resolution skips paused families');
+{
+  const vendor = home({ paused: [{ name: 'claude' }] });
+  const r = resolveRole('reviewer', { home: vendor });
+  ok('a paused vendor: reviewer → sol, its fable skipped', r.family === 'sol' && r.id === IDS.sol && J(r.use) === J(['sol']) && J(r.ids) === J([IDS.sol]), J(r));
+  const b = resolveRole('builder', { home: vendor });
+  ok('a paused vendor: builder keeps sol at its own effort, its claude fallback dropped', b.family === 'sol' && b.effort === 'high' && J(b.use) === J(['sol']) && J(b.members.map((m) => m.family)) === J(['sol']), J(b));
+  ok('…and its alt (fable) is skipped the same way, leaving it empty', b.alt === '' && b.altId === '' && b.altEffort === '' && b.altMember === null && J(b.altSkipped) === J({ family: 'fable', by: 'claude' }), J(b));
+
+  const fam = home({ paused: [{ name: 'fable' }] });
+  ok('a paused family: reviewer → sol', resolveRole('reviewer', { home: fam }).family === 'sol');
+  const inv = resolveRole('investigator', { home: fam });
+  ok('a paused family leaves its vendor\'s other families: investigator → opus', inv.family === 'opus' && inv.id === IDS.opus, J(inv));
+
+  const codex = home({ paused: [{ name: 'codex' }] });
+  const a = resolveRole('advisor', { home: codex });
+  ok('a paused alt only: advisor still fable, second opinion empty', a.family === 'fable' && a.alt === '' && a.altId === '' && J(a.altSkipped) === J({ family: 'astra', by: 'codex' }) && J(a.skipped) === '[]', J(a));
+
+  const expired = home({ paused: [{ name: 'claude', until: earlier }] });
+  const e = resolveRole('reviewer', { home: expired });
+  ok('an expired pause is ignored', e.family === 'fable' && !('paused' in e), J(e));
+  const live = home({ paused: [{ name: 'claude', until: later }] });
+  ok('a pause until a later time holds', resolveRole('reviewer', { home: live }).family === 'sol');
+  ok('…and stops holding once that time passes', resolveRole('reviewer', { home: live, now: Date.now() + 2 * HOUR }).family === 'fable');
+}
+
+console.log('\npause: R3 — loud, never silent');
+{
+  const h = home({ paused: [{ name: 'claude' }] });
+  const r = resolveRole('reviewer', { home: h });
+  ok('the answer names what is paused and what was skipped', J(r.paused) === J(['claude']) && J(r.skipped) === J([{ family: 'fable', by: 'claude' }]), J(r));
+  ok('pauseLine is one plain line', pauseLine(r) === 'claude paused: reviewer → sol (skipped fable)', pauseLine(r));
+  const mid = (args, hh = h) => spawnSync(process.execPath, [MODEL_ID, ...args], { encoding: 'utf8', env: { HOME: hh, PATH: '/usr/bin:/bin' } });
+  const t = mid(['--role', 'reviewer']);
+  ok('model-id --role: exit 0, the new answer on stdout', t.status === 0 && t.stdout === `family=sol id=${IDS.sol} effort= alt=\n`, J(t));
+  ok('model-id --role: one stderr line naming the skip', t.stderr === 'model-id: claude paused: reviewer → sol (skipped fable)\n', t.stderr);
+  const j = mid(['--role', 'reviewer', '--json']);
+  const d = JSON.parse(j.stdout);
+  ok('model-id --role --json: carries paused and skipped', j.status === 0 && J(d.paused) === J(['claude']) && J(d.skipped) === J([{ family: 'fable', by: 'claude' }]) && d.family === 'sol', j.stdout);
+  const alt = mid(['--role', 'builder']);
+  ok('a skipped second opinion is said too', alt.stderr === 'model-id: claude paused: builder → sol (skipped opus; no second opinion: fable skipped)\n', alt.stderr);
+  const quiet = mid(['--role', 'reviewer'], home(undefined));
+  ok('nothing paused: stderr stays empty', quiet.status === 0 && quiet.stderr === '', J(quiet));
+  const bad = mid(['--role', 'reviewer'], home('{ nope'));
+  ok('an invalid paused.json: the role answers as written, and stderr says the file is ignored', bad.status === 0 && /^family=fable /.test(bad.stdout) && /paused\.json: not valid JSON .* — nothing is paused until it is fixed\n$/.test(bad.stderr), J(bad));
+  const all = mid(['--roles']);
+  ok('model-id --roles: each skipping role gets its line', /reviewer → sol/.test(all.stderr) && /builder → sol/.test(all.stderr), all.stderr);
+}
+
+console.log('\npause: R4 — a role with nothing left refuses');
+{
+  const h = home({ paused: [{ name: 'claude' }] });
+  const r = resolveRole('advisor', { home: h });
+  ok('advisor (fable only) refuses with the fix, never promoting its second opinion', r.error === 'every model for advisor is paused; resume claude or add a fallback in ACS → Models → Roles' && !r.family, J(r));
+  const w = resolveRole('writer', { home: h });
+  ok('the writer role is not exempt', w.error === 'every model for writer is paused; resume claude or add a fallback in ACS → Models → Roles', J(w));
+  const two = resolveRole('investigator', { home: home({ paused: [{ name: 'fable' }, { name: 'opus' }] }) });
+  ok('paused by two names: the fix names both', two.error === 'every model for investigator is paused; resume fable or opus or add a fallback in ACS → Models → Roles', J(two));
+  const m = spawnSync(process.execPath, [MODEL_ID, '--role', 'advisor'], { encoding: 'utf8', env: { HOME: h, PATH: '/usr/bin:/bin' } });
+  ok('model-id --role advisor: exit 2, the fix on stderr, unresolved ids on stdout', m.status === 2 && m.stderr === 'model-id: every model for advisor is paused; resume claude or add a fallback in ACS → Models → Roles\n'
+    && m.stdout === 'family=MODEL-ID-UNRESOLVED-advisor id=MODEL-ID-UNRESOLVED-advisor effort= alt=\n', J(m));
+  const mj = spawnSync(process.execPath, [MODEL_ID, '--role', 'writer', '--json'], { encoding: 'utf8', env: { HOME: h, PATH: '/usr/bin:/bin' } });
+  ok('model-id --role writer --json: exit 2, nothing on stdout', mj.status === 2 && mj.stdout === '' && /every model for writer is paused/.test(mj.stderr), J(mj));
+}
+
+console.log('\npause: R5 — a family named directly is never paused');
+{
+  const h = home({ paused: [{ name: 'claude' }] });
+  const f = spawnSync(process.execPath, [MODEL_ID, 'fable'], { encoding: 'utf8', env: { HOME: h, PATH: '/usr/bin:/bin' } });
+  ok('model-id fable while claude is paused: its id, no note', f.status === 0 && f.stdout === `${IDS.fable}\n` && f.stderr === '', J(f));
+}
+
+console.log('\npause: R10 — one sentence in the model guide, never a rewrite per pause');
+{
+  const free = home(undefined);
+  const paused = home({ paused: [{ name: 'claude' }] });
+  const a = guideText(loadRoles({ home: free }));
+  const b = guideText(loadRoles({ home: paused }));
+  ok('the guide says roles skip paused accounts and how to get the current answer',
+    a.includes('Roles skip paused accounts (ACS → Usage → Pause); `model-id --role <name>` gives the current answer.'), a);
+  ok('the guide is byte-identical whether or not anything is paused', a === b);
+}
+
+console.log('\npause: R11 — the README documents pausing');
+{
+  const readme = fs.readFileSync(path.join(ROOT, 'README.md'), 'utf8');
+  const sec = readme.slice(readme.indexOf('### Pausing an account'), readme.indexOf('## Model registry'));
+  ok('a Pausing section under Subscription usage', readme.indexOf('## Subscription usage') < readme.indexOf('### Pausing an account') && sec.length > 200);
+  ok('…naming the file, the refusal, named families and the CLI',
+    ['paused.json', 'roles.json` is never written', 'refuses with exit 2', 'never paused', 'acs install-model-id', 'acs pause', 'acs resume'].every((w) => sec.includes(w)), sec);
+}
+
+/* ── ask-model and the reviewer pool, with stub CLIs on PATH ─────────── */
+
+const BIN = path.join(tmp, 'bin');
+const LOG = path.join(tmp, 'calls.jsonl');
+const stub = (name) => `#!${process.execPath}
+const fs = require('node:fs');
+const a = process.argv.slice(2);
+if (a[0] === 'mcp') { process.stdout.write('[]'); process.exit(0); }
+fs.appendFileSync(${J(LOG)}, JSON.stringify({ name: ${J(name)}, argv: a }) + '\\n');
+const i = a.findIndex((x) => x === '--model' || x === '-m');
+const model = i === -1 ? 'none' : a[i + 1];
+if (${J(name)} === 'claude') process.stdout.write(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, result: 'answer from ' + model, modelUsage: { [model]: { inputTokens: 1 } } }));
+else process.stdout.write('answer from ' + model + '\\n');
+`;
+for (const name of ['claude', 'codex']) write(path.join(BIN, name), stub(name));
+write(path.join(BIN, 'model-id'), `#!/bin/sh\nexec '${process.execPath}' '${MODEL_ID}' "$@"\n`);
+for (const f of fs.readdirSync(BIN)) fs.chmodSync(path.join(BIN, f), 0o755);
+const PATHS = [BIN, '/usr/bin', '/bin'].join(':');
+const PROMPT = path.join(tmp, 'prompt.txt');
+fs.writeFileSync(PROMPT, 'Say hello.\n');
+const WORK = path.join(tmp, 'work');
+fs.mkdirSync(WORK);
+
+function ask(args, h) {
+  fs.writeFileSync(LOG, '');
+  const r = spawnSync(process.execPath, [ASK, '--prompt-file', PROMPT, '--cwd', WORK, ...args], {
+    cwd: WORK, encoding: 'utf8', env: { HOME: h, PATH: PATHS, GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: path.join(tmp, 'gitconfig') },
+  });
+  const calls = fs.readFileSync(LOG, 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l));
+  return { code: r.status, out: r.stdout, err: r.stderr, calls };
+}
+
+console.log('\npause: ask-model follows the pause, and ignores it for a named family');
+{
+  const h = home({ paused: [{ name: 'claude' }] });
+  const r = ask(['--role', 'reviewer'], h);
+  ok('--role reviewer while claude is paused: codex runs sol', r.code === 0 && r.calls.length === 1 && r.calls[0].name === 'codex' && r.calls[0].argv.includes(IDS.sol), J(r));
+  ok('…and stderr names the skip', r.err.includes('ask-model: claude paused: reviewer → sol (skipped fable)\n'), r.err);
+  const f = ask(['--family', 'fable'], h);
+  ok('--family fable while claude is paused: claude runs fable', f.code === 0 && f.calls.length === 1 && f.calls[0].name === 'claude' && f.calls[0].argv.includes(IDS.fable), J(f));
+  const e = ask(['--role', 'advisor'], h);
+  ok('--role advisor with every model paused: refuses, calls nothing', e.code !== 0 && e.calls.length === 0 && /every model for advisor is paused; resume claude/.test(e.err), J(e));
+  const s = ask(['--role', 'advisor', '--second'], home({ paused: [{ name: 'codex' }] }));
+  ok('--second when the second opinion is paused: refuses naming it, calls nothing', s.code !== 0 && s.calls.length === 0 && /second opinion \(astra\) is paused; resume codex/.test(s.err), J(s));
+}
+
+console.log('\npause: the review gate\'s reviewer pool follows the pause');
+function showConfig(h, env = {}) {
+  const r = spawnSync(process.execPath, [REVIEW, '--show-config'], { cwd: WORK, encoding: 'utf8', env: { HOME: h, PATH: PATHS, REVIEW_CONFIG: '', ...env } });
+  const at = r.stdout.indexOf('{');
+  let data = null;
+  try { data = JSON.parse(r.stdout.slice(at)); } catch {}
+  return { code: r.status, data, out: r.stdout, err: r.stderr };
+}
+{
+  const h = home({ paused: [{ name: 'claude' }] });
+  const c = showConfig(h);
+  ok('pool: only sol, and sol is selected', c.code === 0 && J(c.data?.pool?.map((m) => m.family)) === J(['sol']) && c.data?.selected?.family === 'sol', J(c).slice(0, 600));
+  const free = showConfig(home(undefined));
+  ok('nothing paused: the pool is fable and sol', J(free.data?.pool?.map((m) => m.family)) === J(['fable', 'sol']), J(free).slice(0, 600));
+  const named = showConfig(h, { REVIEW_REVIEWER: 'fable' });
+  ok('REVIEW_REVIEWER=fable while claude is paused: fable reviews', named.code === 0 && named.data?.selected?.family === 'fable', J(named).slice(0, 600));
+}
+
+console.log(`\n${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
diff --git a/tools/ask-model.mjs b/tools/ask-model.mjs
index 9d3bf06..db31a6b 100644
--- a/tools/ask-model.mjs
+++ b/tools/ask-model.mjs
@@ -82,7 +82,7 @@ import os from 'node:os';
 import path from 'node:path';
 import { fileURLToPath } from 'node:url';
 import { EFFORTS, loadRegistry, resolveModel } from '../lib/models.js';
-import { familyEffort, resolveFlavor, resolveRole } from '../lib/roles.js';
+import { familyEffort, pauseLine, resolveFlavor, resolveRole } from '../lib/roles.js';
 
 const SELF = fileURLToPath(import.meta.url);
 const USAGE = 'usage: ask-model (--role <role> [--second] | --family <family> [--effort-from <role>[,<role>…]]) [--effort <e>] --prompt-file <path> [--schema <file.json>] [--investigate | --no-tools | --min-tools | --x-search] [--json] [--cwd <dir>]'
@@ -730,8 +730,12 @@ function parse(argv) {
 function resolve(o) {
   if (o.role !== undefined) {
     const r = resolveRole(o.role);
+    if (r.pauseError) process.stderr.write(`ask-model: ${r.pauseError} — nothing is paused until it is fixed\n`);
     if (r.error) return { error: r.error };
+    const line = pauseLine(r);
+    if (line) process.stderr.write(`ask-model: ${line}\n`);
     if (o.second) {
+      if (r.altSkipped) return { error: `role "${o.role}"'s second opinion (${r.altSkipped.family}) is paused; resume ${r.altSkipped.by}, or name a family with --family` };
       if (!r.alt) return { error: `role "${o.role}" has no second opinion (alt); set one in ACS → Models → Roles` };
       return { family: r.alt, id: r.altId, effort: o.effort ?? r.altEffort ?? '' };
     }
