  if (v.length > LIMITS.avoid) fail(where, `has ${v.length} roles; the limit is ${LIMITS.avoid}`);
  v.forEach((s, i) => { if (typeof s !== 'string' || !ROLE_RE.test(s)) fail(`${where}[${i}]`, `role name ${JSON.stringify(s)} must match [a-z][a-z0-9-]{0,31}`); });
