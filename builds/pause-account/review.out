}

/** family, id and effort ('' = none), or why not. A flag effort wins over the role's and the flavor's. */
function resolve(o) {
  if (o.role !== undefined) {
    const r = resolveRole(o.role);
    if (r.pauseError) process.stderr.write(`ask-model: ${r.pauseError} — nothing is paused until it is fixed\n`);
    if (r.error) return { error: r.error };
    const line = pauseLine(r);
    if (line) process.stderr.write(`ask-model: ${line}\n`);
    if (o.second) {
      if (r.altSkipped) return { error: `role "${o.role}"'s second opinion (${r.altSkipped.family}) is paused; resume ${r.altSkipped.by}, or name a family with --family` };
      if (!r.alt) return { error: `role "${o.role}" has no second opinion (alt); set one in ACS → Models → Roles` };
      return { family: r.alt, id: r.altId, effort: o.effort ?? r.altEffort ?? '' };
    }
    return { family: r.family, id: r.id, effort: o.effort ?? r.effort ?? '' };
  }
  const { registry, error } = loadRegistry();
  if (error) return { error: `model registry is invalid — ${error}` };
  // A family, never a raw id: the registry is where ids live.
  if (!Object.hasOwn(registry.models, o.family)) {
    return { error: `"${o.family}" is not a model family (known: ${Object.keys(registry.models).join(', ')})` };
  }
  const m = resolveModel(o.family);
  if (m.error) return { error: m.error };
  if (o.effort !== undefined) return { family: o.family, id: m.id, effort: o.effort };
  if (o.effortFrom !== undefined) {
    const e = familyEffort(o.family, o.effortFrom);
    if (e.error) return { error: e.error };
    return { family: o.family, id: m.id, effort: e.effort };
  }
  const f = resolveFlavor(o.family);
  if (f.error) return { error: f.error };
  return { family: o.family, id: m.id, effort: f.flavor.effort || '' };
}

/** The executable `name` on PATH, absolute entries only, so a repo's ./claude is never picked. */
function which(name) {
  for (const dir of String(process.env.PATH || '').split(path.delimiter)) {
    if (!path.isAbsolute(dir)) continue;
    const p = path.join(dir, name);
    try {
      fs.accessSync(p, fs.constants.X_OK);
      if (fs.statSync(p).isFile()) return p;
    } catch {}
  }
  return null;
}

/**
 * Every file whose state the after-call check compares: the work tree's .git (a folder, or a linked worktree's
 * gitfile), the git dir's commondir, the config and config.worktree of the git dir and common dir, and each file those
 * configs include (include.path, and every includeIf.*.path whatever its condition, up to git's 10 levels). The
 * after-call git never reads any of them, so a change here cannot make the check run a command; it is reported
 * because the caller's next git would read it. `git` is the confined git (confinedGit), which reads only the file it is given.
 */
function guardFiles(repo, git) {
  const files = [path.join(repo.root, '.git'), path.join(repo.gitDir, 'commondir'),
    ...[repo.gitDir, repo.commonDir].flatMap((d) => [path.join(d, 'config'), path.join(d, 'config.worktree')])];
  const seen = new Set();
  const walk = (file, depth) => {
    if (seen.has(file)) return;
    seen.add(file);
    // git stops at 10 levels of includes.
    if (depth > 10 || !fs.existsSync(file)) return;
    const r = git('config', '--file', file, '--no-includes', '--null', '--type=path', '--get-regexp', '^include(if\\..*)?\\.path$');
    for (const entry of String(r.stdout || '').split('\0')) {
      const value = entry.slice(entry.indexOf('\n') + 1);
      if (entry.includes('\n') && value) walk(path.resolve(path.dirname(file), value), depth + 1);
    }
  };
  for (const f of files) walk(f, 0);
  return [...seen];
}

/** Each file's state: missing, a folder, its sha256, or a symlink's target with the sha256 of what it points at. */
function gitGuard(files) {
  const hash = (f) => crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
  return new Map(files.map((f) => {

function modelIdJson(args) {
  const r = spawnSync('model-id', args, { encoding: 'utf8' })
  if (r.error || r.status !== 0)
    return { error: r.error?.message || (r.stderr || '').trim() || `exit ${r.status}`, missing: r.error?.code === 'ENOENT' }
  try {
    return { data: JSON.parse(r.stdout) }
  } catch {
    return { error: `unparseable output: ${String(r.stdout).slice(0, 200)}` }
  }
}

// Which CLI runs a model: its id's prefix, the rule ACS uses (lib/models-catalog.js vendorOf),
// copied so this script stays standalone. An id with any other prefix has no known CLI.
function vendorOf(id) {
  const s = String(id ?? '')
  if (s.startsWith('claude-')) return 'claude'
  if (s.startsWith('gpt-')) return 'codex'
  if (s.startsWith('grok-')) return 'grok'
  return null
}
const VENDORS = ['codex', 'claude', 'grok']
// Found on PATH without running it, the way spawnSync will find it.
const onPath = (command) => (String(command).includes('/') ? isExecutable(command) : which(command) !== null)

// A hard stop names what is wrong and how to fix it; it never tries another vendor instead.
function stop(message) {
  console.error(`\n✖ ${message}\n`)
  process.exit(1)
}

// Each family reviews at its own flavor effort; the role-level effort is cleared on purpose.
// likes/quirks are what an optional local classifier weighs when pick names one.
function flavorOf(family) {
  const r = modelIdJson(['--flavor', family, '--json'])
  if (r.error) console.warn(`⚠ model-id --flavor ${family} failed (${r.error}) — using effort high`)
  const f = r.data?.flavor || {}
  return {
    effort: f.effort || 'high',
    likes: Array.isArray(f.likes) ? f.likes : [],
    quirks: Array.isArray(f.quirks) ? f.quirks : [],
  }
}
const flavorEffort = (family) => flavorOf(family).effort

// The unranked reviewer pool: the `reviewer` role (ACS → Models → Roles), each member's CLI taken
// from its id's prefix, filtered to the CLIs on PATH. One line names the families skipped.
// Returns { pool } or { error, missing } — callers stop loudly (poolOrStop), never fall back.
const skipsNoted = new Set()
function loadPool(role = 'reviewer') {
  const r = modelIdJson(['--role', role, '--json'])
  if (r.error) return { error: r.error, missing: r.missing }
  const use = Array.isArray(r.data?.use) ? r.data.use : []
  const ids = Array.isArray(r.data?.ids) ? r.data.ids : []
  // Effort per member: the model's effort in this job → the job's effort → the model's default.
  // `members` (present only when a member effort is set) carries that resolved per member;
  // otherwise a job-level effort applies to everyone, else each family's flavor effort.
  const members = Array.isArray(r.data?.members) ? r.data.members : null
  const roleSet = ['default', 'user'].includes(r.data?.provenance?.effort) && r.data?.effort
  const pool = []
  const skipped = []
  // Role families left out, kept so a pick that names one stops instead of reviewing on another.
  const unusable = []
  use.forEach((f, i) => {
    const family = String(f).toLowerCase()
    const id = ids[i] || modelId(family)
    const vendor = vendorOf(id)
    if (!vendor) {
      console.warn(`⚠ ${role} role family "${family}" has id "${id}", whose prefix names no known CLI (claude-, gpt-, grok-) — skipped`)
      unusable.push({ family, vendor, id })
      return
    }
    if (!onPath(vendor)) {
      skipped.push(`${family} (${vendor} CLI not on PATH)`)
      unusable.push({ family, vendor, id })
      return
    }
    const fl = flavorOf(family)
    const effort = members?.[i]?.effort || (roleSet ? r.data.effort : '') || fl.effort
    pool.push({ family, vendor, id, ...fl, effort })
  })
  if (skipped.length && !skipsNoted.has(role)) {
    skipsNoted.add(role)
    console.warn(`ℹ ${role} role: skipped ${skipped.join(', ')}`)
  }
  if (pool.length) return { pool, unusable }
  return {
    error: use.length
      ? `none of the ${role} role's families (${use.join(', ')}) has its CLI on PATH`
      : `the ${role} role lists no families`,
    empty: true,
    unusable,
  }
}
function poolOrStop({ pool, error, missing, empty }) {
  if (pool) return pool
  if (missing)
    stop(
      `model-id could not resolve the reviewer role: model-id is not installed (${error}).\n` +
        `  Fix — run: acs install-model-id, then check the reviewer role in ACS → Models → Roles.`,
    )
  if (empty)
    stop(
      `No reviewer can run: ${error}.\n` +
        `  Fix: install the CLI of a family in the reviewer role, or set the reviewer role to families\n` +
        `  whose CLI you have in ACS → Models → Roles.`,
    )
  stop(
    `model-id could not resolve the reviewer role (${error}).\n` +
      `  Fix: set the reviewer role in ACS → Models → Roles, then check \`model-id --role reviewer --json\`.`,
  )
      const by = [...new Set(skipped.map((s) => s.by))];
      return { error: `every model for ${name} is paused; resume ${by.join(' or ')} or add a fallback in ACS → Models → Roles`, paused: true, skipped };
    }
  }
  const use = members.map((m) => m.family);
  const ids = members.map((m) => m.id);
  const own = [...role.members, ...(role.alt ? [role.altMember] : [])].some((m) => m.effort);
  return {
    role: name,
    family: use[0],
    id: ids[0],
    effort: members[0].effort,
    alt: altMember?.family ?? '',
    altId: altMember?.id ?? '',
    altEffort: altMember?.effort ?? '',
    use,
    ids,
    note: role.note || '',
    custom: loaded.custom.includes(name),
    provenance: loaded.provenance.roles[name],
    source: loaded.source,
    ...(own ? { members, altMember } : {}),
    ...(pause.active.length ? { paused: pause.active.map((e) => e.name), skipped, altSkipped } : {}),
    ...(pause.error ? { pauseError: pause.error } : {}),
  };
}

/**
 * A family's effort for a job, the one rule ask-model --effort-from and model-id --effort share: the first of
 * `roleNames` that holds the family (in its members, or as its alt unless `alt` is false) and gives it an effort
 * there, its own else the role's; a role holding it with neither is passed over, as the skills' jq lookups did. In no
 * role, its flavor effort; else '' (no effort flag at all). `role` names the role it came from, '' when none.
 */
export function familyEffort(family, roleNames = [], { home = homeDir(), alt = true } = {}) {
  const loaded = loadRoles({ home });
  if (loaded.error) return { error: `roles are invalid — ${loaded.error}` };
  if (typeof family !== 'string' || !loaded.families.includes(family)) {
    return { error: `unknown model family "${family}" (known: ${loaded.families.join(', ')})` };
  }
  const unknown = roleNames.find((name) => !knownRoles(loaded).includes(name));
  if (unknown !== undefined) return { error: `unknown role "${unknown}" (known: ${knownRoles(loaded).join(', ')})` };
  for (const name of roleNames) {
    const role = loaded.roles[name];
    if (!role) continue; // unset: it holds no family
    const m = role.members.find((x) => x.family === family) || (alt && role.alt === family ? role.altMember : null);
    if (m?.effort) return { family, effort: m.effort, source: 'member', role: name };
    if (m && role.effort) return { family, effort: role.effort, source: 'role', role: name };
  }
  const fl = loaded.flavor[family]?.effort;
  return { family, effort: fl || '', source: fl ? 'flavor' : '', role: '' };
}

