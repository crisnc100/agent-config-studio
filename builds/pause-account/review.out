   490	  if (unknown !== undefined) return { error: `unknown role "${unknown}" (known: ${knownRoles(loaded).join(', ')})` };
   491	  for (const name of roleNames) {
   492	    const role = loaded.roles[name];
   493	    if (!role) continue; // unset: it holds no family
   494	    const m = role.members.find((x) => x.family === family) || (alt && role.alt === family ? role.altMember : null);
