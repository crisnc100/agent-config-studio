#!/bin/sh
# Launch Agent Config Studio and open it in the browser.
# If it is already running, just focus the tab.
#
# POSIX sh on purpose. This is the entry point people are told to run, so it has
# to work wherever node does — a zsh-only launcher fails on a stock Linux box
# (and in CI) with a bare "No such file or directory" that names zsh, not us.

set -e

# This checkout, found through any chain of symlinks (`acs install` puts one on
# PATH). `readlink -f` is GNU-only, so each link is followed by hand; a
# relative target is relative to the link's own directory.
self=$0
case $self in */*) ;; *) self=$(command -v -- "$self") ;; esac
hops=0
while [ -L "$self" ]; do
  hops=$((hops + 1))
  if [ "$hops" -gt 40 ]; then
    echo "acs: too many levels of symlinks resolving $0" >&2
    exit 1
  fi
  target=$(readlink -- "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
DIR=$(unset CDPATH; cd -P -- "$(dirname -- "$self")/.." && pwd -P)
PORT="${ACS_PORT:-8787}"
URL="http://localhost:$PORT"

# How this copy was installed, each decided positively:
#   checkout  $DIR is the top level of a git work tree that tracks bin/acs,
#             server.js and package.json, and package.json names the package
#             agent-config-studio: a clone of ACS, or a worktree of one whose
#             .git is a file. Only this updates itself with git.
#   npm       $DIR is a package inside a node_modules folder: npm i -g, npx's
#             cache, bunx's, or a project's dependencies.
#   copy      anything else, such as an unpacked tarball.
# Never an ancestor's .git: a package installed inside someone's repo would
# otherwise fetch and fast-forward that repo.
install_mode() {
  if command -v git >/dev/null 2>&1 &&
    top=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null) &&
    [ "$(unset CDPATH; cd -P -- "$top" 2>/dev/null && pwd -P)" = "$DIR" ] &&
    git -C "$DIR" -c core.fsmonitor=false ls-files --error-unmatch -- bin/acs server.js package.json >/dev/null 2>&1 &&
    grep -q '"name": *"agent-config-studio"' "$DIR/package.json" 2>/dev/null; then
    echo checkout
    return 0
  fi
  case ${DIR%/*} in
    */node_modules) echo npm ;;
    *) echo copy ;;
  esac
}
MODE=$(install_mode)
# How to spell `acs` in advice: npx and bunx put it on PATH only for their own run.
case $MODE:$DIR in
  npm:*/_npx/*) ACS_CMD='npx agent-config-studio' ;;
  npm:*/bunx-*) ACS_CMD='bunx agent-config-studio' ;;
  *) ACS_CMD=acs ;;
esac

# printf, not a here-document: a here-document needs a writable temp dir.
usage() {
  printf '%s\n' \
    'usage: acs [--no-open]          start the studio (or focus it) and open the browser' \
    "       acs stop                 stop the studio on port $PORT" \
    '       acs install              link acs into a directory on your PATH (not under npm)' \
    '       acs uninstall            remove that link' \
    '       acs update               fast-forward this checkout; never starts the studio' \
    '       acs roots ls|add|rm      the project folders the studio reads and edits' \
    '       acs usage [...]          seat usage in the terminal' \
    '       acs pause [<account>]    pause an account so roles skip its models; alone, lists pauses' \
    '       acs resume <account>     end a pause' \
    '       acs install-model-id     install the model-id resolver and ask-model' \
    '       acs install-worktree     install the worktree helpers (zsh/macOS only)' \
    '       acs packs list|explain|install|status|update|uninstall   recommended skill packs (acs packs help)' \
    '       acs help                 this text' \
    '' \
    'environment: ACS_PORT (default 8787), ACS_NO_OPEN=1 (never open a browser),' \
    '             ACS_NO_UPDATE=1 (start without pulling), ACS_NODE (the node to run;' \
    '             default: node on PATH, or the newest LTS installed when that is missing, older than 20 or odd)' \
    "checkout:    $DIR" \
    "installed:   $(mode_label)"
}

mode_label() {
  case $MODE in
    checkout) echo 'git checkout (acs updates it from origin)' ;;
    npm) echo 'npm package (update: npm install -g agent-config-studio, or npx agent-config-studio@latest)' ;;
    *) echo 'a copy without git (acs never updates it)' ;;
  esac
}

# Under npm the package manager owns install, PATH and updates.
npm_refuses() {
  case $1 in
    install) echo "acs install is not needed: npm put acs on your PATH when it installed the package. Under npx, run: npm install -g agent-config-studio" >&2 ;;
    uninstall) echo "acs uninstall does not apply to the npm package — remove it with: npm uninstall -g agent-config-studio" >&2 ;;
    update) echo "acs update fast-forwards a git checkout; this is the npm package — update it with: npm install -g agent-config-studio (or run npx agent-config-studio@latest)" >&2 ;;
  esac
  exit 1
}

# Node is the one runtime the studio needs. Check it before anything uses it,
# so an old or missing node says so instead of failing on a syntax error.
#
# Which node, chosen once and run for every command below: ACS_NODE when set;
# else node on PATH when its major is even and 20 or newer. Otherwise — no
# node on PATH, one older than 20, or an odd major: a short-lived release, and
# on Node 23 a studio up for a day stopped completing async file I/O for good
# (2026-10-24) — the newest LTS a version manager or Homebrew installed. None
# found: an odd PATH node runs with a warning; a missing or old one is refused
# as ever. The start prints which (NODE_NOTE, NODE_WARN); every other command
# stays as quiet as it was.
NODE=node
NODE_NOTE=
NODE_WARN=
need_node() {
  if [ -n "${ACS_NODE:-}" ]; then
    src="ACS_NODE ($ACS_NODE)"
    case $ACS_NODE in
      */*) [ -f "$ACS_NODE" ] && [ -x "$ACS_NODE" ] && NODE=$ACS_NODE ;;
      *) NODE=$(command -v -- "$ACS_NODE" 2>/dev/null) ;;
    esac || {
      echo "acs: ACS_NODE is set to \"$ACS_NODE\", which is not an executable file. Point it at Node.js 20 or newer, or unset it." >&2
      exit 1
    }
  else
    src=node
    if ! command -v node >/dev/null 2>&1; then
      if lts_node; then
        NODE=$lts NODE_NOTE="acs: using Node $lts_v (LTS); there is no node on your PATH"
        return 0
      fi
      echo "acs: Node.js 20 or newer is required, and node is not on PATH. Install it from https://nodejs.org" >&2
      exit 1
    fi
  fi
  v=$("$NODE" -p process.versions.node 2>/dev/null || true)
  major=${v%%.*}
  case $major in
    ''|*[!0-9]*) echo "acs: could not read the Node.js version ($src -p printed \"$v\"). Node 20 or newer is required." >&2; exit 1 ;;
  esac
  if [ -z "${ACS_NODE:-}" ] && { [ "$major" -lt 20 ] || [ $((major % 2)) -eq 1 ]; }; then
    if [ "$major" -lt 20 ]; then why="your default node $v is too old"; else why="your default node $v is a short-lived release"; fi
    if lts_node; then
      NODE_NOTE="acs: using Node $lts_v (LTS); $why"
      NODE=$lts v=$lts_v major=${lts_v%%.*}
    elif [ "$major" -ge 20 ]; then
      NODE_WARN="acs: your default node $v is a short-lived release and no LTS node (an even major, 20 or newer) was found — running on it anyway. Set ACS_NODE to an LTS node to choose one."
    fi
  fi
  if [ "$major" -lt 20 ]; then
    echo "acs: Node.js $v is too old — Node 20 or newer is required.${ACS_NODE:+ (That is ACS_NODE: $ACS_NODE.)} Install it from https://nodejs.org" >&2
    exit 1
  fi
}

# The newest LTS node (an even major, 20 or newer) that nvm, fnm, Volta or
# Homebrew installed, in lts and lts_v. Each candidate is asked its version:
# a folder's name is not trusted. Homebrew's keg-only node@N formulae live
# under its prefix: HOMEBREW_PREFIX (brew shellenv sets it), and the prefix of
import fs from 'node:fs';
import path from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { HOME, HISTORY_REPO, historyRelPath, realHome, resolveSafe, openUserFile, safeRoots, tilde } from './paths.js';
import { buildRegistry } from './registry.js';
import { userPath } from './models.js';
import { rolesUserPath } from './roles.js';

const exec = promisify(execFile);

/**
 * All repository mutations run one at a time. `git add -A` plus commit is not
 * safe to interleave: concurrent saves would absorb each other's changes or
 * collide on index.lock.
 */
let queue = Promise.resolve();
function serialize(fn) {
  const run = queue.then(fn, fn);
  queue = run.then(() => {}, () => {});
  return run;
}

/** A git call that hangs (a lock, a prompt) is killed, so it cannot hold every later save. */
const GIT_TIMEOUT_MS = 30_000;
const GIT_LIMITS = { timeout: GIT_TIMEOUT_MS, killSignal: 'SIGKILL' };
const timedOut = (e, args) => (e && e.killed
  ? new Error(`history: git ${args[0]} did not finish within ${GIT_TIMEOUT_MS / 1000}s and was stopped`)
  : e);

async function git(args, opts = {}) {
  try {
    const { stdout } = await exec('git', ['-C', HISTORY_REPO, ...args], {
      maxBuffer: 32 * 1024 * 1024, ...GIT_LIMITS, ...opts,
    });
    return stdout;
  } catch (e) { throw timedOut(e, args); }
}

/**
 * A shadow repo rather than `git init` inside ~/.claude: those directories hold
 * gigabytes of session churn, and project memory files already live in their own
 * repos. Mirroring keeps full history without touching either.
 */
export async function ensureRepo() {
  if (!fs.existsSync(path.join(HISTORY_REPO, '.git'))) {
    fs.mkdirSync(HISTORY_REPO, { recursive: true });
    await exec('git', ['-C', HISTORY_REPO, 'init', '-q', '-b', 'main'], GIT_LIMITS).catch((e) => { throw timedOut(e, ['init']); });
    await exec('git', ['-C', HISTORY_REPO, 'config', 'user.name', 'agent-config-studio'], GIT_LIMITS).catch((e) => { throw timedOut(e, ['config']); });
    await exec('git', ['-C', HISTORY_REPO, 'config', 'user.email', 'studio@localhost'], GIT_LIMITS).catch((e) => { throw timedOut(e, ['config']); });
    fs.writeFileSync(
      path.join(HISTORY_REPO, 'README.md'),
      '# agent-config-studio history\n\nMirrored copies of Claude Code + Codex config files.\n' +
      'Every save made in the studio lands here as a commit. Safe to delete;\n' +
      'you lose history, not live config.\n'
    );
    await snapshotAll('baseline: initial snapshot of all config surfaces');
  }
}

/**
 * The file's real path, re-proved at the moment it is read: inside the safe
 * roots as they are now, and not denied (resolveSafe does both). A registry
 * entry or an editor path is only evidence about the past — the file may have
 * become a link to a credential since — so nothing is copied or compared on
 * its strength. The model registry's user files are the one addition: the
 * Models panel edits models.json and roles.json, in the studio's own folder.
 */
let snapshotHook = null;
/** A test seam: runs between the registry build and the copies in snapshotAll. Nothing in the app sets it. */
export function _setSnapshotHook(fn) { snapshotHook = fn; }
function allowedRoots() {
  return [...safeRoots(), ...[userPath(), rolesUserPath()].map((f) => path.join(realHome(), path.relative(HOME, f)))];
}
function readable(abs, roots = allowedRoots()) {
  return resolveSafe(abs, roots);
}

/**
 * A mirror is a copy of the content: it is read the way every read is
 * (openUserFile), or is exactly the bytes a caller just wrote (`content`).
 */
function mirror(abs, roots, content = null) {
  const real = readable(abs, roots);
  const buf = content ?? openUserFile(real).buf;
  const rel = historyRelPath(abs);
  const dest = path.join(HISTORY_REPO, rel);
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.writeFileSync(dest, buf);
  return rel;
}

async function commit(message) {
  await git(['add', '-A']);
  const status = await git(['status', '--porcelain']);
  if (!status.trim()) return null;
  await git(['commit', '-q', '-m', message]);
  return (await git(['rev-parse', 'HEAD'])).trim();
}

import os from 'node:os';
import path from 'node:path';
import fs from 'node:fs';
import { derive, unsafeLocation } from './roots.js';

export const HOME = os.homedir();
export const CLAUDE_HOME = path.join(HOME, '.claude');
export const CODEX_HOME = path.join(HOME, '.codex');
export const AGENTS_HOME = path.join(HOME, '.agents');
export const GROK_HOME = path.join(HOME, '.grok');
export const WORKTREE_HOME = path.join(HOME, '.config', 'worktree');
export const STUDIO_HOME = path.join(HOME, '.agent-config-studio');
export const HISTORY_REPO = path.join(STUDIO_HOME, 'history');

/**
 * The project folders, as roots.json says right now (lib/roots.js). Read per
 * call, never bound at load, so `acs roots add` applies without a restart.
 * Edit roots are realpath'd and active; read roots appear only in `readRoots`.
 */
export const currentRoots = () => derive({ home: HOME });

/**
 * Only paths under these roots are ever readable or writable: the agents'
 * homes plus the edit roots. ~/.agents is included because ~/.claude/skills
 * symlinks into it. A read root is never here — the editor, the writer and
 * the history mirror have no business touching it.
 */
export const safeRoots = () => currentRoots().safeRoots;

/**
 * Where skill discovery is allowed to look, and NOTHING else: the skills
 * trees plus every root, read ones included. lib/skills.js passes this list to
 * resolveSafe() as its own roots, so the widening to read roots stops at that
 * one caller — and a test asserts GET /api/file still 403s on a read-root path.
 */
export function skillRoots() {
  const d = currentRoots();
  const skipped = new Set(d.builtinInvalid.map((b) => b.name));
  const real = (p) => { try { return fs.realpathSync.native(p); } catch { return p; } };
  // A skills tree counts only if its home is safe and it, too, really sits
  // somewhere safe — never ~/.ssh, HOME or above, or the studio's folder.
  const global = [['~/.claude', CLAUDE_HOME], ['~/.codex', CODEX_HOME], ['~/.agents', AGENTS_HOME]]
    .filter(([name]) => !skipped.has(name))
    .map(([, dir]) => real(path.join(dir, 'skills')))
    .filter((p) => !unsafeLocation(p, { home: HOME }));
  return [...global, ...d.allRoots];
}

/** HOME as it really is; paths come back from realpath in this spelling. */
let realHomeCache = null;
export function realHome() {
  if (realHomeCache === null) { try { realHomeCache = fs.realpathSync.native(HOME); } catch { realHomeCache = HOME; } }
  return realHomeCache;
}

/**
 * Never read, never write, never list. Secrets and machine state that would be
 * actively harmful to surface in a browser tab.
 */
const DENY_EXACT = new Set([
  path.join(CLAUDE_HOME, '.credentials.json'),
  path.join(CODEX_HOME, 'auth.json'),
  path.join(GROK_HOME, 'auth.json'),
].map((p) => p.toLowerCase()));

const DENY_SEGMENTS = [
  '.git',
  'node_modules',
  '.credentials.json',
  'auth.json',
];

/** By name, case-insensitively: on macOS AUTH.JSON opens auth.json. */
export function isDenied(abs) {
  const low = String(abs).toLowerCase();
  if (DENY_EXACT.has(low)) return true;
  const segs = low.split(path.sep);
  return DENY_SEGMENTS.some((d) => segs.includes(d));
}

/**
 * Every credential file's identity, (dev, ino), by stat only — never opened:
 * auth.json in ~/.codex, $CODEX_HOME and every seat home, ~/.claude's
 * .credentials.json, Grok's auth.json. Read fresh per call: a login made a
 * minute ago is a new inode.
 */
function credentialIds() {
  const files = [
    path.join(CODEX_HOME, 'auth.json'), path.join(CLAUDE_HOME, '.credentials.json'), path.join(GROK_HOME, 'auth.json'),
    process.env.CODEX_HOME && path.join(process.env.CODEX_HOME, 'auth.json'),
    process.env.GROK_HOME && path.join(process.env.GROK_HOME, 'auth.json'),
  ];
  // The seat registry is the studio's own file; it names the other homes.
  try {
    for (const s of JSON.parse(fs.readFileSync(path.join(STUDIO_HOME, 'seats.json'), 'utf8')).seats || []) {
      if (typeof s?.home === 'string') files.push(path.join(s.home, 'auth.json'), path.join(s.home, '.credentials.json'));
    }
  } catch {}
  try { for (const d of fs.readdirSync(path.join(HOME, '.codex-seats'))) files.push(path.join(HOME, '.codex-seats', d, 'auth.json')); } catch {}
  const ids = new Set();
  for (const f of files) {
    if (!f) continue;
    try { const st = fs.statSync(f); ids.add(`${st.dev}:${st.ino}`); } catch {}
  }
  return ids;
}

/**
 * THE read of a user file's content — every route that hands content out
 * comes through here (tests/setup-guards.mjs). The file is opened first and
 * judged by its descriptor, so nothing can change between the check and the
 * read: it must be a regular file, have one name (another hard link may be a
 * credential's), and not BE a credential — by (dev, ino), which settles
 * every question of names, aliases, case and `..` at once. Then the bytes
 * come from that same descriptor. Returns { buf, stat }.
 */
export function openUserFile(p, { maxBytes = Infinity } = {}) {
  let fd;
  // O_NONBLOCK: a FIFO or a device must never hold the server in open() —
  // it opens at once and the fstat below refuses it. Reads of a regular file
import fs from 'node:fs';
import path from 'node:path';
import { homeDir, tracks, vendorOf } from './models.js';
import { readUserText } from './paths.js';

/**
 * What each CLI says it offers, read from the catalog it already caches on
 * disk — no spawn, no network, no credential — and what that means for the
 * registry: a newer id in a family, a pinned id being retired, or one no
 * longer offered.
 *
 * The catalogs sit beside login state. Only the projected fields below ever
 * leave this module: no file path, filename, identity, auth_method, origin,
 * etag, model_messages or any other field does.
 */

export const STALE_MS = 7 * 24 * 3600 * 1000;

const VENDORS = ['claude', 'codex', 'grok'];
const CLI = { claude: 'claude', codex: 'codex', grok: 'grok' };
const LABEL = { claude: 'Claude', codex: 'Codex', grok: 'Grok' };

export { vendorOf };

/**
 * The id's numeric segments, compared numerically so 10 beats 9. A segment
 * that mixes letters and digits makes the id unparseable, and an unparseable
 * id is never proposed.
 */
export function parseVersion(id) {
  if (typeof id !== 'string') return null;
  const nums = [];
  for (const seg of id.split(/[-.]/)) {
    if (/^\d+$/.test(seg)) nums.push(Number(seg));
    else if (/\d/.test(seg)) return null;
  }
  return nums.length ? nums : null;
}

/** An 8-digit date segment marks a dated snapshot of a model, not a newer release. */
export const isDated = (id) => /(?:^|[-.])\d{8}(?:$|[-.])/.test(id);

export function compareVersions(a, b) {
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    const x = a[i] ?? -1, y = b[i] ?? -1;
    if (x !== y) return x < y ? -1 : 1;
  }
  return 0;
}

export const semver = (s) => {
  const m = /(\d+)\.(\d+)\.(\d+)/.exec(String(s ?? ''));
  return m ? m.slice(1).map(Number) : null;
};

const time = (v) => {
  if (typeof v === 'number' && Number.isFinite(v)) return v;
  const t = Date.parse(v);
  return Number.isFinite(t) ? t : null;
};

const str = (v, max = 200) => (typeof v === 'string' ? v.slice(0, max) : null);

/**
 * File access, swappable so tests can fail a read the way a disk does
 * (EACCES, EIO) — the only way to show those are not "missing".
 */
let io = fs;
export function _setCatalogIo(next) { io = next || fs; }

/** Only ENOENT means "not there"; any other failure is a read that failed. */
const readFailure = (e) => (e?.code === 'ENOENT' ? { missing: true } : { error: e?.code || 'read failed' });

function readJson(file) {
  let text;
  // The real read goes through lib/paths.js openUserFile, like every content read.
  try { text = io === fs ? readUserText(file) : io.readFileSync(file, 'utf8'); } catch (e) { return readFailure(e); }
  // The parser's message can quote the file's contents, so it is not passed on.
  try { return { doc: JSON.parse(text) }; } catch { return { error: 'catalog is not valid JSON' }; }
}

/* ── per-vendor readers: file → projected models ───────────────────────── */

function claudeFamily(m) {
  return typeof m.short_name === 'string' && /^[A-Za-z]+$/.test(m.short_name) ? m.short_name.toLowerCase() : null;
}

function codexFamily(slug, hidden) {
  if (hidden || slug.endsWith('-latest') || slug.startsWith('codex-')) return null;
  const last = slug.split('-').pop();
  return /^[a-z]+$/.test(last) ? last : null;
}

function grokFamily(id, hidden) {
  if (hidden) return null;
  return /^grok-\d+(?:\.\d+)*$/.test(id) ? 'grok' : null;
}

function project(vendor, fields, fetchedAt) {
  return {
    vendor,
    id: fields.id,
    displayName: str(fields.displayName),
    family: fields.family ?? null,
    hidden: fields.hidden === true,
    minCliVersion: str(fields.minCliVersion, 32),
    upgrade: fields.upgrade ?? null,
    retirementAt: str(fields.retirementAt, 40),
    fetchedAt,
  };
}

function readClaude(home) {
  const dir = path.join(home, '.claude', 'cache', 'model-catalog');
  let names;
  try { names = io.readdirSync(dir).filter((n) => n.endsWith('-cc.json')); }
  catch (e) {
    const r = readFailure(e);
    if (r.error) return r;
    names = [];
  }
  // One file per login; the newest fetch wins.
  let best = null, lastError = null;
  for (const n of names) {
    const r = readJson(path.join(dir, n));
    if (r.error) { lastError = r.error; continue; }
    if (!r.doc) continue;
    const at = time(r.doc.fetchedAt);
    const list = r.doc.catalog?.config?.models;
    if (!Array.isArray(list)) { lastError = 'catalog has no model list'; continue; }
    if (!best || (at ?? 0) > (best.at ?? 0)) best = { at, list };
  }
  if (!best) return lastError ? { error: lastError } : { missing: true };
  const models = best.list
    .filter((m) => m && typeof m.id === 'string')
    .map((m) => project('claude', {
      id: m.id, displayName: m.name, family: claudeFamily(m), minCliVersion: m.min_claude_code_version,
    }, best.at));
  return { fetchedAt: best.at, models };
}

