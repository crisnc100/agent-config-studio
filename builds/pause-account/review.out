        if (use.length > LIMITS.use) fail(`${at}.use`, `has ${use.length} families; the limit is ${LIMITS.use}`);
        use.forEach((f, i) => member(`${at}.use${Array.isArray(r.use) ? `[${i}]` : ''}`, f, families));
        if (new Set(use.map((m) => memberOf(m).family)).size !== use.length) fail(`${at}.use`, 'names a family twice');
