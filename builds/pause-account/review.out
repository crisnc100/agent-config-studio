/**
 * Default route answers. `over` replaces any of them by "METHOD /path"; a
 * function there gets (body, url) and may throw { status } for an HTTP error.
 */
export function routesFor(over = {}) {
  const files = new Map(Object.values(PATHS).map((p) => [p, `# ${p.split('/').pop()}\n\nbody\n`]));
  const reg = { current: registry() };
  const table = {
    'GET /api/registry': () => reg.current,
    'GET /api/file': (_b, u) => {
      const p = u.searchParams.get('path');
      if (!files.has(p)) throw { status: 404, body: { error: 'not found' } };
      const content = files.get(p);
      return { path: p, display: `~${p.slice(H.length)}`, kind: p.endsWith('.md') ? 'markdown' : 'text', content, mtime: 1, size: content.length, lines: 3 };
    },
    'PUT /api/file': (b) => { files.set(b.path, b.content); return { saved: true, mtime: 2, sha: 'abcdef1234' }; },
    'GET /api/memory': () => MEMORY,
    'GET /api/memory/ops': () => ({ ops: [] }),
    'GET /api/context': () => CONTEXT,
    'GET /api/mcp': () => ({ note: '', global: [], codex: [] }),
    'GET /api/skills': () => ({ skills: [], usage: { caveat: { text: '' } } }),
    'GET /api/models': () => ({ rows: [], catalogs: [], pending: 2, checkedAt: Date.now() }),
    'GET /api/worktree': (_b, u) => (u.searchParams.get('status') === '0'
      ? { registered: [], candidates: [{ path: `${H}/Documents/Projects/new`, display: '~/Documents/Projects/new' }] }
      : { registered: [], candidates: [], projects: [] }),
    'GET /api/worktree/bases': () => ({ bases: ['origin/main'], suggested: 'origin/main' }),
    'GET /api/usage': () => ({ seats: [] }),
    'GET /api/harnesses': () => ({ harnesses: reg.current.harnesses, defaultHarness: 'claude', registryError: null }),
    'GET /api/trash': () => ({ items: [] }),
    'GET /api/scope/dirs': () => ({ dirs: [{ path: `${H}/Documents/Projects`, display: '~/Documents/Projects' }] }),
    'GET /api/scope': () => ({ chain: [] }),
    'GET /api/search': (_b, u) => ({ hits: [{
      entryId: 'hook:pre', path: PATHS.hook, entryLabel: 'pre tool', file: 'pre tool.sh', harness: 'claude', group: 'Hooks',
      display: '~/.claude/hooks/pre tool.sh', matches: [{ line: 1, text: u.searchParams.get('q') }], total: 1 }] }),
    'POST /api/create': (b) => ({ path: PATHS.skill, display: `new ${b.kind}` }),
    'POST /api/create-file': () => ({ path: PATHS.skillRef, display: 'ref.md' }),
    'POST /api/delete': () => ({ display: 'alpha', files: 2 }),
    ...over,
  };
  const fn = async (method, p, body, url) => {
    const h = table[`${method} ${p}`];
    if (!h) throw { status: 404, body: { error: `no stub for ${method} ${p}` } };
    return typeof h === 'function' ? h(body, url) : h;
  };
  fn.files = files;
  fn.reg = reg;
  fn.table = table;
  return fn;
}

/** Boot the page: parse index.html, run its scripts, wait for boot to finish. */
process.setMaxListeners(0);

export async function bootPage({ routes = routesFor(), hash = '', storage, width, carry, carrySession, raf } = {}) {
  const page = makePage({ html: HTML, routes, hash, storage, width, raf });
  if (carry) for (const [k, v] of carry) page.store.set(k, v);
  if (carrySession) for (const [k, v] of carrySession) page.sessionStore.set(k, v);
  const unhandled = (e) => page.errors.push(`unhandled: ${e?.stack || e}`);
  process.on('unhandledRejection', unhandled);
  page.done = () => process.off('unhandledRejection', unhandled);
  for (const s of SCRIPTS) page.run(path.join(PUB, s));
  await settle(5);
  return page;
}

export { settle };
/**
 * Every suite's temp folders and children, gone however the run ends: a
 * pass, a failure, a thrown error, process.exit(), SIGINT or SIGTERM.
 *
 * tempDir(prefix) is fs.mkdtempSync under os.tmpdir() (the same path it
 * returns), remembered for the sweep. track(child) stops a child still
 * running at exit, SIGTERM then SIGKILL (its whole process group with
 * { group: true }, for a detached one). onExit(fn) runs a suite's own
 * synchronous teardown first.
 *
 * A suite's own SIGINT/SIGTERM handler keeps the last word on the exit
 * code: this module exits on a signal only when no other handler is
 * listening, and sweeps either way. tests/fixtures/packs-sandbox.mjs keeps
 * its own sweep, which also asserts that nothing it made is left.
 */
import { spawnSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const dirs = new Set();
const children = new Set();
const hooks = [];

export function tempDir(prefix) {
  const d = fs.mkdtempSync(path.join(os.tmpdir(), prefix));
  dirs.add(d);
  return d;
}

/** A path made some other way (a fixed name, a fixture's mkdtemp): removed at exit too. */
export function removeOnExit(p) {
  dirs.add(p);
  return p;
}

export function track(child, { group = false } = {}) {
  const entry = { child, group };
  children.add(entry);
  if (child.pid) ownPids.add(child.pid);
  child.once('exit', () => children.delete(entry));
  return child;
}

export function onExit(fn) { hooks.push(fn); }

function remove(d) {
  try { fs.rmSync(d, { recursive: true, force: true }); return; } catch {}
  // A suite that chmods a folder unreadable (an EACCES case) may die before restoring it.
  spawnSync('/bin/chmod', ['-R', 'u+rwX', d]);
  try { fs.rmSync(d, { recursive: true, force: true }); } catch {}
}

// lib/harness.js keeps prompt files in one shared folder under the temp dir, each named
// <pid>-<ts>-<rand>.txt by the process that wrote it; a server a suite starts with TMPDIR set
// to os.tmpdir() writes there too. Only this run's files go: this process's and those of the
// children it tracked. Another run's stay, live or dead. The folder goes only when it was not
// there at import and is empty after that (rmdir never removes a file).
const PROMPTS = path.join(os.tmpdir(), 'acs-harness-prompts');
const promptsBefore = fs.existsSync(PROMPTS);
const ownPids = new Set([process.pid]);
function removePrompts() {
  let names;
  try { names = fs.readdirSync(PROMPTS); } catch { return; }
  for (const n of names) {
    if (ownPids.has(Number.parseInt(n, 10))) { try { fs.unlinkSync(path.join(PROMPTS, n)); } catch {} }
  }
  if (!promptsBefore) { try { fs.rmdirSync(PROMPTS); } catch {} }
}

let swept = false;
function sweep() {
  if (swept) return;
  swept = true;
  for (const fn of hooks) { try { fn(); } catch {} }
  // SIGTERM first, so a launcher shell's trap can stop the server it started; then SIGKILL.
  const live = [...children].filter(({ child }) => child.exitCode === null && child.signalCode === null);
  const send = (sig) => {
    for (const { child, group } of live) { try { if (group) process.kill(-child.pid, sig); else child.kill(sig); } catch {} }
  };
  if (live.length) { send('SIGTERM'); spawnSync('/bin/sleep', ['0.3']); send('SIGKILL'); }
  children.clear();
  for (const d of dirs) remove(d);
  removePrompts();
}

process.on('exit', sweep);
for (const [sig, code] of [['SIGINT', 130], ['SIGTERM', 143]]) {
  process.on(sig, function onSignal() {
    sweep();
    if (process.listeners(sig).every((l) => l === onSignal)) process.exit(code);
  });
}

const fmtTokens = (n) => (n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : String(n));
const agoText = (ms) => (ms == null ? '' : ms < 60000 ? 'just now' : `${untilText(Date.now() + ms)} ago`);

async function openUsage() {
  if (!confirmDiscard()) return;
  S.view = 'usage';
  leaveEditor();
  window.history.replaceState(null, '', '#usage');
  renderSidebar(); renderTopbar(); renderTabs(); renderStatus();
  $('filebar').hidden = true;

  const c = $('content');
  c.innerHTML = '<div class="scope"><div class="scope-sub"><span class="spinner"></span> reading usage…</div></div>';
  await paintUsage();

  // Meant to be left open, so it keeps itself current. Cleared whenever the
  // view changes so a closed panel is not polling forever.
  clearInterval(usageTimer);
  usageTimer = setInterval(() => {
    if (S.view !== 'usage') { clearInterval(usageTimer); usageTimer = null; return; }
    paintUsage();
  }, 60_000);
}

/**
 * POST /api/usage/refresh, shared: Home and Usage call this, and a click while
 * one is in flight joins it rather than sending another (the server coalesces
 * too, across tabs). It never hangs: past its timeoutMs it settles as a
 * timeout. Resolves `{ ok, data?, error? }` — ok only when the server says the
 * reading is fresh — and bumps USAGE_REFRESH.gen when it lands, so a GET that
 * started before it is known to be older.
 */
const USAGE_REFRESH = { inflight: null, gen: 0, timeoutMs: 45_000 };
function refreshUsage() {
  if (USAGE_REFRESH.inflight) return USAGE_REFRESH.inflight;
  let timer;
  const timeout = new Promise((resolve) => {
    timer = setTimeout(() => resolve({ ok: false, error: `the refresh did not answer within ${USAGE_REFRESH.timeoutMs / 1000}s` }), USAGE_REFRESH.timeoutMs);
  });
  const req = api('POST', '/api/usage/refresh').then(
    (data) => ({ ok: data.fresh !== false && !data.error, data, error: data.error || (data.fresh === false ? 'the reading was not refreshed' : null) }),
    (e) => ({ ok: false, error: e.message }),
  );
  const run = Promise.race([req, timeout]).then((r) => {
    clearTimeout(timer);
    USAGE_REFRESH.gen++;
    // Home's cached reading follows every refresh, whichever view asked for it.
    HOME.inflight.usage = null;
    if (r.data) {
      // The stored reading is still a reading; whether it is fresh is the caller's to say.
      const { fresh, error, at, ...reading } = r.data;
      HOME.src.usage = homeSource(reading);
    }
    return r;
  });
  USAGE_REFRESH.inflight = run;
  run.finally(() => { if (USAGE_REFRESH.inflight === run) USAGE_REFRESH.inflight = null; });
  return run;
}

/** One pause write from the Usage page, then a repaint; a refusal (a stale model-id, say) is shown as given. */
// The unranked reviewer pool: the `reviewer` role (ACS → Models → Roles), each member's CLI taken
// from its id's prefix, filtered to the CLIs on PATH. One line names the families skipped.
// Returns { pool } or { error, missing } — callers stop loudly (poolOrStop), never fall back.
const skipsNoted = new Set()
function loadPool(role = 'reviewer') {
  const r = modelIdJson(['--role', role, '--json'])
  if (r.error) return { error: r.error, missing: r.missing }
  const use = Array.isArray(r.data?.use) ? r.data.use : []
  const ids = Array.isArray(r.data?.ids) ? r.data.ids : []
  // Effort per member: the model's effort in this job → the job's effort → the model's default.
  // `members` (present only when a member effort is set) carries that resolved per member;
  // otherwise a job-level effort applies to everyone, else each family's flavor effort.
  const members = Array.isArray(r.data?.members) ? r.data.members : null
  const roleSet = ['default', 'user'].includes(r.data?.provenance?.effort) && r.data?.effort
  const pool = []
  const skipped = []
  // Role families left out, kept so a pick that names one stops instead of reviewing on another.
  const unusable = []
  use.forEach((f, i) => {
    const family = String(f).toLowerCase()
    const id = ids[i] || modelId(family)
    const vendor = vendorOf(id)
    if (!vendor) {
      console.warn(`⚠ ${role} role family "${family}" has id "${id}", whose prefix names no known CLI (claude-, gpt-, grok-) — skipped`)
      unusable.push({ family, vendor, id })
      return
    }
    if (!onPath(vendor)) {
      skipped.push(`${family} (${vendor} CLI not on PATH)`)
      unusable.push({ family, vendor, id })
      return
    }
    const fl = flavorOf(family)
    const effort = members?.[i]?.effort || (roleSet ? r.data.effort : '') || fl.effort
    pool.push({ family, vendor, id, ...fl, effort })
  })
  if (skipped.length && !skipsNoted.has(role)) {
    skipsNoted.add(role)
    console.warn(`ℹ ${role} role: skipped ${skipped.join(', ')}`)
  }
  if (pool.length) return { pool, unusable }
  return {
    error: use.length
      ? `none of the ${role} role's families (${use.join(', ')}) has its CLI on PATH`
      : `the ${role} role lists no families`,
    empty: true,
    unusable,

