 assert.equal(git(linked,'log','-1','--format=%s'),'commit with read-only common root');
 assert.ok(!fs.existsSync(path.join(common,'packed-refs.lock')));
-console.log('agent grants only validated linked-worktree commit directories; forged links are rejected; packed-ref commit needs no common-root writes');
+const linkedArgs=argv(linked);
+for (const setting of ['sandbox_workspace_write.writable_roots=[]','sandbox_workspace_write.exclude_tmpdir_env_var=true','sandbox_workspace_write.exclude_slash_tmp=true']) {
+  assert.ok(linkedArgs.some((arg,i)=>arg==='-c' && linkedArgs[i+1]===setting),`linked workers pin ${setting}`);
+}
+for (const forbidden of [own,'commondir','gitdir','config.worktree','config','hooks','objects'].map(n=>n===own?n:path.join(own,n))) {
+  assert.ok(!grants(linkedArgs).some(p=>forbidden===p || forbidden.startsWith(p+path.sep)),`${forbidden} has no writable ancestor`);
+}
+assert.ok(!fs.existsSync(path.join(own,'index.lock')),'granting a missing lock does not create it');
+assert.ok(!fs.existsSync(path.join(own,'HEAD.lock')),'granting a missing HEAD lock does not create it');
+for (const name of ['index','index.lock','HEAD','HEAD.lock','COMMIT_EDITMSG','logs']) {
+  const target=path.join(own,name), saved=target+'.saved', existed=fs.existsSync(target);
+  if (existed) fs.renameSync(target,saved);
+  fs.symlinkSync(fakeLogs,target);
+  try {
+    const actual=grants(argv(linked));
+    assert.ok(!actual.includes(target),`symlinked ${name} receives no grant`);
+    assert.ok(!actual.includes(fakeLogs),`symlinked ${name} target receives no grant`);
+    assert.ok(!actual.includes(own),'no fallback to the admin directory');
+  } finally { fs.unlinkSync(target); if(existed) fs.renameSync(saved,target); }
+}
+git(linked,'checkout','--detach');
+fs.writeFileSync(path.join(linked,'file.txt'),'detached commit\n');
+const detachedBefore=files(own);
+git(linked,'add','file.txt'); git(linked,'commit','-m','detached builder commit');
+const detachedAfter=files(own);
+const detachedChanged=[...new Set([...Object.keys(detachedBefore),...Object.keys(detachedAfter)])].filter(p=>detachedBefore[p]!==detachedAfter[p]);
+assert.ok(detachedChanged.includes('HEAD'),'detached commits need writable HEAD');
+assert.ok(detachedChanged.every(p=>commitFiles.includes(p)||p==='logs/HEAD'),JSON.stringify(detachedChanged));
+for (const name of ['commondir','gitdir','ORIG_HEAD']) assert.equal(detachedAfter[name],detachedBefore[name],`${name} is unchanged by a commit`);
+console.log('agent grants specific commit paths without config redirects; symlinks and forged links are rejected; branch and detached commits fit the allowlist');
diff --git a/tests/agent-git-fix2.mjs b/tests/agent-git-fix2.mjs
new file mode 100644
index 0000000..d40ed37
--- /dev/null
+++ b/tests/agent-git-fix2.mjs
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-git-fix2-'));
+const bin = path.join(home, 'bin'), capture = path.join(home, 'capture.json'); fs.mkdirSync(bin);
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nimport(${JSON.stringify(path.join(root, 'tests/fixtures/agent-cmux.mjs'))});\n`, { mode: 0o755 });
+fs.writeFileSync(path.join(bin, 'caffeinate'), '#!/bin/sh\nexit 0\n', { mode: 0o755 });
+fs.writeFileSync(path.join(bin, 'codex'), `#!${process.execPath}
+const fs=require('node:fs'), path=require('node:path'), os=require('node:os'), {spawnSync}=require('node:child_process');
+const result={args:process.argv.slice(2),tmpdir:os.tmpdir(),TMPDIR:process.env.TMPDIR,TMP:process.env.TMP,TEMP:process.env.TEMP};
+const git=(...args)=>{const r=spawnSync('git',args,{encoding:'utf8',timeout:30000});if(r.status!==0)throw new Error(r.stderr);return r.stdout.trim();};
+if(process.env.FIX_CASE==='f1') {
+  const folder=fs.mkdtempSync(path.join(os.tmpdir(),'worker-test-'));fs.writeFileSync(path.join(folder,'file'),'ok');fs.rmSync(folder,{recursive:true});
+}
+if(process.env.FIX_CASE==='f2') {
+  const admin=git('rev-parse','--absolute-git-dir');
+  result.before=fs.readdirSync(admin).filter(n=>n.startsWith('sharedindex.'));
+  result.splitIndex=git('config','--get','core.splitIndex');result.inherited=git('config','--get','probe.inherited');
+  git('add','file.txt');git('commit','-m','worker ordinary index');
+  result.after=fs.readdirSync(admin).filter(n=>n.startsWith('sharedindex.'));
+  result.sharedIndex=git('rev-parse','--shared-index-path');
+}
+fs.writeFileSync(${JSON.stringify(capture)},JSON.stringify(result));
+`, { mode: 0o755 });
+const env = { ...process.env, HOME: home, TMPDIR: home, PATH: `${bin}:${process.env.PATH}`, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: 'workspace:1', GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' };
+for (const key of ['CODEX_HOME','GROK_HOME','CLAUDE_CONFIG_DIR','GIT_DIR','GIT_WORK_TREE','GIT_COMMON_DIR','GIT_INDEX_FILE','GIT_CONFIG_COUNT','GIT_CONFIG_PARAMETERS']) delete env[key];
+const run = (cmd, args, extra = {}) => {
+  const r = spawnSync(cmd, args, { env: { ...env, ...extra }, encoding: 'utf8', timeout: 30000 });
+  assert.equal(r.status, 0, r.error?.message || r.stderr); return r.stdout.trim();
+};
+const git = (cwd, ...args) => run('git', ['-C', cwd, ...args]);
+const repo = path.join(home, 'repo'); fs.mkdirSync(repo);
+git(repo, 'init'); git(repo, 'config', 'user.name', 'Test'); git(repo, 'config', 'user.email', 'test@example.invalid');
+fs.writeFileSync(path.join(repo, 'file.txt'), 'base\n'); git(repo, 'add', '.'); git(repo, 'commit', '-m', 'base');
+const linked = path.join(home, 'linked'); git(repo, 'worktree', 'add', '--detach', linked);
+const open = (cwd, extra = {}) => {
+  const w = JSON.parse(run(process.execPath, [path.join(root, 'bin/agent.mjs'), 'open', 'sol', '--cwd', cwd, 'test', '--json'], extra));
+  run('/bin/sh', [w.launcher], extra);
+  return { w, ...JSON.parse(fs.readFileSync(capture)) };
+};
+const grants = args => args.flatMap((a, i) => a === '--add-dir' ? [args[i + 1]] : []);
+const cases = {
+  f1() {
+    const first = open(linked, { FIX_CASE: 'f1' }), second = open(linked, { FIX_CASE: 'f1' });
+    for (const worker of [first, second]) {
+      const scratch = fs.realpathSync(path.join(worker.w.runDir, 'tmp'));
+      assert.equal(worker.tmpdir, scratch, 'os.tmpdir() resolves to private worker scratch');
+      for (const key of ['TMPDIR','TMP','TEMP']) assert.equal(worker[key], scratch);
+      assert.ok(grants(worker.args).includes(scratch), 'scratch receives an explicit write grant');
+      assert.equal(fs.statSync(scratch).mode & 0o777, 0o700);
+      assert.ok(!grants(worker.args).includes(home), 'shared temp root remains ungranted');
+    }
+    assert.notEqual(first.tmpdir, second.tmpdir, 'workers have separate scratch directories');
+  },
+  f2() {
+    git(repo, 'config', 'core.splitIndex', 'true'); git(repo, 'config', 'splitIndex.maxPercentChange', '0');
+    git(linked, 'update-index', '--split-index');
+    fs.writeFileSync(path.join(linked, 'file.txt'), 'changed\n');
+    const worker = open(linked, { FIX_CASE: 'f2', GIT_CONFIG_COUNT: '1', GIT_CONFIG_KEY_0: 'probe.inherited', GIT_CONFIG_VALUE_0: 'keep' });
+    assert.equal(worker.splitIndex, 'false', 'worker forces ordinary index mode');
+    assert.equal(worker.inherited, 'keep', 'existing runtime Git config is preserved');
+    assert.ok(worker.before.length > 0, 'fixture starts with a real split index');
+    assert.deepEqual(worker.after, worker.before, 'staging and committing create no new shared indexes');
+    assert.equal(worker.sharedIndex, '', 'the resulting index is no longer split');
+    assert.equal(git(repo, 'config', '--local', '--get', 'core.splitIndex'), 'true', 'persistent configuration is unchanged');
+    assert.equal(git(linked, 'log', '-1', '--format=%s'), 'worker ordinary index');
+    const admin = git(linked, 'rev-parse', '--absolute-git-dir');
+    assert.ok(!grants(worker.args).includes(admin), 'split-index support never grants the admin directory');
+  },
+  s1() {
+    const subdir = path.join(linked, 'subdir'); fs.mkdirSync(subdir);
+    const forged = path.join(home, 'forged'); fs.mkdirSync(forged);
+    const admin = git(linked, 'rev-parse', '--absolute-git-dir'); fs.writeFileSync(path.join(forged, '.git'), `gitdir: ${admin}\n`);
+    const outside = path.join(home, 'outside'); fs.mkdirSync(outside);
+    for (const cwd of [repo, linked, subdir, forged, outside]) {
+      const worker = open(cwd);
+      for (const setting of ['sandbox_workspace_write.writable_roots=[]','sandbox_workspace_write.exclude_tmpdir_env_var=true','sandbox_workspace_write.exclude_slash_tmp=true']) {
+        assert.ok(worker.args.some((a,i)=>a==='-c' && worker.args[i+1]===setting), `${cwd}: ${setting}`);
+      }
+      assert.ok(!grants(worker.args).includes(admin));
+      assert.ok(!grants(worker.args).includes(path.join(repo, '.git')));
+      if (cwd !== linked) assert.deepEqual(grants(worker.args), [path.join(worker.w.runDir, 'tmp')], 'unvalidated paths get scratch only');
+    }
+  },
+};
+for (const [name, test] of Object.entries(cases)) {
+  if (process.env.FIX_CASE && process.env.FIX_CASE !== name) continue;
+  test(); console.log(`PASS ${name}`);
+}
diff --git a/tests/agent-git-probe.mjs b/tests/agent-git-probe.mjs
new file mode 100644
index 0000000..dbb0981
--- /dev/null
+++ b/tests/agent-git-probe.mjs
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-git-probe-test-'));
+const repo = path.join(home, 'repo'), bin = path.join(home, 'bin'), calls = path.join(home, 'calls.jsonl');
+fs.mkdirSync(repo); fs.mkdirSync(bin);
+const env = { ...process.env, HOME: home, PATH: `${bin}:${process.env.PATH}`, PROBE_TEST_CALLS: calls, GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' };
+for (const key of ['GIT_DIR','GIT_WORK_TREE','GIT_COMMON_DIR','GIT_INDEX_FILE','GIT_CONFIG_COUNT']) delete env[key];
+const git = (...args) => {
+  const r = spawnSync('git', ['-C', repo, ...args], { env, encoding: 'utf8', timeout: 30000 });
+  assert.equal(r.status, 0, r.stderr); return r.stdout.trim();
+};
+git('init'); git('config', 'user.name', 'Probe test'); git('config', 'user.email', 'test@example.invalid');
+fs.writeFileSync(path.join(repo, 'seed'), 'base\n'); git('add', 'seed'); git('commit', '-m', 'base');
+const before = git('rev-parse', 'HEAD'), branch = git('symbolic-ref', 'HEAD');
+const common = path.join(repo, '.git'), config = fs.readFileSync(path.join(common, 'config'));
+fs.writeFileSync(path.join(common, 'hooks', 'existing-hook'), 'keep me\n');
+const script = path.join(repo, 'builds/codex-git-admin/probe.sh');
+fs.mkdirSync(path.dirname(script), { recursive: true }); fs.copyFileSync(path.join(root, 'builds/codex-git-admin/probe.sh'), script);
+fs.writeFileSync(path.join(bin, 'model-id'), `#!${process.execPath}\nconst fs=require('node:fs');fs.appendFileSync(process.env.PROBE_TEST_CALLS,JSON.stringify({modelArgs:process.argv.slice(2)})+'\\n');if(process.argv.includes('--role'))process.exit(2);console.log('gpt-test');\n`, { mode: 0o755 });
+fs.mkdirSync(path.join(repo, 'bin'));
+fs.writeFileSync(path.join(repo, 'bin/agent.mjs'), `
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { createRequire } from 'node:module';
+import { execFileSync } from 'node:child_process';
+const require = createRequire(import.meta.url), args = process.argv.slice(2), command = args[0];
+const entry = { command, args };
+if (command === 'open') {
+  const cwd = args[args.indexOf('--cwd') + 1]; process.chdir(cwd); entry.cwd = cwd;
+  entry.admin = execFileSync('git', ['rev-parse','--absolute-git-dir'], { encoding:'utf8' }).trim();
+  const common = path.resolve(execFileSync('git',['rev-parse','--git-common-dir'],{encoding:'utf8'}).trim());
+  const blocked = new Set(['commondir','gitdir','config.worktree'].map(n=>path.join(entry.admin,n)).concat(path.join(common,'config')));
+  entry.attempts = [];
+  const fakeFs = new Proxy(fs, { get(target, key) {
+    if (!['writeFileSync','openSync'].includes(key)) return target[key];
+    return (file, ...rest) => {
+      const absolute = path.resolve(file);
+      const protectedPath = blocked.has(absolute) || absolute.startsWith(path.join(common,'hooks') + path.sep);
+      if (protectedPath && (key === 'writeFileSync' || rest[0] === 'r+')) {
+        entry.attempts.push(absolute);
+        if (process.env.PROBE_TEST_MODE === 'denied') throw Object.assign(new Error('Permission denied'), {code:'EACCES'});
+      }
+      return target[key](file, ...rest);
+    };
+  } });
+  if (process.env.PROBE_TEST_MODE !== 'stuck') vm.runInNewContext(fs.readFileSync('probe-worker.cjs','utf8'), { require: name => name === 'node:fs' ? fakeFs : require(name), console: { log() {} } });
+}
+fs.appendFileSync(process.env.PROBE_TEST_CALLS, JSON.stringify(entry)+'\\n');
+console.log(JSON.stringify(command === 'open' ? {id:'fake-worker'} : command === 'wait' ? {state:process.env.PROBE_TEST_MODE === 'stuck'?'stuck':'done',kind:'trust'} : {status:'closed'}));
+if(command === 'wait' && process.env.PROBE_TEST_MODE === 'stuck') process.exitCode=3;
+`);
+for (const mode of ['denied', 'leaks', 'stuck']) {
+  fs.writeFileSync(calls, '');
+  const r = spawnSync('/bin/sh', [script, ...(mode === 'leaks' ? ['probe-codex'] : [])], { env: { ...env, PROBE_TEST_MODE: mode }, encoding: 'utf8', timeout: 90000 });
+  assert.equal(r.status, mode === 'denied' ? 0 : 1, `${mode}: ${r.stderr}\n${r.stdout}`);
+  const events = fs.readFileSync(calls, 'utf8').trim().split('\n').map(JSON.parse);
+  assert.deepEqual(events.find(e=>e.modelArgs).modelArgs, [mode === 'leaks' ? 'probe-codex' : 'sol'], 'family selection never queries the builder role');
+  const opened = events.find(e=>e.command === 'open');
+  assert.ok(opened, 'fake acs-agent opened the worker');
+  assert.equal(opened.args[1], mode === 'leaks' ? 'probe-codex' : 'sol');
+  assert.equal(events.at(-1).command, 'close', 'the worker closes before worktree removal');
+  assert.ok(!fs.existsSync(opened.cwd), `${mode}: temporary linked worktree removed`);
+  assert.ok(!fs.existsSync(opened.admin), `${mode}: worktree administration directory removed`);
+  assert.ok(!fs.readdirSync(path.join(common, 'hooks')).some(n=>n.startsWith('acs-codex-git-admin-')), `${mode}: leaked unique hook removed`);
+  assert.equal(fs.readFileSync(path.join(common, 'hooks', 'existing-hook'), 'utf8'), 'keep me\n');
+  assert.ok(fs.readFileSync(path.join(common, 'config')).equals(config), 'shared config bytes remain identical');
+  assert.equal(git('rev-parse', 'HEAD'), before); assert.equal(git('symbolic-ref', 'HEAD'), branch);
+  assert.equal((git('worktree','list','--porcelain').match(/^worktree /gm)||[]).length, 1);
+  assert.match(r.stdout, /Probe worktree removed/);
+  if (mode !== 'stuck') {
+    assert.match(r.stdout, /commit: ok/);
+    assert.match(r.stdout, /tempdir: ok/, 'probe requires a successful write under os.tmpdir()');
+    assert.match(r.stdout, new RegExp('commondir: ' + (mode === 'denied' ? 'denied' : 'ok')));
+    const hook = opened.attempts.find(p=>path.basename(p).startsWith('acs-codex-git-admin-'));
+    assert.ok(hook, 'worker attempted the unique hook write');
+  }
+  const output = r.stdout.match(/Probe output retained at: (.+)/)?.[1];
+  assert.ok(output); fs.rmSync(output, { recursive: true, force: true });
+}
+console.log('git probe uses this repository, selects a Codex family, commits, and cleans up on success, leaked writes, and trust refusal without live models');

