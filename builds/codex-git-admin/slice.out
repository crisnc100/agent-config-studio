     7	const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
     8	const home = fs.realpathSync(tempDir('acs-git-probe-test-'));
     9	const repo = path.join(home, 'repo'), bin = path.join(home, 'bin'), calls = path.join(home, 'calls.jsonl');
    10	fs.mkdirSync(repo); fs.mkdirSync(bin);
    11	const env = { ...process.env, HOME: home, PATH: `${bin}:${process.env.PATH}`, PROBE_TEST_CALLS: calls, GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' };
    12	for (const key of ['GIT_DIR','GIT_WORK_TREE','GIT_COMMON_DIR','GIT_INDEX_FILE','GIT_CONFIG_COUNT']) delete env[key];
    13	const git = (...args) => {
    14	  const r = spawnSync('git', ['-C', repo, ...args], { env, encoding: 'utf8', timeout: 30000 });
    15	  assert.equal(r.status, 0, r.stderr); return r.stdout.trim();
    16	};
    17	git('init'); git('config', 'user.name', 'Probe test'); git('config', 'user.email', 'test@example.invalid');
    18	fs.writeFileSync(path.join(repo, 'seed'), 'base\n'); git('add', 'seed'); git('commit', '-m', 'base');
    19	const before = git('rev-parse', 'HEAD'), branch = git('symbolic-ref', 'HEAD');
    20	const common = path.join(repo, '.git'), config = fs.readFileSync(path.join(common, 'config'));
    21	fs.writeFileSync(path.join(common, 'hooks', 'existing-hook'), 'keep me\n');
    22	const script = path.join(repo, 'builds/codex-git-admin/probe.sh');
    23	fs.mkdirSync(path.dirname(script), { recursive: true }); fs.copyFileSync(path.join(root, 'builds/codex-git-admin/probe.sh'), script);
    24	fs.writeFileSync(path.join(bin, 'model-id'), `#!${process.execPath}\nconst fs=require('node:fs');fs.appendFileSync(process.env.PROBE_TEST_CALLS,JSON.stringify({modelArgs:process.argv.slice(2)})+'\\n');if(process.argv.includes('--role'))process.exit(2);console.log('gpt-test');\n`, { mode: 0o755 });
    25	fs.mkdirSync(path.join(repo, 'bin'));
    26	fs.writeFileSync(path.join(repo, 'bin/agent.mjs'), `
    27	import fs from 'node:fs';
    28	import path from 'node:path';
    29	import vm from 'node:vm';
    30	import { createRequire } from 'node:module';
    31	import { execFileSync } from 'node:child_process';
    32	const require = createRequire(import.meta.url), args = process.argv.slice(2), command = args[0];
    33	const entry = { command, args };
    34	if (command === 'open') {
    35	  const cwd = args[args.indexOf('--cwd') + 1]; process.chdir(cwd); entry.cwd = cwd;
    36	  entry.admin = execFileSync('git', ['rev-parse','--absolute-git-dir'], { encoding:'utf8' }).trim();
    37	  const common = path.resolve(execFileSync('git',['rev-parse','--git-common-dir'],{encoding:'utf8'}).trim());
    38	  const blocked = new Set(['commondir','gitdir','config.worktree'].map(n=>path.join(entry.admin,n)).concat(path.join(common,'config')));
    39	  entry.attempts = [];
    40	  const fakeFs = new Proxy(fs, { get(target, key) {
    41	    if (!['writeFileSync','openSync'].includes(key)) return target[key];
    42	    return (file, ...rest) => {
    43	      const absolute = path.resolve(file);
    44	      const protectedPath = blocked.has(absolute) || absolute.startsWith(path.join(common,'hooks') + path.sep);
    45	      if (protectedPath && (key === 'writeFileSync' || rest[0] === 'r+')) {
    46	        entry.attempts.push(absolute);
    47	        if (process.env.PROBE_TEST_MODE === 'denied') throw Object.assign(new Error('Permission denied'), {code:'EACCES'});
    48	      }
    49	      return target[key](file, ...rest);
    50	    };
    51	  } });
    52	  if (process.env.PROBE_TEST_MODE !== 'stuck') vm.runInNewContext(fs.readFileSync('probe-worker.cjs','utf8'), { require: name => name === 'node:fs' ? fakeFs : require(name), console: { log() {} } });
    53	}
    54	fs.appendFileSync(process.env.PROBE_TEST_CALLS, JSON.stringify(entry)+'\\n');
    55	console.log(JSON.stringify(command === 'open' ? {id:'fake-worker'} : command === 'wait' ? {state:process.env.PROBE_TEST_MODE === 'stuck'?'stuck':'done',kind:'trust'} : {status:'closed'}));
    56	if(command === 'wait' && process.env.PROBE_TEST_MODE === 'stuck') process.exitCode=3;
    57	`);
    58	for (const mode of ['denied', 'leaks', 'stuck']) {
    59	  fs.writeFileSync(calls, '');
    60	  const r = spawnSync('/bin/sh', [script, ...(mode === 'leaks' ? ['probe-codex'] : [])], { env: { ...env, PROBE_TEST_MODE: mode }, encoding: 'utf8', timeout: 90000 });
    61	  assert.equal(r.status, mode === 'denied' ? 0 : 1, `${mode}: ${r.stderr}\n${r.stdout}`);
    62	  const events = fs.readFileSync(calls, 'utf8').trim().split('\n').map(JSON.parse);
    63	  assert.deepEqual(events.find(e=>e.modelArgs).modelArgs, [mode === 'leaks' ? 'probe-codex' : 'sol'], 'family selection never queries the builder role');
    64	  const opened = events.find(e=>e.command === 'open');
    65	  assert.ok(opened, 'fake acs-agent opened the worker');
    66	  assert.equal(opened.args[1], mode === 'leaks' ? 'probe-codex' : 'sol');
    67	  assert.equal(events.at(-1).command, 'close', 'the worker closes before worktree removal');
    68	  assert.ok(!fs.existsSync(opened.cwd), `${mode}: temporary linked worktree removed`);
    69	  assert.ok(!fs.existsSync(opened.admin), `${mode}: worktree administration directory removed`);
    70	  assert.ok(!fs.readdirSync(path.join(common, 'hooks')).some(n=>n.startsWith('acs-codex-git-admin-')), `${mode}: leaked unique hook removed`);
    71	  assert.equal(fs.readFileSync(path.join(common, 'hooks', 'existing-hook'), 'utf8'), 'keep me\n');
    72	  assert.ok(fs.readFileSync(path.join(common, 'config')).equals(config), 'shared config bytes remain identical');
    73	  assert.equal(git('rev-parse', 'HEAD'), before); assert.equal(git('symbolic-ref', 'HEAD'), branch);
    74	  assert.equal((git('worktree','list','--porcelain').match(/^worktree /gm)||[]).length, 1);
    75	  assert.match(r.stdout, /Probe worktree removed/);
    76	  if (mode !== 'stuck') {
    77	    assert.match(r.stdout, /commit: ok/);
    78	    assert.match(r.stdout, /tempdir: ok/, 'probe requires a successful write under os.tmpdir()');
    79	    assert.match(r.stdout, new RegExp('commondir: ' + (mode === 'denied' ? 'denied' : 'ok')));
    80	    const hook = opened.attempts.find(p=>path.basename(p).startsWith('acs-codex-git-admin-'));
    81	    assert.ok(hook, 'worker attempted the unique hook write');
    82	  }
    83	  const output = r.stdout.match(/Probe output retained at: (.+)/)?.[1];
    84	  assert.ok(output); fs.rmSync(output, { recursive: true, force: true });
    85	}
    86	console.log('git probe uses this repository, selects a Codex family, commits, and cleans up on success, leaked writes, and trust refusal without live models');

