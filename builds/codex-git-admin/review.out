+      '          if [ "$physical" = "$gitdir/logs" ] || { [ ! -e "$gitdir/logs" ] && [ ! -L "$gitdir/logs" ]; }; then',
+      '            set -- "$@" --add-dir "$gitdir/logs"',
+      '          fi',
       '        fi',
       '      ;; esac',
       '    ;; esac',
