    14	      if (cmd === 'open' && flag === '--mcp') { opts.mcp = true; continue; }
    15	      const allowed = cmd === 'open' ? ['--effort', '--cwd', '--role', '--prompt-file'] : cmd === 'wait' ? ['--timeout', '--stall-after', '--command-after'] : [];
    16	      if (!allowed.includes(flag) || args[i + 1] === undefined) throw Object.assign(new Error(usage), { exitCode: 2 });
