    36	  }
    37	  if (cmd === 'send' && pos.length === 2) {
    38	    const r = await sendWorker(pos[0], pos[1], ctx);
    39	    console.log(json ? JSON.stringify(r) : 'sent'); return 0;
    40	  }
    41	  if (cmd === 'answer' && pos.length === 1) {
