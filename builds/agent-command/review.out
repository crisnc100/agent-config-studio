    14	const line = x => JSON.stringify(x) + '\n';
    15	function turn(w, text, complete = true) {
    16	  if (w.vendor === 'codex') {
    17	    fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'task_started' } }));
    18	    fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'user_message', message: text } }));
    19	    if (complete) fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'task_complete', last_agent_message: 'exact\nanswer  ' } }));
    20	  } else if (w.vendor === 'claude') {
    21	    fs.appendFileSync(w.transcript, line({ type: 'user', message: { role: 'user', content: text } }));
    22	    if (complete) {
    23	      fs.appendFileSync(w.transcript, line({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: 'exact\nanswer  ' }] }, stop_reason: 'end_turn' }));
    24	      fs.appendFileSync(path.join(home, '.cmuxterm/events.jsonl'), line({ name: 'agent.hook.Stop', surface_id: w.surface_id, session_id: w.session, occurred_at: new Date().toISOString() }));
    25	    }
    26	  } else {
    27	    fs.appendFileSync(w.transcript, line({ type: 'turn_started' }));
    28	    fs.appendFileSync(w.history, line({ role: 'user', content: text }));
    29	    if (complete) {
    30	      fs.appendFileSync(w.history, line({ role: 'assistant', content: 'exact\nanswer  ' }));
    31	      fs.appendFileSync(w.transcript, line({ type: 'turn_ended' }));
    32	    }
    33	  }
    34	}
    35	if (process.env.FAKE_OFFLINE) { console.error('socket unreachable'); process.exit(1); }
    36	function fail(code) {
    37	  put(file, JSON.stringify(state));
