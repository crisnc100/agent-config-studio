import os from 'node:os';
import path from 'node:path';
import fs from 'node:fs';
import { derive, unsafeLocation } from './roots.js';

export const HOME = os.homedir();
export const CLAUDE_HOME = path.join(HOME, '.claude');
export const CODEX_HOME = path.join(HOME, '.codex');
export const AGENTS_HOME = path.join(HOME, '.agents');
export const GROK_HOME = path.join(HOME, '.grok');
export const WORKTREE_HOME = path.join(HOME, '.config', 'worktree');
export const STUDIO_HOME = path.join(HOME, '.agent-config-studio');
export const HISTORY_REPO = path.join(STUDIO_HOME, 'history');

/**
 * The project folders, as roots.json says right now (lib/roots.js). Read per
 * call, never bound at load, so `acs roots add` applies without a restart.
 * Edit roots are realpath'd and active; read roots appear only in `readRoots`.
 */
export const currentRoots = () => derive({ home: HOME });

/**
 * Only paths under these roots are ever readable or writable: the agents'
 * homes plus the edit roots. ~/.agents is included because ~/.claude/skills
 * symlinks into it. A read root is never here — the editor, the writer and
 * the history mirror have no business touching it.
 */
export const safeRoots = () => currentRoots().safeRoots;

/**
 * Where skill discovery is allowed to look, and NOTHING else: the skills
 * trees plus every root, read ones included. lib/skills.js passes this list to
 * resolveSafe() as its own roots, so the widening to read roots stops at that
 * one caller — and a test asserts GET /api/file still 403s on a read-root path.
 */
export function skillRoots() {
  const d = currentRoots();
  const skipped = new Set(d.builtinInvalid.map((b) => b.name));
  const real = (p) => { try { return fs.realpathSync.native(p); } catch { return p; } };
  // A skills tree counts only if its home is safe and it, too, really sits
  // somewhere safe — never ~/.ssh, HOME or above, or the studio's folder.
  const global = [['~/.claude', CLAUDE_HOME], ['~/.codex', CODEX_HOME], ['~/.agents', AGENTS_HOME]]
    .filter(([name]) => !skipped.has(name))
    .map(([, dir]) => real(path.join(dir, 'skills')))
    .filter((p) => !unsafeLocation(p, { home: HOME }));
  return [...global, ...d.allRoots];
}

/** HOME as it really is; paths come back from realpath in this spelling. */
let realHomeCache = null;
export function realHome() {
  if (realHomeCache === null) { try { realHomeCache = fs.realpathSync.native(HOME); } catch { realHomeCache = HOME; } }
  return realHomeCache;
}

/**
 * Never read, never write, never list. Secrets and machine state that would be
 * actively harmful to surface in a browser tab.
 */
const DENY_EXACT = new Set([
  path.join(CLAUDE_HOME, '.credentials.json'),
  path.join(CODEX_HOME, 'auth.json'),
  path.join(GROK_HOME, 'auth.json'),
].map((p) => p.toLowerCase()));

const DENY_SEGMENTS = [
  '.git',
  'node_modules',
  '.credentials.json',
  'auth.json',
];

/** By name, case-insensitively: on macOS AUTH.JSON opens auth.json. */
export function isDenied(abs) {
  const low = String(abs).toLowerCase();
  if (DENY_EXACT.has(low)) return true;
  const segs = low.split(path.sep);
  return DENY_SEGMENTS.some((d) => segs.includes(d));
}

/**
 * Every credential file's identity, (dev, ino), by stat only — never opened:
 * auth.json in ~/.codex, $CODEX_HOME and every seat home, ~/.claude's
 * .credentials.json, Grok's auth.json. Read fresh per call: a login made a
 * minute ago is a new inode.
 */
function credentialIds() {
  const files = [
    path.join(CODEX_HOME, 'auth.json'), path.join(CLAUDE_HOME, '.credentials.json'), path.join(GROK_HOME, 'auth.json'),
    process.env.CODEX_HOME && path.join(process.env.CODEX_HOME, 'auth.json'),
    process.env.GROK_HOME && path.join(process.env.GROK_HOME, 'auth.json'),
  ];
  // The seat registry is the studio's own file; it names the other homes.
  try {
    for (const s of JSON.parse(fs.readFileSync(path.join(STUDIO_HOME, 'seats.json'), 'utf8')).seats || []) {
      if (typeof s?.home === 'string') files.push(path.join(s.home, 'auth.json'), path.join(s.home, '.credentials.json'));
    }
  } catch {}
  try { for (const d of fs.readdirSync(path.join(HOME, '.codex-seats'))) files.push(path.join(HOME, '.codex-seats', d, 'auth.json')); } catch {}
  const ids = new Set();
  for (const f of files) {
    if (!f) continue;
    try { const st = fs.statSync(f); ids.add(`${st.dev}:${st.ino}`); } catch {}
  }
  return ids;
}

/**
 * THE read of a user file's content — every route that hands content out
 * comes through here (tests/setup-guards.mjs). The file is opened first and
 * judged by its descriptor, so nothing can change between the check and the
 * read: it must be a regular file, have one name (another hard link may be a
 * credential's), and not BE a credential — by (dev, ino), which settles
 * every question of names, aliases, case and `..` at once. Then the bytes
 * come from that same descriptor. Returns { buf, stat }.
 */
export function openUserFile(p, { maxBytes = Infinity } = {}) {
  let fd;
  // O_NONBLOCK: a FIFO or a device must never hold the server in open() —
  // it opens at once and the fstat below refuses it. Reads of a regular file
  // are unaffected by the flag.
  try { fd = fs.openSync(p, fs.constants.O_RDONLY | (fs.constants.O_NONBLOCK ?? 0)); }
  catch (e) { throw Object.assign(new Error(e.code === 'ENOENT' ? `no such file: ${tilde(String(p))}` : e.message), { status: e.code === 'ENOENT' ? 404 : 403, code: e.code }); }
  try {
    const stat = fs.fstatSync(fd);
    if (!stat.isFile()) throw Object.assign(new Error('not a file'), { status: 400 });
    if (stat.nlink !== 1) throw Object.assign(new Error("this file has hard links; ACS won't open it"), { status: 403 });
    if (credentialIds().has(`${stat.dev}:${stat.ino}`)) throw Object.assign(new Error('path is protected'), { status: 403 });
    if (stat.size > maxBytes) throw Object.assign(new Error('file too large'), { status: 413 });
    return { buf: fs.readFileSync(fd), stat };
  } finally { fs.closeSync(fd); }
}

/** openUserFile as text. */
export const readUserText = (p, opts) => openUserFile(p, opts).buf.toString('utf8');

const sameInode = (a, b) => a.dev === b.dev && a.ino === b.ino;

/**
 * A read that stays inside `roots` from resolution to the last byte, for a
 * path a model asked for (lib/assist-files.js). resolveSafe proves where the
 * path is; the file is then opened without following a final link and its
 * descriptor must be the very inode resolved; after the open the path must
 * still resolve to the same place, inside the roots, to that inode. A file or
 * a parent directory swapped for a link at any point in between changes an
 * inode one of those compares, and the read is refused. The same descriptor
 * checks as openUserFile apply. Bytes are counted as read: at most
 * `maxBytes` + 1 are ever buffered. Returns { buf, stat, real }.
 *
 * `afterResolve` is a test seam (the swap tests); nothing in the app passes it.
 */
export function readContained(input, roots, { maxBytes = Infinity, afterResolve = null } = {}) {
  const changed = () => Object.assign(new Error('the file changed underneath the read'), { status: 409 });
  const real = resolveSafe(input, roots);
  let pre;
  try { pre = fs.lstatSync(real); }
  catch (e) { throw Object.assign(new Error(e.code === 'ENOENT' ? `no such file: ${tilde(real)}` : e.message), { status: e.code === 'ENOENT' ? 404 : 403 }); }
  if (!pre.isFile()) throw Object.assign(new Error('not a file'), { status: 400 });
  if (afterResolve) afterResolve(real);
  let fd;
#!/usr/bin/env node
/**
 * model-id — which id is current <family>?
 *
 *   model-id <family>        claude-fable-5-1          (from the registry)
 *   model-id <raw-id>        passes through unchanged  (gpt-5.6-sol → gpt-5.6-sol)
 *   model-id --table         family → id
 *   model-id --json          the merged registry
 *   model-id --lint [paths]  raw ids / versioned names in the skill scope; exit 1 on any
 *   model-id --sidecars      ids in CLI-owned files that are not current registry values
 *   model-id --install       copy this resolver (and ask-model) out of the checkout and link them in ~/.local/bin
 *   model-id --role <name>   family=… id=… effort=… alt=…  (add --json for the whole role)
 *   model-id --flavor <fam>  how to brief that family, as plain text
 *   model-id --roles         every role → family, id, effort, alt (--table is families only)
 *   model-id --effort <fam> [--role <role>[,<role>…]] [--no-alt]
 *                            that family's effort: from the first listed role that gives it one, else its flavor;
 *                            nothing when none is set (lib/roles.js familyEffort, the rule ask-model uses).
 *                            --no-alt counts a role's members only, never its alt (a builder's effort)
 *
 * A failed resolution NEVER prints an empty string. It exits 1, says why on
 * stderr, and prints MODEL-ID-UNRESOLVED-<name> — an id every CLI rejects
 * loudly — so an unchecked `-m "$(model-id x)"` cannot fall through to a CLI's
 * own default model.
 *
 * The role flags (lib/roles.js) exit 2 on any failure instead, so a caller can
 * tell "no such role" from the old resolver's usage error; --role still prints
 * the unresolved id in place of every value.
 *
 * Imports lib/models.js, and lib/roles.js only when a role flag asks for it,
 * so a family lookup never depends on roles. Never lib/harness.js: that
 * module sweeps temp files at import, and this runs from every skill.
 */
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import {
  DEFAULTS_PATH, homeDir, lint, loadRegistry, resolveModel, sidecars, userPath,
} from '../lib/models.js';

const args = process.argv.slice(2);
/** The whole interface, said when a role flag is misused (the bare usage line below stays as it was). */
const FULL_USAGE = 'usage: model-id <family|raw-id> | --table | --json | --lint [paths] | --sidecars | --install | --role <name> [--json] | --flavor <family> [--json] | --roles [--json] | --effort <family> [--role <role>[,<role>…]] [--no-alt] [--json]';
const tilde = (p) => (p.startsWith(homeDir() + path.sep) ? '~' + p.slice(homeDir().length) : p);

function unresolved(name, why) {
  process.stderr.write(`model-id: ${why}\n`);
  process.stdout.write(`MODEL-ID-UNRESOLVED-${String(name).replace(/[^A-Za-z0-9._-]/g, '_') || 'missing'}\n`);
  process.exit(1);
}

function registryOrDie() {
  const r = loadRegistry();
  if (r.error) {
    process.stderr.write(`model-id: model registry is invalid — ${r.error}\n`);
    process.exit(1);
  }
  return r;
}

/**
 * Copies, not a symlink into a checkout: the resolver every skill calls must
 * not change or vanish when a worktree is removed or a branch is checked out.
 * The launcher pins the node that ran the install, because a skill's
 * non-interactive `sh -c` may not have node on PATH at all.
 */
async function install() {
  const home = homeDir();
  const studio = path.join(home, '.agent-config-studio');
  const resolver = path.join(studio, 'resolver');
  const src = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
  const put = (rel, body, mode = 0o644) => {
    const dest = path.join(resolver, rel);
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    // A fresh random name, created exclusively: a link planted at a guessable name is never written through.
    const tmp = `${dest}.tmp-${process.pid}-${crypto.randomBytes(4).toString('hex')}`;
    try {
      fs.writeFileSync(tmp, body, { mode, flag: 'wx' });
      fs.renameSync(tmp, dest);
    } finally { fs.rmSync(tmp, { force: true }); }
  };
  // The roles pair before the entry point that loads it. A source without
  // them installs a copy that resolves families and refuses role flags.
  const rolesSrc = path.join(src, 'lib', 'roles.js');
  const rolesDefaults = path.join(src, 'lib', 'roles.default.json');
  if (fs.existsSync(rolesSrc)) put('lib/roles.js', fs.readFileSync(rolesSrc));
  else fs.rmSync(path.join(resolver, 'lib', 'roles.js'), { force: true });
  if (fs.existsSync(rolesDefaults)) put('lib/roles.default.json', fs.readFileSync(rolesDefaults));
  else fs.rmSync(path.join(resolver, 'lib', 'roles.default.json'), { force: true });
  put('bin/model-id.mjs', fs.readFileSync(path.join(src, 'bin', 'model-id.mjs')));
  put('lib/models.js', fs.readFileSync(path.join(src, 'lib', 'models.js')));
  put('models.default.json', fs.readFileSync(DEFAULTS_PATH));
  put('package.json', '{ "type": "module", "private": true }\n');

  const launcher = path.join(studio, 'bin', 'model-id');
  const entry = path.join(resolver, 'bin', 'model-id.mjs');
  const q = (s) => `'${s.replace(/'/g, `'\\''`)}'`;
  fs.mkdirSync(path.dirname(launcher), { recursive: true });
  const body = [
    '#!/bin/sh',
    '# Installed by `model-id --install` from Agent Config Studio. Re-run that to update.',
    `NODE=${q(process.execPath)}`,
    '# Pinned path first, then node on PATH, then Homebrew\'s default; otherwise fail loudly.',
    '[ -x "$NODE" ] || NODE=$(command -v node 2>/dev/null) || NODE=',
    '[ -n "$NODE" ] || { [ -x "${MODEL_ID_BREW_NODE:-/opt/homebrew/bin/node}" ] && NODE=${MODEL_ID_BREW_NODE:-/opt/homebrew/bin/node}; }',
    'if [ -z "$NODE" ]; then',
    '  echo "model-id: node not found" >&2',
    '  echo "MODEL-ID-UNRESOLVED-${1:-missing}"',
    '  exit 1',
    'fi',
    `exec "$NODE" ${q(entry)} "$@"`,
    '',
  ].join('\n');
  fs.writeFileSync(`${launcher}.tmp-${process.pid}`, body, { mode: 0o755 });
  fs.renameSync(`${launcher}.tmp-${process.pid}`, launcher);

  const link = path.join(home, '.local', 'bin', 'model-id');
  fs.mkdirSync(path.dirname(link), { recursive: true });
  let existing = null;
  try { existing = fs.lstatSync(link); } catch {}
  if (existing && !existing.isSymbolicLink()) {
    process.stderr.write(`model-id: ${tilde(link)} exists and is not a symlink — not replacing it.\n`);
    process.exit(1);
  }
  if (existing) fs.unlinkSync(link);
  fs.symlinkSync(launcher, link);
  process.stdout.write(`installed ${tilde(resolver)}\nlauncher  ${tilde(launcher)}\nlinked    ${tilde(link)} → ${tilde(launcher)}\n`);

  // ask-model imports this resolver's lib/, so it is installed beside it, by its own
  // install(). A checkout keeps it in tools/, apart from bin/, because it runs model
  // CLIs; the installed copy keeps it in bin/, so a re-run from there restores it too.
  const agentInstaller = path.join(src, 'bin', 'agent-install.mjs');
  if (fs.existsSync(agentInstaller)) {
    const { install: installAgent } = await import(pathToFileURL(agentInstaller).href);
    process.stdout.write(installAgent({ home, studio, resolver }));
  }
  const askModel = [path.join(src, 'tools', 'ask-model.mjs'), path.join(src, 'bin', 'ask-model.mjs')].find((p) => fs.existsSync(p));
  if (!askModel) return;
  let r;
  try { r = (await import(pathToFileURL(askModel).href)).install({ home, studio, resolver }); }
  catch (e) { r = { lines: '', error: `ask-model was not installed: ${e.message}` }; }
  process.stdout.write(r.lines);
  if (r.error) {
    process.stderr.write(`model-id: ${r.error}\n`);
    process.exit(1);
  }
}

/** lib/roles.js, or why this copy has none. */
async function rolesLib() {
  try { return await import('../lib/roles.js'); }
  catch (e) { return { missing: `this resolver has no roles support (${e.code || e.message}) — run: acs install-model-id` }; }
}

/** Every role, one row each, or the reason there are none. */
function rolesRows(R) {
  if (R.missing) return { error: R.missing };
  const { loadRoles, resolveRole } = R;
  const loaded = loadRoles();
  if (loaded.error) return { error: loaded.error };
  const names = [...new Set([...Object.keys(loaded.roles), ...(loaded.unset || [])])].sort();
  const results = [];
  const rows = names.map((name) => {
    if (loaded.unset?.includes(name)) return [name, '-', '(not set)', '-', '-'];
    const r = resolveRole(name);
    results.push(r);
    return r.error ? [name, '?', `(${r.error})`, '', ''] : [name, r.family, r.id, r.effort || '-', r.alt || '-'];
  });
  pauseNotes(R, results);
  return { rows, failed: rows.some((r) => r[1] === '?'), unset: loaded.unset || [], source: loaded.source };
}

function rolesSection(R) {
  const { rows, error, failed, unset, source } = rolesRows(R);
  if (error) return { error };
  const all = [['role', 'family', 'id', 'effort', 'alt'], ...rows];
  const w = all[0].map((_, i) => Math.max(...all.map((r) => r[i].length)));
  const lines = all.map((r) => r.map((c, i) => (i === r.length - 1 ? c : c.padEnd(w[i]))).join('  ').trimEnd());
  const note = source === R.ROLES_DEFAULTS_PATH ? ` (no ${tilde(R.rolesUserPath())})` : '';
  const choose = unset.length ? `not set: ${unset.join(', ')} — choose their models: acs packs install <pack> --set-role <role>=<family>[,<family>…], or in ACS → Models → Roles\n` : '';
  return { text: `${lines.join('\n')}\nroles source: ${tilde(source)}${note}\n${choose}`, failed };
}

/** An unchecked `eval "$(model-id --role x)"` still gets ids every CLI rejects. */
function unresolvedRole(name) {
  const u = `MODEL-ID-UNRESOLVED-${name.replace(/[^A-Za-z0-9._-]/g, '_') || 'missing'}`;
  return `family=${u} id=${u} effort= alt=\n`;
}

