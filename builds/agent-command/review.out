    45	  if (cmd === 'close' && pos.length === 1) {
    46	    const w = closeWorker(pos[0], ctx);
    47	    console.log(json ? JSON.stringify(w) : 'closed'); return 0;
    48	  }
    49	  if (cmd === 'list' && !pos.length) {
    50	    const workers = listWorkers(ctx);
    51	    console.log(json ? JSON.stringify(workers) : workers.map(w => `${w.id} ${w.family} ${w.status}`).join('\n')); return 0;
    52	  }
    53	  throw Object.assign(new Error(usage), { exitCode: 2 });
    54	}
    55	try { process.exitCode = await main(); }
    56	catch (e) { process.stderr.write(`${e.message}\n`); process.exitCode = e.exitCode || 1; }
