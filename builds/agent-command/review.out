    28	    const stallAfter = opts['stall-after'] === undefined ? 300 : Number(opts['stall-after']);
    29	    if (!Number.isFinite(stallAfter) || stallAfter < 0) throw Object.assign(new Error('invalid stall-after'), { exitCode: 2 });
