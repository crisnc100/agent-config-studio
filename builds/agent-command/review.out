    81	}
    82	if (cmd === 'read-screen' || cmd === 'close-surface') {
    83	  const w = state.workers[opt('--surface')];
    84	  if (cmd === 'read-screen' && process.env.FAKE_REMOVE_AFTER_READ && (state.removalReads = (state.removalReads || 0) + 1) > 1) w.closed = true;
    85	  if (!w || w.closed || !state.panes.includes(w.pane_ref)) fail('not_found');
    86	  if (cmd === 'close-surface') w.closed = true;
