    46	if (cmd === 'new-pane' && process.env.FAKE_NEW_PANE_ERROR) fail(process.env.FAKE_NEW_PANE_ERROR);
    47	if (cmd === 'read-screen' && process.env.FAKE_READ_SCREEN_ERROR) fail(process.env.FAKE_READ_SCREEN_ERROR);
    48	if (cmd === 'list-pane-surfaces' && !state.panes.includes(opt('--pane'))) fail('not_found');
    49	if (cmd === 'identify') out = { caller: { workspace_ref: 'workspace:1', pane_ref: process.env.FAKE_PANE || 'pane:1' } };
    50	if (cmd === 'new-pane' || cmd === 'new-surface') {
    51	  const n = ++state.n;
    52	  const script = fs.readFileSync(opt('--command'), 'utf8');
    53	  const vendor = script.includes('exec codex ') ? 'codex' : script.includes('exec claude ') ? 'claude' : 'grok';
    54	  const cwd = script.match(/cd '((?:[^']|'\\'')*)'/)[1].replace(/'\\''/g, "'");
    55	  const session = `session-${n}`;
