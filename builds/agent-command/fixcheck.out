const root = \"/h/.agent-config-studio/agents\";
const eventPath = \"/h/.cmuxterm/events.jsonl\";
function file(file) { if ("'!memory.has(file)) throw Object.assign(new Error("missing "+file),{code:"ENOENT"}); return memory.get(file); }
const mockFs = {
  readdirSync(folder, options) { return [...memory.keys()].filter(f=>pathReal.dirname(f)===folder).map(f=>options?.withFileTypes?{name:pathReal.basename(f),isFile:()=>true,isDirectory:()=>false}:pathReal.basename(f)); },
  statSync(f) { const value = file(f); return {size:Buffer.byteLength(value),mtimeMs:clock-1000,isDirectory:()=>false}; },
  existsSync:f=>memory.has(f), mkdirSync(){},rmdirSync(){},realpathSync:p=>p,
  writeFileSync(f,v){memory.set(f,String(v));},renameSync(a,b){memory.set(b,file(a));memory.delete(a);},rmSync(f){memory.delete(f);}
};
globalThis.agentProbe = {
 fs:mockFs, readUserText:f=>file(f), homeDir:()=>"/h", resolveModel:()=>({id:"claude-test"}),vendorOf:()=>"claude", EFFORTS:new Set(), ROLE_RE:/.*/,
 spawnSync(binary,args){calls.push(args); if(args.includes("send-key"))onKey?.(); return {status:0,stdout:JSON.stringify({text:output}),stderr:""};}
};
let source=fsReal.readFileSync("lib/agent.js","utf8")
.replace("import fs from '"'\\''node:fs'\\'';\",\"const fs=globalThis.agentProbe.fs;\")
.replace(\"import { spawnSync } from '\\''node:child_process'\\'';\",\"const spawnSync=globalThis.agentProbe.spawnSync;\")
.replace(\"import { readUserText } from '\\''./paths.js'\\'';\",\"const readUserText=globalThis.agentProbe.readUserText;\")
.replace(\"import { homeDir, resolveModel, vendorOf, EFFORTS } from '\\''./models.js'\\'';\",\"const {homeDir,resolveModel,vendorOf,EFFORTS}=globalThis.agentProbe;\")
.replace(\"import { ROLE_RE } from '\\''./roles.js'\\'';\",\"const {ROLE_RE}=globalThis.agentProbe;\");
source += \"\\nexport {refresh, approvalDialog, assertSendable};\";
const mod=await import(\"data:text/javascript;base64,\"+Buffer.from(source).toString(\"base64\"));
const ctx={workspace:\"workspace:1\",pane:\"pane:1\"};
const runtime={now:()=>clock,sleep:async ms=>{clock+=ms;},commandAfter:600};
function jsonl(entries){return entries.map(e=>JSON.stringify(e)).join(\"\\n\")+\"\\n\";}
const stamp=t=>new Date(t??clock).toISOString();
function fixture(entries, events=[],settings={}){
 memory.clear();calls.length=0;output=\"Worker screen\";onKey=null;
 const id=\"11111111-1111-1111-1111-111111111111\";
 const w={id,vendor:\"claude\",family:\"claude\",cwd:\"/work\",runDir:root+\"/\"+id,transcript:\"/h/transcript.jsonl\",session:\"session1\",surface_ref:\"surface:2\",surface_id:\"id2\",pane_ref:\"pane:2\",workspace:ctx.workspace,orchestratorPane:ctx.pane,status:\"running\",openedAt:clock-1000,lastActivityAt:clock-1000,completed:0,turnComplete:0,eventStart:0,baseline:[],...settings};
 memory.set(w.transcript,jsonl(entries));memory.set(eventPath,jsonl(events));memory.set(root+\"/\"+id+\".json\",JSON.stringify(w));return w;
}
const start=t=>({type:\"user\",timestamp:stamp(t),message:{content:\"task\"}});
const end=t=>({type:\"assistant\",timestamp:stamp(t),message:{stop_reason:\"end_turn\",content:[{type:\"text\",text:\"done\"}]}});
const tool=(id,t)=>({type:\"assistant\",timestamp:stamp(t),message:{content:[{type:\"tool_use\",id,name:\"Bash\",input:{command:\"command \"+id}}]}});
const result=(id,t)=>({type:\"user\",timestamp:stamp(t),message:{content:[{type:\"tool_result\",tool_use_id:id,content:\"finished\"}]}});
const permission=(t,id)=>({name:\"agent.hook.PermissionRequest\",surface_id:\"id2\",occurred_at:stamp(t),payload:{...(id?{tool_use_id:id}:{})}});

const w=fixture([start(clock-2000),end(clock-1000)]);
output=\"The requested work is complete.\\n\\nWould you like to proceed?\\n\\n❯ \";
console.log(\"completed_question_wait\",mod.refresh(w,true,runtime));
try{await mod.sendWorker(w.id,\"Yes, continue\",ctx,runtime);console.log(\"unexpected success\");}catch(e){console.log(\"completed_question_send\",e.message,\"exit\",e.exitCode,\"keys\",calls.filter(a=>a.includes(\"send-key\")).length);}

const p=fixture([start(clock-720000),tool(\"old\",clock-700000),tool(\"new\",clock-5000)],[permission(clock-4000,\"new\")]);
output=\"Do you want to create secret.txt?\\n1. Yes\\n2. No\";
console.log(\"unknown_dialog\",mod.approvalDialog(p,output),\"wait\",mod.refresh(p,true,runtime));
onKey=()=>{throw new Error(\"ENTER REACHED PERMISSION DIALOG\");};
try{await mod.sendWorker(p.id,\"Do not approve anything\",ctx,runtime);}catch(e){console.log(\"unsupported_permission_send\",e.message,\"keys\",calls.filter(a=>a.includes(\"send-key\")).length);}
