/bin/zsh -lc "node --input-type=module -e 'import fs from \"node:fs\"; import path from \"node:path\";
const root=path.join(process.env.HOME,\".claude\",\"projects\");
const stats={files:0,assistant:0,reasons:{},endsWithNull:0,endsWithEndTurn:0,otherLast:{}};
const files=fs.readdirSync(root,{withFileTypes:true}).filter(e=>e.isDirectory()).flatMap(e=>fs.readdirSync(path.join(root,e.name)).filter(f=>f.endsWith(\".jsonl\")).map(f=>path.join(root,e.name,f))).map(f=>({f,m:fs.statSync(f).mtimeMs})).sort((a,b)=>b.m-a.m).slice(0,25);
for(const {f} of files){let last;for(const line of fs.readFileSync(f,\"utf8\").split(\"\\n\")){let e;try{e=JSON.parse(line)}catch{continue}if(e.type===\"assistant\"){last=e;stats.assistant++;const reason=e.message?.stop_reason??\"<null>\";stats.reasons[reason]=(stats.reasons[reason]||0)+1;}}if(last){stats.files++;const reason=last.message?.stop_reason??\"<null>\";if(reason===\"<null>\")stats.endsWithNull++;else if(reason===\"end_turn\")stats.endsWithEndTurn++;else stats.otherLast[reason]=(stats.otherLast[reason]||0)+1;}}
console.log(stats);'" in /Users/cortega/Documents/Projects/personal/agent-config-studio-wt/agent-config-studio-agent-command
