function approvalDialog(w, output) {
  const clean = cleanScreen(output);
  const trust = trustDialog(w.vendor, clean);
  if (trust) return { kind: 'trust', prompt: trust };
  const rows = clean.split('\n');
  const index = rows.findIndex(row => /^\s*[│╭─ ]*(?:(?:Allow|Approve)\b.*\?|Do you want to (?:proceed|allow|run)\b.*\?|Would you like to (?:run|allow|proceed)\b.*\?|Permission (?:required|request))/i.test(row));
  return index < 0 ? null : { kind: 'permission', prompt: rows.slice(index).join('\n').trim() };

