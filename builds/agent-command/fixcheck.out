  readdirSync(folder, options) { return [...memory.keys()].filter(f=>pathReal.dirname(f)===folder).map(f=>options?.withFileTypes?{name:pathReal.basename(f),isFile:()=>true,isDirectory:()=>false}:pathReal.basename(f)); },
  statSync(f) { const value = file(f); return {size:Buffer.byteLength(value),mtimeMs:clock-1000,isDirectory:()=>false}; },
  existsSync:f=>memory.has(f), mkdirSync(){},rmdirSync(){},realpathSync:p=>p,
  writeFileSync(f,v){memory.set(f,String(v));},renameSync(a,b){memory.set(b,file(a));memory.delete(a);},rmSync(f){memory.delete(f);}
