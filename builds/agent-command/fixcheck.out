   144	      assert.equal(refused.status,3,refused.stderr); assert.match(refused.stderr,/stuck/);
   145	      assert.equal(inputCalls(w).length,0,'CLI refusal also sends nothing');
   146	      const saved=record(w); saved.status='closed'; fs.writeFileSync(path.join(records,`${w.id}.json`),JSON.stringify(saved));
   147	    }
   148	    for (const [flag, expectedKeys] of [['FAKE_PERMISSION_ON_SEND',0], ['FAKE_PERMISSION_AFTER_ENTER',1]]) {
