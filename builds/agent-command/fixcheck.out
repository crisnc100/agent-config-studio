 memory.clear();calls.length=0;output=\"Worker screen\";onKey=null;
 const id=\"11111111-1111-1111-1111-111111111111\";
 const w={id,vendor:\"claude\",family:\"claude\",cwd:\"/work\",runDir:root+\"/\"+id,transcript:\"/h/transcript.jsonl\",session:\"session1\",surface_ref:\"surface:2\",surface_id:\"id2\",pane_ref:\"pane:2\",workspace:ctx.workspace,orchestratorPane:ctx.pane,status:\"running\",openedAt:clock-1000,lastActivityAt:clock-1000,completed:0,turnComplete:0,eventStart:0,baseline:[],...settings};
 memory.set(w.transcript,jsonl(entries));memory.set(eventPath,jsonl(events));memory.set(root+\"/\"+id+\".json\",JSON.stringify(w));return w;
}
const start=t=>({type:\"user\",timestamp:stamp(t),message:{content:\"task\"}});
const end=t=>({type:\"assistant\",timestamp:stamp(t),message:{stop_reason:\"end_turn\",content:[{type:\"text\",text:\"done\"}]}});
const tool=(id,t)=>({type:\"assistant\",timestamp:stamp(t),message:{content:[{type:\"tool_use\",id,name:\"Bash\",input:{command:\"command \"+id}}]}});
const result=(id,t)=>({type:\"user\",timestamp:stamp(t),message:{content:[{type:\"tool_result\",tool_use_id:id,content:\"finished\"}]}});
