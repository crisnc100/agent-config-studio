   558	    const deadline = attempt === 3 ? end : Math.min(end, now() + 1200);
   559	    do {
   560	      assertSendable(w, runtime);
   561	      if (w.pendingSend.confirmedAt) {
   562	        save(w);
   563	        return { id, status: 'running', state: 'running' };
   564	      }
   565	      if (now() >= deadline) break;
   566	      await pause(Math.min(100, deadline - now()));
   567	    } while (true);
   568	  }
   569	  w.status = 'unsent';
   570	  save(w);
   571	  throw new Error('could not verify message submission within 10s after four Enter presses; agent wait will report unsent');
   572	}
   573	
   574	export async function sendWorker(id, message, ctx, runtime = {}) {
   575	  while (true) {
   576	    const sent = await openLock(async () => {
   577	      const w = worker(id, ctx);
   578	      if (w.status === 'closed') throw bad('worker is closed');
