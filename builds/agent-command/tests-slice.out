#!/usr/bin/env node
import { context, openWorker, waitWorker, sendWorker, answerWorker, closeWorker, listWorkers } from '../lib/agent.js';
const usage = 'usage: agent open <family> [--effort e] [--cwd d] [--role r] [--mcp] (--prompt-file f | "task") [--json]\n       agent wait <id> [--timeout seconds] [--stall-after seconds] [--command-after seconds] [--json]\n       agent send <id> "text" | answer <id> | close <id> | list [--json]';
const argv = process.argv.slice(2);
async function main() {
  if (argv.includes('--help') || argv.includes('-h')) { console.log(usage); return 0; }
  const json = argv.includes('--json');
  const args = argv.filter(a => a !== '--json');
  const cmd = args.shift();
  const opts = {}, pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i].startsWith('--')) {
      const flag = args[i];
      if (cmd === 'open' && flag === '--mcp') { opts.mcp = true; continue; }
      const allowed = cmd === 'open' ? ['--effort', '--cwd', '--role', '--prompt-file'] : cmd === 'wait' ? ['--timeout', '--stall-after', '--command-after'] : [];
      if (!allowed.includes(flag) || args[i + 1] === undefined) throw Object.assign(new Error(usage), { exitCode: 2 });
      opts[flag === '--prompt-file' ? 'promptFile' : flag.slice(2)] = args[++i];
    } else pos.push(args[i]);
  }
  const ctx = context();
  if (cmd === 'open' && (pos.length === 2 && !opts.promptFile || pos.length === 1 && opts.promptFile)) {
    const w = await openWorker(pos[0], { ...opts, prompt: pos[1] }, ctx);
    console.log(json ? JSON.stringify(w) : w.id); return 0;
  }
  if (cmd === 'wait' && pos.length === 1) {
    const timeout = opts.timeout === undefined ? 600 : Number(opts.timeout);
    if (!Number.isFinite(timeout) || timeout < 0) throw Object.assign(new Error('invalid timeout'), { exitCode: 2 });
    const stallAfter = opts['stall-after'] === undefined ? 300 : Number(opts['stall-after']);
    if (!Number.isFinite(stallAfter) || stallAfter < 0) throw Object.assign(new Error('invalid stall-after'), { exitCode: 2 });
    const commandAfter = opts['command-after'] === undefined ? 600 : Number(opts['command-after']);
    if (!Number.isFinite(commandAfter) || commandAfter < 0) throw Object.assign(new Error('invalid command-after'), { exitCode: 2 });
    const r = await waitWorker(pos[0], timeout, ctx, { stallAfter, commandAfter });
    const details = r.prompt || r.input || r.text || r.command || r.steps?.join('\n');
    console.log(json ? JSON.stringify(r) : r.state + (details ? `\n${details}` : ''));
    return { done: 0, stuck: 3, timeout: 4, unsent: 5, no_start: 6, stalled: 7, closed: 8, long_command: 9 }[r.state];
  }
  if (cmd === 'send' && pos.length === 2) {
    const r = await sendWorker(pos[0], pos[1], ctx);
    console.log(json ? JSON.stringify(r) : 'sent'); return 0;
  }
  if (cmd === 'answer' && pos.length === 1) {
    const answer = answerWorker(pos[0], ctx);
    process.stdout.write(json ? JSON.stringify({ id: pos[0], answer }) + '\n' : answer); return 0;
  }
  if (cmd === 'close' && pos.length === 1) {
    const w = closeWorker(pos[0], ctx);
    console.log(json ? JSON.stringify(w) : 'closed'); return 0;
  }
  if (cmd === 'list' && !pos.length) {
    const workers = listWorkers(ctx);
    console.log(json ? JSON.stringify(workers) : workers.map(w => `${w.id} ${w.family} ${w.status}`).join('\n')); return 0;
  }
  throw Object.assign(new Error(usage), { exitCode: 2 });
}
try { process.exitCode = await main(); }
catch (e) { process.stderr.write(`${e.message}\n`); process.exitCode = e.exitCode || 1; }
name: CI

# A bare `push:` fires on every branch, and the pull_request event fires on the
# same commit — every check ran twice for no extra signal. Branch work is covered
# by its PR; main is covered on merge.
on:
  push:
    branches: [main]
  pull_request:

# A new push to a PR cancels that PR's run still in progress. A push to main
# gets a group of its own (its sha), so a run on main is never cancelled or
# left pending behind another.
concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.sha }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

# The test files each job runs, and their order, are in tests/SUITE;
# `node tests/run.mjs <group>` runs one group and fails on a group with no files.
jobs:
  syntax:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: node --check
        run: |
          set -euo pipefail
          node --check server.js
          # node --check reads only its first file (the rest become script
          # arguments), so each file gets its own run; xargs exits non-zero if
          # any run does. An empty match would pass vacuously, so it fails.
          src=(lib tests public bin packs tools)
          n=$(find "${src[@]}" \( -name '*.js' -o -name '*.mjs' \) | wc -l)
          if [ "$n" -eq 0 ]; then echo "no .js or .mjs file under ${src[*]}" >&2; exit 1; fi
          find "${src[@]}" \( -name '*.js' -o -name '*.mjs' \) -print0 | xargs -0 -n 1 node --check
          echo "node --check: server.js and $n files"
      # Once per run: a job summary shows on the run's page whichever job
      # failed, and always() writes it when this job fails too.
      - name: live containment is a local gate
        if: always()
        run: |
          {
            echo '> [!WARNING]'
            echo '> Live containment checks are a **local** gate (./verify.sh) and were not run here.'
            echo '> A green CI tick is not a containment pass.'
          } >> "$GITHUB_STEP_SUMMARY"

  offline:
    # The declared minimum Node (package.json engines: >=20), pinned exactly:
    # a feature newer than 20.0 fails here, not on a stranger's machine.
    # Current Node is covered on the Mac (stranger-macos). Branch protection
    # requires a check named exactly `offline`.
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          # On a PR the checkout is GitHub's merge commit, whose first parent
          # is the base branch's tip: HEAD^1..HEAD is exactly what the PR
          # changes, which the packs step below is decided on.
          fetch-depth: 2
      - uses: actions/setup-node@v4
        with:
          node-version: '20.0.0'
      - name: shells the launcher must work under
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq dash zsh
      - name: offline suite
        env:
          ACS_SUITE: offline
        # --jobs 4: one file per core of the Linux runner. The files mostly
        # wait on servers and children, but some assert wall-clock deadlines,
        # so more files than cores risks a false red on the required check.
        # Files marked serial in tests/SUITE run alone first, while the
        # runner is quiet.
        run: |
          set -euo pipefail
          node --version
          nproc
          node tests/run.mjs offline --jobs 4
      # The pack tests add minutes, so they run only when a PR changes
      # packs/, and on every push to main. Anything short of a clean
      # "packs/ unchanged" answer runs them: a skip must be proven.
      # These three steps run even when the offline suite failed, so one red
      # step does not hide whether the pack tests pass.
