          "quote": "const env = { ...process.env, HOME: home, PATH: `${bin}:${process.env.PATH}`, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: 'workspace:1' };"
        }
      ]
    },
    {
      "issue": "The cmux-only guard checks only the first literal prefix, rather than the complete executable argument. Replacing the production call with spawnSync('cmux' + process.env.AGENT_SUFFIX, ...) left every static guard passing in an in-memory mutation check. The argument is computed and can name another executable, contradicting the property this new exemption must enforce.",
      "file": "tests/guards.mjs",
      "line": "397",
      "quote": "        if (cal.kind !== 'literal' || cal.value !== 'cmux') {",
      "suggestion": "Require the entire first argument to be exactly the cmux literal, and add a mutation case containing a literal followed by an expression.",
      "likelihood": 2,
      "impact": 7,
      "protected": false,
      "trigger": "A source change computes the executable from a 'cmux' prefix, then verification runs the subprocess guard.",
      "preExisting": false,
      "instances": null
    },
    {
      "issue": "The import scanner requires whitespace after import and before from, missing valid named-import syntax such as import{openWorker}from './lib/agent.js';. Adding that statement to server.js in memory passed every static guard; Node's module syntax checker also accepted it. The server can therefore import the worker module without this isolation check detecting the dependency.",
      "file": "tests/guards.mjs",
      "line": "1063",
      "quote": "      /(?:^|[;\\n])\\s*import\\s+(?:[^'\";]*?\\s+from\\s*)?(['\"])([^'\"]+)\\1/g,",
      "suggestion": "Recognize valid named-import token boundaries without requiring whitespace, and cover a compact named import in setup-guards.mjs.",
      "likelihood": 2,
      "impact": 7,
      "protected": false,
      "trigger": "A server module imports the worker using compact named-import syntax and the import-graph guard runs.",
      "preExisting": false,
      "instances": null
    },
    {
      "issue": "The symlink regression assertion rejects only the logical .git/logs path. An implementation that follows the symlink and grants its resolved fakeLogs target passes this assertion, despite widening access outside Git metadata. I evaluated the exact assertion with an argv containing that unrelated directory and it passed. The earlier exact-grant assertion runs before the symlink exists, so it does not cover this failure.",
      "file": "tests/agent-git-access.mjs",
      "line": "53",
      "quote": "try { assert.ok(!grants(argv(linked)).includes(path.join(common,'logs')),'symlinked commit directories cannot widen the grant'); }",
      "suggestion": "Assert the complete expected grant list for the symlinked fixture, excluding both the logical logs path and its resolved target.",
      "likelihood": 2,
      "impact": 7,
      "protected": false,
      "trigger": "The launcher grants a symlink's physical target instead of rejecting it, and the symlink regression case runs.",
      "preExisting": false,
      "instances": null
    }
  ]
}
