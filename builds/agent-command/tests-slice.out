+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawn, spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-'));
+const fake = path.join(home, 'bin');
+fs.mkdirSync(fake);
+const caffeineLog = path.join(home, 'caffeinate-calls');
+fs.writeFileSync(path.join(fake, 'caffeinate'), `#!${process.execPath}\nrequire('node:fs').appendFileSync(${JSON.stringify(caffeineLog)},JSON.stringify(process.argv.slice(2))+'\\n');\n`, { mode: 0o755 });
+fs.writeFileSync(path.join(fake, 'cmux'), `#!${process.execPath}\nimport ${JSON.stringify(path.join(root, 'tests/fixtures/agent-cmux.mjs'))};\n`, { mode: 0o755 });
+const env = { ...process.env, HOME: home, PATH: `${fake}:${process.env.PATH}`, CMUX_SOCKET_PATH: path.join(home, 'socket'), CMUX_WORKSPACE_ID: 'workspace:1', CMUX_SURFACE_ID: 'surface:1' };
+const run = (args, extra = {}) => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: { ...env, ...extra }, encoding: 'utf8' });
+const json = r => { assert.equal(r.status, 0, r.stderr); return JSON.parse(r.stdout); };
+const state = () => JSON.parse(fs.readFileSync(path.join(home, 'fake-cmux.json'), 'utf8'));
+const records = () => fs.readdirSync(path.join(home, '.agent-config-studio/agents')).filter(f => f.endsWith('.json')).map(f => JSON.parse(fs.readFileSync(path.join(home, '.agent-config-studio/agents', f))));
+const open = (family, extra = [], vars = {}) => json(run(['open', family, '--cwd', home, '--json', ...extra], vars));
+assert.equal(run(['list'], { CMUX_SOCKET_PATH: '' }).status, 2);
+assert.match(run(['list'], { FAKE_OFFLINE: '1' }).stderr, /agent needs cmux/);
+const prompt = path.join(home, 'long prompt.txt');
+fs.writeFileSync(prompt, 'a'.repeat(47000) + '\n$(touch NEVER) `literal` \' "');
+const codex = open('sol', ['--effort', 'high', '--prompt-file', prompt]);
+assert.ok(codex.id);
+const c = records().find(r => r.id === codex.id);
+assert.equal(c.vendor, 'codex');
+const launch = fs.readFileSync(c.launcher, 'utf8');
+assert.match(launch, /'-s' 'workspace-write' '-a' 'never'/);
+assert.match(launch, /model_reasoning_effort=high/);
+assert.ok(!launch.includes('a'.repeat(100)));
+assert.equal(fs.readFileSync(c.promptFile, 'utf8'), fs.readFileSync(prompt, 'utf8'));
+assert.ok(!state().calls.some(a => a.includes('send')));
+assert.equal(json(run(['wait', c.id, '--timeout', '0', '--json'])).status, 'done');
+const claude = open('opus', ['task']);
+const grok = open('grok', ['task']);
+for (const w of [claude, grok]) assert.equal(json(run(['wait', w.id, '--timeout', '0', '--json'])).status, 'done');
+assert.equal(state().calls.filter(a => a.includes('new-pane')).length, 2);
+assert.ok(state().calls.some(a => a.includes('new-surface') && a.includes('pane:11')));
+assert.ok(state().calls.some(a => a.includes('focus-pane') && a.includes('pane:1')));
+const running = open('sol', ['task'], { FAKE_RUNNING: '1' });
+assert.equal(run(['wait', running.id, '--timeout', '0']).status, 4);
+const r = records().find(r => r.id === running.id);
+fs.appendFileSync(path.join(home, '.cmuxterm/events.jsonl'), JSON.stringify({ name: 'agent.hook.PermissionRequest', surface_id: r.surface_id }) + '\n');
+const stuck = run(['wait', r.id, '--timeout', '0', '--json']);
+assert.equal(stuck.status, 3, stuck.stderr);
+assert.match(JSON.parse(stuck.stdout).prompt, /Allow this command/);
+console.log('agent core/open/wait passed');
+for (const w of [codex, claude, grok]) {
+  assert.equal(run(['answer', w.id]).stdout, 'exact\nanswer  ');
+  const sent = json(run(['send', w.id, 'follow up', '--json']));
+  assert.equal(sent.status, 'running');
+  assert.equal(json(run(['wait', w.id, '--timeout', '0', '--json'])).status, 'done');
+  assert.equal(run(['answer', w.id]).stdout, 'exact\nanswer  ');
+  const keys = state().calls.filter(a => a.includes('send-key') && a.includes(w.surface_ref));
+  assert.equal(keys.length, 2);
+}
+const noSubmit = run(['send', codex.id, 'never submitted'], { FAKE_NO_SUBMIT: '1' });
+assert.equal(noSubmit.status, 1);
+assert.match(noSubmit.stderr, /submission/);
+assert.equal(state().calls.filter(a => a.includes('send-key') && a.includes(codex.surface_ref)).length, 6);
+const listed = json(run(['list', '--json']));
+assert.equal(listed.length, 4);
+assert.equal(json(run(['list', '--json'], { FAKE_PANE: 'pane:99' })).length, 0);
+assert.equal(run(['send', codex.id, 'wrong owner'], { FAKE_PANE: 'pane:99' }).status, 2);
+json(run(['close', codex.id, '--json']));
+assert.ok(state().calls.some(a => a.includes('close-surface') && a.includes('--force') && a.includes(codex.surface_ref)));
+assert.equal(records().find(r => r.id === codex.id).status, 'closed');
+assert.equal(run(['send', codex.id, 'closed']).status, 2);
+const idle = records().find(r => r.id === claude.id);
+idle.lastActivityAt = Date.now() - 31 * 60000;
+idle.finishedAt = idle.lastActivityAt;
+fs.writeFileSync(path.join(home, '.agent-config-studio/agents', `${idle.id}.json`), JSON.stringify(idle));
+assert.equal(json(run(['list', '--json'])).find(w => w.id === idle.id).status, 'closed');
+assert.ok(fs.existsSync(idle.transcript));
+console.log('agent send/answer/close/list passed');
+// A different rollout in the same cwd must not complete a pinned worker.
+const isolated = open('sol', ['isolation task'], { FAKE_RUNNING: '1' });
+assert.equal(run(['wait', isolated.id, '--timeout', '0']).status, 4);
+const other = open('sol', ['another task']);
+assert.equal(run(['wait', isolated.id, '--timeout', '0']).status, 4);
+assert.equal(json(run(['wait', other.id, '--timeout', '0', '--json'])).status, 'done');
+const iso = records().find(w => w.id === isolated.id);
+fs.appendFileSync(iso.transcript, '{"type":');
+assert.equal(run(['wait', isolated.id, '--timeout', '0']).status, 4);
+for (const args of [['open', 'no-such-family', 'task'], ['open', 'sol', '--effort', 'bogus', 'task'], ['open', 'sol', '--prompt-file', prompt, 'also task'], ['wait', other.id, '--timeout', '-1'], ['answer', '../escape'], ['send', other.id], ['list', '--unknown']]) assert.equal(run(args).status, 2, JSON.stringify(args));
+const doneRecord = records().find(w => w.id === other.id);
+fs.appendFileSync(path.join(home, '.cmuxterm/events.jsonl'), JSON.stringify({ name: 'agent.hook.Notification', surface_id: doneRecord.surface_id, occurred_at: new Date(doneRecord.finishedAt + 60000).toISOString() }) + '\n');
+assert.equal(json(run(['wait', other.id, '--timeout', '0', '--json'])).status, 'done');
+const fallback = open('grok', ['screen fallback']);
+const fallbackRecord = records().find(w => w.id === fallback.id);
+fs.rmSync(path.join(path.dirname(fallbackRecord.transcript), 'chat_history.jsonl'));
+assert.equal(run(['answer', fallback.id]).stdout, 'Allow this command?\n1. Yes');
+// A running worker is never closed just because its launch was long ago.
+const active = records().find(w => w.id === isolated.id);
+active.lastActivityAt = Date.now() - 31 * 60000;
+fs.writeFileSync(path.join(home, '.agent-config-studio/agents', `${active.id}.json`), JSON.stringify(active));
+assert.equal(json(run(['list', '--json'])).find(w => w.id === active.id).status, 'running');
+const waitingIdle = records().find(w => w.id === other.id);
+waitingIdle.lastActivityAt = Date.now() - 31 * 60000;
+fs.writeFileSync(path.join(home, '.agent-config-studio/agents', `${waitingIdle.id}.json`), JSON.stringify(waitingIdle));
+const idleWait = run(['wait', waitingIdle.id, '--timeout', '0', '--json']);
+assert.equal(idleWait.status, 8, idleWait.stderr);
+assert.equal(JSON.parse(idleWait.stdout).closed, true);
+assert.equal(JSON.parse(idleWait.stdout).state, 'closed');
+console.log('agent isolation/edge cases passed');
+const captured = path.join(home, 'captured-argv.json');
+fs.writeFileSync(path.join(fake, 'codex'), `#!${process.execPath}\nrequire('node:fs').writeFileSync(${JSON.stringify(captured)}, JSON.stringify({args:process.argv.slice(2),cwd:process.cwd()}));\n`, { mode: 0o755 });
+const shell = spawnSync('/bin/sh', [c.launcher], { env, encoding: 'utf8' });
+assert.equal(shell.status, 0, shell.stderr);
+const capture = JSON.parse(fs.readFileSync(captured));
+assert.equal(capture.args.at(-1), fs.readFileSync(prompt, 'utf8'));
+assert.equal(capture.cwd, home);
+assert.ok(!fs.existsSync(path.join(home, 'NEVER')));
+const beforeTen = state().calls.filter(a => a.includes('new-pane')).length;
+const ten = Array.from({ length: 10 }, (_, i) => open('sol', [`worker ${i}`]));
+assert.equal(state().calls.filter(a => a.includes('new-pane')).length, beforeTen);
+for (const w of ten) assert.equal(json(run(['wait', w.id, '--timeout', '0', '--json'])).status, 'done');
+assert.equal(new Set(ten.map(w => w.surface_ref)).size, 10);
+console.log('agent safe launcher and ten workers passed');
+const queueHome = path.join(home, 'queue');
+fs.mkdirSync(queueHome);
+const queueEnv = { ...env, HOME: queueHome, FAKE_RUNNING: '1' };
+const queueRun = (...args) => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: queueEnv, encoding: 'utf8' });
+const four = Array.from({ length: 4 }, () => json(queueRun('open', 'sol', '--cwd', queueHome, 'queue task', '--json')));
+const pending = spawn(process.execPath, [path.join(root, 'bin/agent.mjs'), 'open', 'sol', '--cwd', queueHome, 'fifth task', '--json'], { env: queueEnv, stdio: ['ignore', 'pipe', 'pipe'] });
+let pendingOut = '', pendingErr = '';
+pending.stdout.on('data', s => pendingOut += s);
+pending.stderr.on('data', s => pendingErr += s);
+const exit = new Promise(resolve => pending.on('exit', resolve));
+await new Promise(resolve => setTimeout(resolve, 700));
+assert.equal(pending.exitCode, null);
+assert.equal(JSON.parse(fs.readFileSync(path.join(queueHome, 'fake-cmux.json'))).n, 4);
+const firstWorker = JSON.parse(fs.readFileSync(path.join(queueHome, 'fake-cmux.json'))).workers[four[0].surface_ref];
+fs.appendFileSync(firstWorker.transcript, JSON.stringify({ type: 'event_msg', payload: { type: 'task_complete', last_agent_message: 'free slot' } }) + '\n');
+const timer = setTimeout(() => pending.kill('SIGKILL'), 10000);
+assert.equal(await exit, 0, pendingErr);
+clearTimeout(timer);
+assert.ok(JSON.parse(pendingOut).id);
+assert.equal(JSON.parse(fs.readFileSync(path.join(queueHome, 'fake-cmux.json'))).n, 5);
+console.log('agent four-worker queue passed');
+const queuedSend = spawn(process.execPath, [path.join(root, 'bin/agent.mjs'), 'send', four[0].id, 'queued follow up', '--json'], { env: queueEnv, stdio: ['ignore', 'pipe', 'pipe'] });
+let sendErr = '';
+queuedSend.stderr.on('data', s => sendErr += s);
+const sendExit = new Promise(resolve => queuedSend.on('exit', resolve));
+await new Promise(resolve => setTimeout(resolve, 700));
+assert.equal(queuedSend.exitCode, null);
+const anotherWorker = JSON.parse(fs.readFileSync(path.join(queueHome, 'fake-cmux.json'))).workers[four[1].surface_ref];
+fs.appendFileSync(anotherWorker.transcript, JSON.stringify({ type: 'event_msg', payload: { type: 'task_complete', last_agent_message: 'free another slot' } }) + '\n');
+const sendTimer = setTimeout(() => queuedSend.kill('SIGKILL'), 10000);
+assert.equal(await sendExit, 0, sendErr);
+clearTimeout(sendTimer);
+console.log('agent follow-up queue passed');
+const claudeDefault = open('opus', ['MCP default']);
+const claudeOptIn = open('opus', ['--mcp', 'MCP opt in']);
+const codexOptIn = open('sol', ['--mcp', 'MCP opt in']);
+const grokOptIn = open('grok', ['--mcp', 'MCP opt in']);
+const scriptOf = w => fs.readFileSync(w.launcher, 'utf8');
+assert.match(scriptOf(claudeDefault), /'--strict-mcp-config'/);
+assert.ok(!scriptOf(claudeDefault).includes('--mcp-config'));
+assert.ok(!scriptOf(claudeOptIn).includes('--strict-mcp-config'));
+for (const w of [codexOptIn, grokOptIn]) assert.ok(!scriptOf(w).includes('--strict-mcp-config'));
+assert.ok(!scriptOf(codexOptIn).includes('orchestrator.mcp.enabled'));
+assert.equal(claudeDefault.mcp, false);
+assert.equal(claudeOptIn.mcp, true);
+const gitRoot = path.join(home, 'git fixture');
+fs.mkdirSync(gitRoot);
+const gitInit = spawnSync('git', ['init', gitRoot], { encoding: 'utf8' });
+assert.equal(gitInit.status, 0, gitInit.stderr);
+const linked = path.join(home, "linked ' worktree");
+fs.mkdirSync(linked);
+fs.mkdirSync(path.join(gitRoot, '.git/logs'));
+const admin = path.join(gitRoot, '.git/worktrees/linked');
+fs.mkdirSync(admin, { recursive: true });
+fs.writeFileSync(path.join(admin, 'commondir'), '../..\n');
+fs.writeFileSync(path.join(admin, 'HEAD'), 'ref: refs/heads/fixture\n');
+fs.writeFileSync(path.join(admin, 'gitdir'), path.join(linked, '.git') + '\n');
+fs.writeFileSync(path.join(linked, '.git'), `gitdir: ${admin}\n`);
+const linkedWorker = open('sol', ['--cwd', linked, 'git shared dir']);
+const linkedLaunch = spawnSync('/bin/sh', [linkedWorker.launcher], { env, encoding: 'utf8' });
+assert.equal(linkedLaunch.status, 0, linkedLaunch.stderr);
+const linkedArgs = JSON.parse(fs.readFileSync(captured)).args;
+assert.deepEqual(linkedArgs.flatMap((arg, i) => arg === '--add-dir' ? [linkedArgs[i + 1]] : []), ['objects', 'refs', 'logs'].map(name => path.join(gitRoot, '.git', name)).concat(admin));
+assert.ok(!linkedArgs.includes(path.join(gitRoot, '.git')), 'the common root is never writable');
+const normalWorker = open('sol', ['--cwd', gitRoot, 'normal repository']);
+assert.equal(spawnSync('/bin/sh', [normalWorker.launcher], { env, encoding: 'utf8' }).status, 0);
+assert.ok(!JSON.parse(fs.readFileSync(captured)).args.includes('--add-dir'));
+console.log('agent MCP argv and shared Git metadata passed');
+for (const cli of ['claude', 'grok']) fs.writeFileSync(path.join(fake, cli), fs.readFileSync(path.join(fake, 'codex')), { mode: 0o755 });
+const argvOf = w => {
+  const result = spawnSync('/bin/sh', [w.launcher], { env, encoding: 'utf8' });
+  assert.equal(result.status, 0, result.stderr);
+  return JSON.parse(fs.readFileSync(captured)).args;
+};
+const defaultClaudeArgs = argvOf(claudeDefault);
+assert.deepEqual(defaultClaudeArgs, ['--model', claudeDefault.model, '--permission-mode', 'auto', '--strict-mcp-config', '--', 'MCP default']);
+assert.deepEqual(argvOf(claudeOptIn), ['--model', claudeOptIn.model, '--permission-mode', 'auto', '--', 'MCP opt in']);
+assert.deepEqual(argvOf(codexOptIn), ['-m', codexOptIn.model, '-s', 'workspace-write', '-a', 'never', '--', 'MCP opt in']);
+assert.deepEqual(argvOf(grokOptIn), ['-m', grokOptIn.model, '--always-approve', '--', 'MCP opt in']);
+assert.deepEqual(argvOf(grok), ['-m', grok.model, '--always-approve', '--', 'task']);
+console.log('agent all harness launcher argv passed');
+
+const caffeineDeadline = Date.now() + 5000;
+while ((!fs.existsSync(caffeineLog) || fs.readFileSync(caffeineLog, 'utf8').trim().split('\n').length < 8) && Date.now() < caffeineDeadline) await new Promise(resolve => setTimeout(resolve, 50));
+const caffeineCalls = fs.readFileSync(caffeineLog, 'utf8').trim().split('\n').map(JSON.parse);
+assert.equal(caffeineCalls.length, 8);
+for (const args of caffeineCalls) { assert.deepEqual(args.slice(0, 2), ['-i', '-w']); assert.match(args[2], /^[1-9]\d*$/); }
+const pid = fs.readFileSync(c.pidFile, 'utf8').trim();
+assert.ok(caffeineCalls.some(args => args[2] === pid));
+assert.equal(caffeineCalls.filter(args => args[2] === pid).length, 1);
+for (const w of [c, linkedWorker, normalWorker, claudeDefault, claudeOptIn, codexOptIn, grokOptIn, grok]) {
+  const target = fs.readFileSync(w.pidFile, 'utf8').trim();
+  assert.equal(caffeineCalls.filter(args => args[2] === target).length, 1);
+}
+console.log('agent caffeinate targets launcher PID once per process');
+
+const rigWorker = open('sol', ['rig hook'], { AGENT_TEST_MODE: '1', AGENT_TEST_LAUNCH_EXTRA: '["--no-alt-screen"]', AGENT_TEST_BINARY: path.join(home, 'missing-harness') });
+assert.match(scriptOf(rigWorker), /'--no-alt-screen'/);
+assert.ok(scriptOf(rigWorker).includes(`exec '${path.join(home, 'missing-harness')}'`));
+const missing = spawnSync('/bin/sh', [rigWorker.launcher], { env, encoding: 'utf8' });
+assert.equal(fs.existsSync(path.join(home, 'missing-harness')), false);
+assert.ok([126, 127].includes(missing.status), missing.stderr);
+assert.match(missing.stderr, /missing-harness/);
+const ignoredHook = open('sol', ['ignored hook'], { AGENT_TEST_MODE: '0', AGENT_TEST_LAUNCH_EXTRA: '["--no-alt-screen"]', AGENT_TEST_BINARY: path.join(home, 'missing-harness') });
+assert.ok(!scriptOf(ignoredHook).includes('--no-alt-screen'));
+assert.ok(!scriptOf(ignoredHook).includes('missing-harness'));
+json(run(['close', rigWorker.id, '--json']));
+console.log('agent fault-rig launch overrides require explicit test mode');
diff --git a/tests/agent-commands.mjs b/tests/agent-commands.mjs
new file mode 100644
index 0000000..4f034ae
--- /dev/null
+++ b/tests/agent-commands.mjs
@@ -0,0 +1,116 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-commands-'));
+process.env.HOME = home;
+const bin = path.join(home, 'bin'); fs.mkdirSync(bin);
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nconsole.log(JSON.stringify(process.argv.includes('identify')?{caller:{workspace_ref:'workspace:1',pane_ref:'pane:1'}}:{text:process.env.FAKE_SCREEN||'Working (30s • esc to interrupt)'}));\n`, { mode: 0o755 });
+process.env.PATH = `${bin}:${process.env.PATH}`;
+const { waitWorker } = await import('../lib/agent.js');
+const ctx = { workspace: 'workspace:1', pane: 'pane:1' };
+const records = path.join(home, '.agent-config-studio/agents'); fs.mkdirSync(records, { recursive: true });
+const epoch = 1800000000000;
+let clock = epoch;
+const runtime = { now: () => clock, sleep: async ms => { clock += ms; }, stallAfter: 1, commandAfter: 30 };
+const timestamp = new Date(epoch).toISOString();
+const task = { type: 'event_msg', payload: { type: 'task_started' }, timestamp };
+const command = 'python3 -c "import time; time.sleep(600)"';
+const begin = (vendor, id = 'a', stamp = timestamp) => vendor === 'claude'
+  ? { type: 'assistant', timestamp: stamp, message: { content: [{ type: 'tool_use', id, name: 'Bash', input: { command } }] } }
+  : vendor === 'codex' ? { type: 'response_item', timestamp: stamp, payload: { type: 'function_call', name: 'exec_command', call_id: id, arguments: JSON.stringify({ cmd: command }) } }
+    : { type: 'assistant', timestamp: stamp, tool_calls: [{ id, name: 'shell', arguments: JSON.stringify({ command }) }], content: '' };
+const end = (vendor, id = 'a') => vendor === 'claude' ? { type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: id, content: 'finished', is_error: true }] } }
+  : vendor === 'codex' ? { type: 'response_item', payload: { type: 'function_call_output', call_id: id, output: 'finished' } }
+    : { type: 'tool_result', tool_call_id: id, content: 'finished' };
+const started = vendor => vendor === 'codex' ? task : vendor === 'claude' ? { type: 'user', message: { content: 'task' } } : { type: 'turn_started' };
+function worker(vendor, entries) {
+  const id = crypto.randomUUID(), runDir = path.join(records, id); fs.mkdirSync(runDir);
+  const transcript = path.join(runDir, 'events.jsonl');
+  fs.writeFileSync(transcript, [started(vendor), ...(vendor === 'grok' ? [] : entries)].map(e => JSON.stringify(e) + '\n').join(''));
+  const source = vendor === 'grok' ? path.join(runDir, 'chat_history.jsonl') : transcript;
+  if (vendor === 'grok') fs.writeFileSync(source, entries.map(e => JSON.stringify(e) + '\n').join(''));
+  fs.utimesSync(transcript, epoch / 1000, epoch / 1000);
+  const w = { id, vendor, cwd: runDir, runDir, transcript, session: id, surface_ref: `surface:${id}`, surface_id: id, workspace: ctx.workspace, orchestratorPane: ctx.pane, status: 'running', openedAt: epoch, lastActivityAt: epoch, completed: 0, turnComplete: 0, eventStart: 0, baseline: [] };
+  fs.writeFileSync(path.join(records, `${id}.json`), JSON.stringify(w));
+  return { ...w, source };
+}
+const append = (w, entry) => { fs.appendFileSync(w.source, JSON.stringify(entry) + '\n'); fs.utimesSync(w.source, clock / 1000, clock / 1000); };
+for (const vendor of ['claude', 'codex', 'grok']) {
+  clock = epoch;
+  process.env.FAKE_SCREEN = vendor === 'claude' ? '✻ Churning… (1s · esc to interrupt)' : vendor === 'grok' ? 'Thinking… 1s' : 'Working (1s • esc to interrupt)';
+  const w = worker(vendor, [begin(vendor)]);
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout');
+  clock += 29999;
+  process.env.FAKE_SCREEN = process.env.FAKE_SCREEN.replace('1s', '30s');
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout', 'open tool is not stalled at the thinking threshold');
+  clock++;
+  const long = await waitWorker(w.id, 0, ctx, runtime);
+  assert.equal(long.state, 'long_command', vendor); assert.equal(long.command, command);
+  append(w, end(vendor, 'different'));
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'long_command', 'only matching results close a call');
+  clock += 1000; append(w, { type: 'progress', content: 'still running' });
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'long_command', 'progress and output growth do not reset command age');
+  append(w, end(vendor));
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout', 'an error result also closes its call');
+  process.env.FAKE_SCREEN = 'No running indicator'; clock += 30000;
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'stalled', 'a quiet turn after the tool result can stall');
+  clock = epoch;
+  const parallel = worker(vendor, [begin(vendor, 'a'), begin(vendor, 'b', new Date(epoch + 5000).toISOString())]);
+  append(parallel, end(vendor, 'b')); clock += 30000;
+  assert.equal((await waitWorker(parallel.id, 0, ctx, runtime)).state, 'long_command', 'another tool result does not hide the oldest open call');
+  const younger = worker(vendor, [begin(vendor, 'a'), begin(vendor, 'b', new Date(epoch + 5000).toISOString()), end(vendor, 'a')]);
+  assert.equal((await waitWorker(younger.id, 0, ctx, runtime)).state, 'timeout', 'the remaining call keeps its own younger age');
+  clock += 5000;
+  assert.equal((await waitWorker(younger.id, 0, ctx, runtime)).state, 'long_command');
+  clock = epoch;
+  const anonymous = worker(vendor, [begin(vendor, null)]);
+  await waitWorker(anonymous.id, 0, ctx, runtime);
+  clock += 30000;
+  assert.equal((await waitWorker(anonymous.id, 0, ctx, runtime)).state, 'long_command', 'missing IDs do not hide an open tool');
+  append(anonymous, end(vendor, null));
+  assert.equal((await waitWorker(anonymous.id, 0, ctx, runtime)).state, 'timeout');
+}
+process.env.FAKE_SCREEN = 'No running indicator';
+for (const [call, output] of [
+  [{ type: 'response_item', timestamp, payload: { type: 'custom_tool_call', call_id: 'custom', name: 'apply_patch', input: 'patch text' } }, { type: 'response_item', payload: { type: 'custom_tool_call_output', call_id: 'custom', output: 'ok' } }],
+  [{ type: 'event_msg', timestamp, payload: { type: 'exec_command_begin', call_id: 'exec', command: ['sleep', '600'] } }, { type: 'event_msg', payload: { type: 'exec_command_end', call_id: 'exec', exit_code: 0 } }],
+]) {
+  clock = epoch + 30000;
+  const w = worker('codex', [call]);
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'long_command');
+  append(w, output);
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout');
+}
+clock = epoch;
+const observed = worker('claude', [begin('claude', 'undated', undefined)]);
+const undated = JSON.parse(fs.readFileSync(observed.source, 'utf8').trim().split('\n').at(-1)); delete undated.timestamp;
+fs.writeFileSync(observed.source, JSON.stringify(started('claude')) + '\n' + JSON.stringify(undated) + '\n');
+await waitWorker(observed.id, 0, ctx, runtime);
+clock += 30000;
+assert.equal((await waitWorker(observed.id, 0, ctx, runtime)).state, 'long_command', 'undated calls retain their first observation between waits');
+clock = epoch + 599999;
+const defaults = worker('codex', [begin('codex')]);
+assert.equal((await waitWorker(defaults.id, 0, ctx, { ...runtime, commandAfter: undefined })).state, 'timeout');
+clock++;
+assert.equal((await waitWorker(defaults.id, 0, ctx, { ...runtime, commandAfter: undefined })).state, 'long_command');
+clock = epoch; const screenTool = worker('grok', []);
+process.env.FAKE_SCREEN = `Running: ${command}`;
+assert.equal((await waitWorker(screenTool.id, 0, ctx, runtime)).state, 'timeout');
+clock += 30000;
+assert.equal((await waitWorker(screenTool.id, 0, ctx, runtime)).command, command, 'Grok falls back to an explicit running-command screen row');
+process.env.FAKE_SCREEN = 'Thinking… 30s';
+assert.equal((await waitWorker(screenTool.id, 0, ctx, runtime)).state, 'timeout');
+const cli = args => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: { ...process.env, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: ctx.workspace }, encoding: 'utf8' });
+const cliLong = worker('claude', [begin('claude', 'cli', new Date(Date.now() - 31000).toISOString())]);
+const result = cli(['wait', cliLong.id, '--timeout', '0', '--command-after', '30', '--json']);
+assert.equal(result.status, 9, result.stderr); assert.equal(JSON.parse(result.stdout).command, command);
+const plain = cli(['wait', cliLong.id, '--timeout', '0', '--command-after', '30']);
+assert.equal(plain.status, 9); assert.match(plain.stdout, /^long_command\npython3/);
+for (const invalid of ['-1', 'NaN', 'Infinity']) assert.equal(cli(['wait', cliLong.id, '--command-after', invalid]).status, 2);
+assert.match(cli(['--help']).stdout, /--command-after/);
+console.log('agent open-tool matching, command age, parallel calls, Grok fallback, true stalls, default deadline and CLI exit 9 passed');
diff --git a/tests/agent-git-access.mjs b/tests/agent-git-access.mjs
new file mode 100644
index 0000000..3ae5034
--- /dev/null
+++ b/tests/agent-git-access.mjs
@@ -0,0 +1,82 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-git-access-'));
+const bin = path.join(home,'bin'); fs.mkdirSync(bin);
+const capture=path.join(home,'argv.json');
+fs.writeFileSync(path.join(bin,'cmux'),`#!${process.execPath}\nimport ${JSON.stringify(path.join(root,'tests/fixtures/agent-cmux.mjs'))};\n`,{mode:0o755});
+fs.writeFileSync(path.join(bin,'codex'),`#!${process.execPath}\nrequire('node:fs').writeFileSync(${JSON.stringify(capture)},JSON.stringify(process.argv.slice(2)));\n`,{mode:0o755});
+fs.writeFileSync(path.join(bin,'caffeinate'),'#!/bin/sh\nexit 0\n',{mode:0o755});
+const env={...process.env,HOME:home,PATH:`${bin}:${process.env.PATH}`,CMUX_SOCKET_PATH:'fake',CMUX_WORKSPACE_ID:'workspace:1',GIT_CONFIG_NOSYSTEM:'1',GIT_CONFIG_GLOBAL:'/dev/null'};
+for(const key of ['CODEX_HOME','GROK_HOME','CLAUDE_CONFIG_DIR','GIT_DIR','GIT_WORK_TREE','GIT_COMMON_DIR','GIT_INDEX_FILE','GIT_CONFIG_COUNT']) delete env[key];
+const run=(cmd,args,opts={})=>{const r=spawnSync(cmd,args,{env,encoding:'utf8',...opts});assert.equal(r.status,0,`${cmd} ${args.join(' ')}: ${r.stderr}`);return r.stdout.trim();};
+const git=(cwd,...args)=>run('git',['-C',cwd,...args]);
+function argv(cwd) {
+  const w=JSON.parse(run(process.execPath,[path.join(root,'bin/agent.mjs'),'open','sol','--cwd',cwd,'test task','--json']));
+  run('/bin/sh',[w.launcher]);
+  return JSON.parse(fs.readFileSync(capture));
+}
+const grants=args=>args.flatMap((a,i)=>a==='--add-dir'?[args[i+1]]:[]);
+const repo=path.join(home,'source repo'); fs.mkdirSync(repo);
+git(repo,'init'); git(repo,'config','user.name','Test Builder'); git(repo,'config','user.email','builder@example.invalid');
+fs.writeFileSync(path.join(repo,'file.txt'),'base\n'); git(repo,'add','file.txt'); git(repo,'commit','-m','base');
+const linked=path.join(home,"linked ' worktree"); git(repo,'worktree','add','-b','builder',linked);
+const common=fs.realpathSync(path.join(repo,'.git'));
+const own=fs.realpathSync(git(linked,'rev-parse','--absolute-git-dir'));
+const expected=['objects','refs','logs'].map(n=>path.join(common,n)).concat(own);
+assert.deepEqual(grants(argv(linked)),expected,'grant only commit data and this worktree administration directory');
+assert.ok(!expected.includes(common));
+assert.deepEqual(grants(argv(repo)),[],'a normal checkout needs no extra grant');
+const sibling=path.join(home,'sibling'); git(repo,'worktree','add','-b','sibling',sibling);
+assert.ok(!grants(argv(linked)).includes(git(sibling,'rev-parse','--absolute-git-dir')));
+const spoof=path.join(home,'crafted archive'); fs.mkdirSync(spoof);
+fs.writeFileSync(path.join(spoof,'.git'),`gitdir: ${own}\n`);
+assert.equal(git(spoof,'rev-parse','--git-common-dir'),common,'Git accepts a pointer to another existing worktree');
+assert.deepEqual(grants(argv(spoof)),[],'a backlink to another worktree grants nothing');
+const externalAdmin=path.join(home,'outside admin'); fs.mkdirSync(externalAdmin);
+fs.writeFileSync(path.join(externalAdmin,'commondir'),common+'\n');
+fs.writeFileSync(path.join(externalAdmin,'HEAD'),'ref: refs/heads/builder\n');
+fs.writeFileSync(path.join(externalAdmin,'gitdir'),path.join(spoof,'.git')+'\n');
+fs.writeFileSync(path.join(spoof,'.git'),`gitdir: ${externalAdmin}\n`);
+assert.equal(git(spoof,'rev-parse','--git-common-dir'),common);
+assert.deepEqual(grants(argv(spoof)),[],'a matching backlink outside common/worktrees grants nothing');
+fs.rmSync(path.join(externalAdmin,'gitdir'));
+assert.deepEqual(grants(argv(spoof)),[],'missing backlink grants nothing');
+const fakeLogs=path.join(home,'unrelated logs'); fs.mkdirSync(fakeLogs);
+fs.renameSync(path.join(common,'logs'),path.join(common,'saved-logs'));
+fs.symlinkSync(fakeLogs,path.join(common,'logs'));
+try { assert.ok(!grants(argv(linked)).includes(path.join(common,'logs')),'symlinked commit directories cannot widen the grant'); }
+finally { fs.unlinkSync(path.join(common,'logs')); fs.renameSync(path.join(common,'saved-logs'),path.join(common,'logs')); }
+function files(folder, prefix='') {
+  const out={};
+  for(const e of fs.readdirSync(folder,{withFileTypes:true})) {
+    const rel=prefix+e.name, full=path.join(folder,e.name);
+    if(e.isDirectory()) Object.assign(out,files(full,rel+'/'));
+    else if(e.isFile()) out[rel]=crypto.createHash('sha256').update(fs.readFileSync(full)).digest('hex');
+  }
+  return out;
+}
+git(repo,'pack-refs','--all');
+assert.ok(fs.existsSync(path.join(common,'packed-refs')));
+fs.writeFileSync(path.join(linked,'file.txt'),'builder commit\n'); git(linked,'add','file.txt');
+const before=files(common);
+const locked=[common,path.join(common,'hooks'),path.join(common,'info')];
+const modes=locked.map(p=>fs.statSync(p).mode&0o777);
+const config=path.join(common,'config'), configMode=fs.statSync(config).mode&0o777;
+try {
+  locked.forEach(p=>fs.chmodSync(p,0o555)); fs.chmodSync(config,0o444);
+  git(linked,'commit','-m','commit with read-only common root');
+} finally { locked.forEach((p,i)=>fs.chmodSync(p,modes[i])); fs.chmodSync(config,configMode); }
+const after=files(common), changed=[...new Set([...Object.keys(before),...Object.keys(after)])].filter(p=>before[p]!==after[p]);
+const allowed=['objects/','refs/','logs/',path.relative(common,own)+'/'];
+assert.ok(changed.length>0);
+assert.ok(changed.every(p=>allowed.some(prefix=>p.startsWith(prefix))),JSON.stringify(changed));
+assert.equal(after.config,before.config); assert.equal(after['packed-refs'],before['packed-refs']);
+assert.equal(git(linked,'log','-1','--format=%s'),'commit with read-only common root');
+assert.ok(!fs.existsSync(path.join(common,'packed-refs.lock')));
+console.log('agent grants only validated linked-worktree commit directories; forged links are rejected; packed-ref commit needs no common-root writes');
diff --git a/tests/agent-install.mjs b/tests/agent-install.mjs
new file mode 100644
index 0000000..d81a9a1
--- /dev/null
+++ b/tests/agent-install.mjs
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-install-'));
+const env = { ...process.env, HOME: home, ACS_NO_UPDATE: '1', ACS_NO_OPEN: '1' };
+const install = () => spawnSync('/bin/sh', [path.join(root, 'bin/acs'), 'install-model-id'], { env, encoding: 'utf8' });
+const first = install();
+assert.equal(first.status, 0, first.stderr);
+const agent = path.join(home, '.local/bin/agent');
+assert.ok(fs.lstatSync(agent).isSymbolicLink());
+const copied = path.join(home, '.agent-config-studio/resolver');
+for (const file of ['bin/agent.mjs', 'bin/agent-install.mjs', 'lib/agent.js', 'lib/paths.js', 'lib/roots.js']) assert.equal(fs.readFileSync(path.join(copied, file), 'utf8'), fs.readFileSync(path.join(root, file), 'utf8'));
+const r = spawnSync(agent, ['--help'], { env, encoding: 'utf8' });
+assert.equal(r.status, 0, r.stderr);
+assert.match(r.stdout, /agent open/);
+assert.equal(spawnSync(agent, ['list'], { env: { ...env, CMUX_SOCKET_PATH: '' }, encoding: 'utf8' }).status, 2);
+assert.equal(install().status, 0);
+fs.unlinkSync(agent); fs.writeFileSync(agent, 'keep me');
+const conflict = install();
+assert.equal(conflict.status, 1);
+assert.equal(fs.readFileSync(agent, 'utf8'), 'keep me');
+assert.match(conflict.stderr, /not a symlink/);
+console.log('agent install passed');
+const fake = path.join(home, 'fake-bin');
+fs.mkdirSync(fake);
+const fixture = path.join(fake, 'fake-cmux.mjs');
+fs.copyFileSync(path.join(root, 'tests/fixtures/agent-cmux.mjs'), fixture);
+fs.writeFileSync(path.join(fake, 'cmux'), `#!${process.execPath}\nimport ${JSON.stringify(fixture)};\n`, { mode: 0o755 });
+fs.unlinkSync(agent);
+assert.equal(install().status, 0);
+const installedEnv = { ...env, PATH: `${fake}:${env.PATH}`, CMUX_SOCKET_PATH: path.join(home, 'socket'), CMUX_WORKSPACE_ID: 'workspace:1' };
+const opened = spawnSync(agent, ['open', 'sol', '--cwd', home, 'installed task'], { env: installedEnv, encoding: 'utf8' });
+assert.equal(opened.status, 0, opened.stderr);
+const waited = spawnSync(agent, ['wait', opened.stdout.trim(), '--timeout', '0'], { env: installedEnv, encoding: 'utf8' });
+assert.equal(waited.status, 0, waited.stderr);
+assert.equal(waited.stdout, 'done\n');
+console.log('installed agent lifecycle passed');
diff --git a/tests/agent-reliability.mjs b/tests/agent-reliability.mjs
new file mode 100644
index 0000000..731585e
--- /dev/null
+++ b/tests/agent-reliability.mjs
@@ -0,0 +1,173 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-reliability-'));
+process.env.HOME = home;
+const fake = path.join(home, 'bin');
+fs.mkdirSync(fake);
+fs.writeFileSync(path.join(fake, 'cmux'), `#!${process.execPath}\nrequire('node:fs').appendFileSync(${JSON.stringify(path.join(home, 'cmux-calls'))}, JSON.stringify(process.argv.slice(2))+'\\n');console.log(JSON.stringify(process.argv.includes('identify') ? {caller:{workspace_ref:'workspace:1',pane_ref:'pane:1'}} : {text:process.env.FAKE_AGENT_SCREEN || 'history\\n› [Pasted Content]'}));\n`, { mode: 0o755 });
+process.env.PATH = `${fake}:${process.env.PATH}`;
+const { waitWorker, sendWorker } = await import('../lib/agent.js');
+const ctx = { workspace: 'workspace:1', pane: 'pane:1' };
+const records = path.join(home, '.agent-config-studio/agents');
+fs.mkdirSync(records, { recursive: true });
+fs.mkdirSync(path.join(home, '.cmuxterm'));
+fs.writeFileSync(path.join(home, '.cmuxterm/events.jsonl'), '');
+const write = (f, s) => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, s); };
+const append = (f, e) => fs.appendFileSync(f, JSON.stringify(e) + '\n');
+const epoch = 1800000000000;
+let clock = epoch;
+const runtime = { now: () => clock, sleep: async ms => { clock += ms; } };
+function worker(vendor, entries = [], missing = false) {
+  const id = crypto.randomUUID();
+  const runDir = path.join(records, id);
+  fs.mkdirSync(runDir);
+  const transcript = missing ? null : path.join(runDir, 'events.jsonl');
+  if (transcript) { write(transcript, entries.map(e => JSON.stringify(e) + '\n').join('')); fs.utimesSync(transcript, epoch / 1000, epoch / 1000); }
+  const w = { id, vendor, family: vendor, cwd: runDir, workspace: ctx.workspace, orchestratorPane: ctx.pane, surface_ref: `surface:${id}`, surface_id: id, session: missing ? null : id, transcript, runDir, status: 'running', openedAt: epoch, lastActivityAt: epoch, finishedAt: null, completed: 0, turnComplete: 0, eventStart: 0, turnEventStart: 0, baseline: [] };
+  write(path.join(records, `${id}.json`), JSON.stringify(w));
+  return w;
+}
+function record(w) { return JSON.parse(fs.readFileSync(path.join(records, `${w.id}.json`))); }
+function change(w, fields) { write(path.join(records, `${w.id}.json`), JSON.stringify({ ...record(w), ...fields })); }
+const ev = (type, fields = {}) => ({ type: 'event_msg', payload: { type, ...fields }, timestamp: new Date(epoch).toISOString() });
+clock = epoch + 59999;
+const absent = worker('codex', [], true);
+assert.equal((await waitWorker(absent.id, 0, ctx, { ...runtime, stallAfter: 30 })).state, 'timeout');
+clock++;
+assert.equal((await waitWorker(absent.id, 0, ctx, runtime)).state, 'no_start');
+clock = epoch;
+const question = worker('codex', [ev('task_started'), ev('task_complete', { last_agent_message: 'Need a choice.\nQUESTION: Which branch?\n\n' })]);
+const q = await waitWorker(question.id, 0, ctx, runtime);
+assert.equal(q.state, 'done'); assert.equal(q.question, true); assert.equal(q.text, 'Need a choice.\nQUESTION: Which branch?\n\n');
+const notLast = worker('codex', [ev('task_complete', { last_agent_message: 'QUESTION: Old question\nResolved.' })]);
+assert.ok(!(await waitWorker(notLast.id, 0, ctx, runtime)).question);
+const steps = [1, 2, 3, 4].flatMap(i => [
+  { type: 'response_item', payload: { type: 'function_call', call_id: `step-${i}`, name: 'exec_command', arguments: JSON.stringify({ cmd: `step ${i}` }) } },
+  { type: 'response_item', payload: { type: 'function_call_output', call_id: `step-${i}`, output: 'finished' } },
+]);
+const stalled = worker('codex', [ev('task_started'), ...steps]);
+clock = epoch + 29999;
+assert.equal((await waitWorker(stalled.id, 0, ctx, { ...runtime, stallAfter: 30 })).state, 'timeout');
+clock++;
+const stall = await waitWorker(stalled.id, 0, ctx, { ...runtime, stallAfter: 30 });
+assert.equal(stall.state, 'stalled'); assert.equal(stall.steps.length, 3); assert.match(stall.steps[0], /step 2/); assert.match(stall.steps[2], /step 4/);
+append(stalled.transcript, ev('token_count'));
+fs.utimesSync(stalled.transcript, clock / 1000, clock / 1000);
+assert.equal((await waitWorker(stalled.id, 0, ctx, { ...runtime, stallAfter: 30 })).state, 'timeout');
+clock += 30000;
+assert.equal((await waitWorker(stalled.id, 0, ctx, { ...runtime, stallAfter: 30 })).state, 'stalled');
+const noTurn = worker('codex', [ev('user_message', { message: 'composer only' })]);
+assert.equal((await waitWorker(noTurn.id, 0, ctx, { ...runtime, stallAfter: 1 })).state, 'timeout');
+const blocked = worker('claude', [{ type: 'user', message: { role: 'user', content: 'task' } }]);
+append(path.join(home, '.cmuxterm/events.jsonl'), { name: 'agent.hook.PermissionRequest', surface_id: blocked.surface_id });
+assert.equal((await waitWorker(blocked.id, 0, ctx, runtime)).state, 'stuck');
+for (const vendor of ['codex', 'claude', 'grok']) {
+  clock = epoch;
+  const initial = vendor === 'codex' ? ev('task_started') : vendor === 'claude' ? { type: 'user', message: { content: 'launch task' } } : { type: 'turn_started' };
+  const w = worker(vendor, [initial]);
+  change(w, { pendingSend: { sentAt: epoch, startedBefore: 1 } });
+  if (vendor === 'codex') append(w.transcript, ev('user_message', { message: 'not started' }));
+  clock += 9999;
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout');
+  clock++;
+  const unsent = await waitWorker(w.id, 0, ctx, runtime);
+  assert.equal(unsent.state, 'unsent'); assert.match(unsent.input, /Pasted Content/);
+  append(w.transcript, vendor === 'codex' ? ev('task_started') : vendor === 'claude' ? { type: 'user', message: { content: 'submitted' } } : { type: 'turn_started' });
+  fs.utimesSync(w.transcript, clock / 1000, clock / 1000);
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'timeout');
+}
+// Sending waits for task_started, even when a user-message line already exists.
+clock = epoch;
+const send = worker('codex', [ev('task_started')]);
+let emittedUser = false;
+const successful = { now: () => clock, sleep: async ms => {
+  clock += ms;
+  if (!emittedUser) { emittedUser = true; append(send.transcript, ev('user_message', { message: 'received' })); }
+  if (clock - epoch >= 1500 && !record(send).pendingSend?.confirmedAt) append(send.transcript, ev('task_started'));
+} };
+assert.equal((await sendWorker(send.id, 'short message', ctx, successful)).status, 'running');
+assert.ok(clock - epoch >= 1500);
+const long = worker('codex', [ev('task_started')]);
+clock = epoch;
+let started = false;
+const longRuntime = { now: () => clock, sleep: async ms => { clock += ms; if (!started) { append(long.transcript, ev('task_started')); started = true; } } };
+const longText = 'a'.repeat(401);
+await sendWorker(long.id, longText, ctx, longRuntime);
+const calls = fs.readFileSync(path.join(home, 'cmux-calls'), 'utf8').trim().split('\n').map(JSON.parse);
+const sent = calls.filter(a => a.includes('send')).at(-1).at(-1);
+assert.match(sent, /^Read .+ and follow it\.$/);
+const messagePath = sent.slice(5, -15);
+assert.equal(fs.readFileSync(messagePath, 'utf8'), longText);
+assert.ok(messagePath.startsWith(long.runDir + path.sep));
+clock = epoch;
+const failed = worker('codex', [ev('task_started')]);
+await assert.rejects(sendWorker(failed.id, 'unsubmitted', ctx, runtime), /submission/);
+assert.ok(clock - epoch >= 10000);
+assert.equal((await waitWorker(failed.id, 0, ctx, runtime)).state, 'unsent');
+console.log('agent reliability states, fake clock, turn proof and long sends passed');
+
+clock = epoch + 59000;
+const waking = worker('codex', [], true);
+assert.equal((await waitWorker(waking.id, 5, ctx, runtime)).state, 'no_start');
+assert.equal(clock, epoch + 60000);
+for (const vendor of ['claude', 'grok']) {
+  clock = epoch + 30000;
+  const toolEntries = vendor === 'claude' ? [
+    { type: 'user', message: { content: 'task' } },
+    ...[1, 2, 3, 4].flatMap(i => [
+      { type: 'assistant', message: { content: [{ type: 'tool_use', id: `tool-${i}`, name: 'Bash', input: { command: `command ${i}` } }] } },
+      { type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: `tool-${i}`, content: 'finished' }] } },
+    ]),
+  ] : [{ type: 'turn_started' }, ...[1, 2, 3, 4].flatMap(i => [{ type: 'tool_call', id: `tool-${i}`, name: 'shell', input: { command: `command ${i}` } }, { type: 'tool_result', tool_call_id: `tool-${i}`, content: 'finished' }])];
+  const toolWorker = worker(vendor, toolEntries);
+  const toolStall = await waitWorker(toolWorker.id, 0, ctx, { ...runtime, stallAfter: 30 });
+  assert.equal(toolStall.state, 'stalled'); assert.equal(toolStall.steps.length, 3); assert.match(toolStall.steps[2], /command 4/);
+}
+const defaultStall = worker('codex', [ev('task_started')]);
+clock = epoch + 299999;
+assert.equal((await waitWorker(defaultStall.id, 0, ctx, runtime)).state, 'timeout');
+clock++;
+assert.equal((await waitWorker(defaultStall.id, 0, ctx, runtime)).state, 'stalled');
+const earlier = worker('codex', [ev('task_started')]);
+append(path.join(home, '.cmuxterm/events.jsonl'), { name: 'agent.hook.PermissionRequest', surface_id: earlier.surface_id, occurred_at: new Date(epoch + 10000).toISOString() });
+clock = epoch + 60000;
+assert.equal((await waitWorker(earlier.id, 0, ctx, { ...runtime, stallAfter: 30 })).state, 'stuck');
+assert.equal((await waitWorker(earlier.id, 0, ctx, { ...runtime, stallAfter: 5 })).state, 'stuck', 'pending permission outranks an older stall');
+const cli = args => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: { ...process.env, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: 'workspace:1' }, encoding: 'utf8' });
+const noStartCli = worker('codex', [], true);
+change(noStartCli, { openedAt: Date.now() - 61000 });
+const unsentCli = worker('codex');
+change(unsentCli, { pendingSend: { sentAt: Date.now() - 11000, startedBefore: 0 } });
+const stalledCli = worker('codex', [ev('task_started'), ...steps]);
+fs.utimesSync(stalledCli.transcript, (Date.now() - 31000) / 1000, (Date.now() - 31000) / 1000);
+for (const [w, state, code, extra] of [[noStartCli, 'no_start', 6, []], [unsentCli, 'unsent', 5, []], [stalledCli, 'stalled', 7, ['--stall-after', '30']], [question, 'done', 0, []]]) {
+  const r = cli(['wait', w.id, '--timeout', '0', '--json', ...extra]);
+  assert.equal(r.status, code, r.stderr); assert.equal(JSON.parse(r.stdout).state, state);
+}
+assert.equal(cli(['wait', stalledCli.id, '--stall-after', '-1']).status, 2);
+console.log('agent all vendors, first signal, default stall threshold and CLI exit codes passed');
+
+for (const vendor of ['claude', 'grok']) {
+  clock = epoch;
+  const w = worker(vendor, vendor === 'claude' ? [{ type: 'assistant', message: { stop_reason: 'end_turn', content: [{ type: 'text', text: 'QUESTION: Continue?' }] } }] : [{ type: 'turn_ended' }]);
+  if (vendor === 'grok') write(path.join(w.runDir, 'chat_history.jsonl'), JSON.stringify({ role: 'assistant', content: 'QUESTION: Continue?' }) + '\n');
+  const result = await waitWorker(w.id, 0, ctx, runtime);
+  assert.equal(result.state, 'done'); assert.equal(result.question, true); assert.equal(result.text, 'QUESTION: Continue?');
+}
+const screenQuestion = worker('grok', [{ type: 'turn_ended' }]);
+process.env.FAKE_AGENT_SCREEN = 'QUESTION: Screen fallback?';
+assert.equal((await waitWorker(screenQuestion.id, 0, ctx, runtime)).question, true);
+delete process.env.FAKE_AGENT_SCREEN;
+console.log('agent question detection covers all vendors and Grok screen fallback');
+
+clock = epoch + 30000;
+const historyTools = worker('grok', [{ type: 'turn_started' }]);
+write(path.join(historyTools.runDir, 'chat_history.jsonl'), [1, 2, 3, 4].flatMap(i => [{ type: 'tool_call', id: `history-${i}`, name: 'shell', content: `history command ${i}` }, { type: 'tool_result', tool_call_id: `history-${i}`, content: 'finished' }]).map(e => JSON.stringify(e) + '\n').join(''));
+assert.match((await waitWorker(historyTools.id, 0, ctx, { ...runtime, stallAfter: 30 })).steps.at(-1), /history command 4/);
+console.log('agent stalled diagnostics use Grok chat history when available');
diff --git a/tests/agent-review-fixes.mjs b/tests/agent-review-fixes.mjs
new file mode 100644
index 0000000..655d5bd
--- /dev/null
+++ b/tests/agent-review-fixes.mjs
@@ -0,0 +1,301 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-review-fixes-'));
+process.env.HOME = home;
+for (const key of ['CODEX_HOME', 'GROK_HOME', 'CLAUDE_CONFIG_DIR']) delete process.env[key];
+const bin = path.join(home, 'bin'); fs.mkdirSync(bin);
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nimport ${JSON.stringify(path.join(root, 'tests/fixtures/agent-cmux.mjs'))};\n`, { mode: 0o755 });
+fs.writeFileSync(path.join(bin, 'caffeinate'), '#!/bin/sh\nexit 0\n', { mode: 0o755 });
+const capture = path.join(home, 'capture.json');
+for (const vendor of ['codex', 'claude', 'grok']) fs.writeFileSync(path.join(bin, vendor), `#!${process.execPath}\nrequire('node:fs').writeFileSync(${JSON.stringify(capture)},JSON.stringify({argv:process.argv.slice(2),home:process.env[${JSON.stringify({codex:'CODEX_HOME',claude:'CLAUDE_CONFIG_DIR',grok:'GROK_HOME'}[vendor])}]}));\n`, { mode: 0o755 });
+process.env.PATH = `${bin}:${process.env.PATH}`;
+const env = () => ({ ...process.env, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: 'workspace:1' });
+const cli = (args, extra = {}) => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: { ...env(), ...extra }, encoding: 'utf8', timeout: 15000 });
+const json = r => { assert.equal(r.status, 0, r.stderr); return JSON.parse(r.stdout); };
+const { waitWorker, sendWorker, listWorkers, openWorker, answerWorker } = await import('../lib/agent.js');
+const records = path.join(home, '.agent-config-studio/agents'); fs.mkdirSync(records, { recursive: true });
+const events = path.join(home, '.cmuxterm/events.jsonl'); fs.mkdirSync(path.dirname(events)); fs.writeFileSync(events, '');
+const statePath = path.join(home, 'fake-cmux.json');
+const state = () => fs.existsSync(statePath) ? JSON.parse(fs.readFileSync(statePath)) : { n: 0, panes: ['pane:1','pane:2'], calls: [], workers: {} };
+const mutate = fn => { const s = state(); fn(s); fs.writeFileSync(statePath, JSON.stringify(s)); };
+const ctx = { workspace: 'workspace:1', pane: 'pane:1' };
+const epoch = Date.now() - 40 * 60000;
+let clock = epoch;
+const runtime = { now: () => clock, sleep: async ms => { clock += ms; }, commandAfter: 10 };
+const stamp = () => new Date(clock).toISOString();
+const started = v => v === 'codex' ? { type: 'event_msg', timestamp: stamp(), payload: { type: 'task_started' } } : v === 'claude' ? { type: 'user', timestamp: stamp(), message: { content: 'user task' } } : { type: 'turn_started', timestamp: stamp() };
+const done = v => v === 'codex' ? { type: 'event_msg', timestamp: stamp(), payload: { type: 'task_complete', last_agent_message: 'done' } } : v === 'claude' ? { type: 'assistant', timestamp: stamp(), message: { stop_reason: 'end_turn', content: [{ type: 'text', text: 'done' }] } } : { type: 'turn_ended', timestamp: stamp() };
+function worker(vendor, entries = []) {
+  const id = crypto.randomUUID(), runDir = path.join(records, id); fs.mkdirSync(runDir);
+  const transcript = path.join(runDir, 'events.jsonl'); fs.writeFileSync(transcript, entries.map(e => JSON.stringify(e)+'\n').join('')); fs.utimesSync(transcript, clock/1000,clock/1000);
+  const history = vendor === 'grok' ? path.join(runDir,'chat_history.jsonl') : null;
+  if (history) fs.writeFileSync(history,'');
+  const w = { id, vendor, history, family: vendor, cwd: runDir, runDir, transcript, session: id, surface_ref: `surface:${id}`, surface_id: id, pane_ref: 'pane:2', workspace: ctx.workspace, orchestratorPane: ctx.pane, status: 'running', openedAt: epoch, lastActivityAt: epoch, completed: 0, turnComplete: 0, eventStart: 0, baseline: [] };
+  fs.writeFileSync(path.join(records, `${id}.json`), JSON.stringify(w));
+  mutate(s => { if (!s.panes.includes('pane:2')) s.panes.push('pane:2'); s.workers[w.surface_ref] = { ...w, screen: 'Worker screen' }; });
+  return w;
+}
+const append = (w, e) => { fs.appendFileSync(w.transcript, JSON.stringify(e)+'\n'); fs.utimesSync(w.transcript, clock/1000,clock/1000); };
+const record = w => JSON.parse(fs.readFileSync(path.join(records, `${w.id}.json`)));
+const show = (w, screen) => mutate(s => { s.workers[w.surface_ref].screen = screen; });
+const tool = (id = 'a') => ({ type: 'assistant', timestamp: stamp(), message: { content: [{ type: 'tool_use', id, name: 'Bash', input: { command: `command ${id}` } }] } });
+const result = (id = 'a') => ({ type: 'user', timestamp: stamp(), message: { content: [{ type: 'tool_result', tool_use_id: id, content: 'finished' }] } });
+const permission = (w, id = 'a') => fs.appendFileSync(events, JSON.stringify({ name: 'agent.hook.PermissionRequest', surface_id: w.surface_id, occurred_at: stamp(), payload: { tool_use_id: id } })+'\n');
+const inputCalls = w => state().calls.filter(a => (a.includes('send') || a.includes('send-key')) && a.includes(w.surface_ref));
+const cases = {
+  async b6f1() {
+    for (const vendor of ['codex','claude','grok']) {
+      clock = Date.now(); const w = worker(vendor);
+      let launched=false;
+      const lateLaunch = { now:()=>clock, sleep:async ms=>{clock+=ms;if(!launched){append(w,started(vendor));launched=true;}} };
+      await assert.rejects(sendWorker(w.id,'unsubmitted correction',ctx,lateLaunch),/startup|launch turn/);
+      assert.equal(inputCalls(w).length,0,'nothing is typed before the launch turn is observed');
+      assert.equal(record(w).pendingSend,undefined);
+      const legacy=worker(vendor);
+      const saved=record(legacy); saved.pendingSend={sentAt:clock-11000,startedBefore:0};
+      fs.writeFileSync(path.join(records,`${legacy.id}.json`),JSON.stringify(saved));
+      append(legacy,started(vendor));
+      assert.equal((await waitWorker(legacy.id,0,ctx,runtime)).state,'unsent','a late launch cannot confirm a legacy pending send');
+      assert.equal(record(legacy).pendingSend.confirmedAt,undefined);
+      append(legacy,started(vendor));
+      await waitWorker(legacy.id,0,ctx,runtime);
+      assert.ok(record(legacy).pendingSend.confirmedAt,'only a turn after launch can confirm a legacy send');
+      const closed=record(legacy); closed.status='closed'; fs.writeFileSync(path.join(records,`${legacy.id}.json`),JSON.stringify(closed));
+      append(w,started(vendor));
+      await sendWorker(w.id,'correction after startup',ctx,runtime);
+      assert.ok(record(w).pendingSend.confirmedAt,'a subsequent turn confirms the correction');
+    }
+  },
+  async b6f2() {
+    for (const vendor of ['codex','claude','grok']) {
+      clock = Date.now(); const w = worker(vendor,[started(vendor),done(vendor)]);
+      process.env.FAKE_NO_SUBMIT='1';
+      try { await assert.rejects(sendWorker(w.id,'first correction',ctx,runtime),/submission/); }
+      finally { delete process.env.FAKE_NO_SUBMIT; }
+      show(w,'› first correction');
+      const pending=record(w).pendingSend, count=inputCalls(w).length;
+      await assert.rejects(sendWorker(w.id,'replacement correction',ctx,runtime),error=>error.exitCode===5 && /unsent/.test(error.message) && /first correction/.test(error.message));
+      assert.equal(inputCalls(w).length,count,'retry cannot append text or press Enter');
+      assert.deepEqual(record(w).pendingSend,pending,'refusal preserves the unresolved attempt');
+      const response=cli(['send',w.id,'replacement correction']);
+      assert.equal(response.status,5,response.stderr); assert.match(response.stderr,/unsent.*first correction/);
+      assert.equal(inputCalls(w).length,count);
+      append(w,started(vendor)); append(w,done(vendor)); show(w,'Worker screen');
+      mutate(s=>{s.workers[w.surface_ref].pending='';});
+      await sendWorker(w.id,'after manual submission',ctx,runtime);
+      assert.ok(record(w).pendingSend.confirmedAt,'manual submission reconciles the old pending attempt');
+      const entries=fs.readFileSync(vendor==='grok'?w.history:w.transcript,'utf8').trim().split('\n').map(line=>JSON.parse(line));
+      const texts=entries.flatMap(e=>vendor==='codex'?(e.payload?.type==='user_message'?[e.payload.message]:[]):vendor==='claude'?(e.type==='user'?[e.message.content]:[]):e.role==='user'?[e.content]:[]);
+      assert.equal(texts.at(-1),'after manual submission','the reconciled next message is submitted without concatenation');
+    }
+  },
+  async b6f3() {
+    const question='Do you want to proceed?\n1. Yes\n2. No\nQUESTION: Choose yes or no.';
+    for (const vendor of ['codex','claude','grok']) {
+      clock = Date.now();
+      const end=done(vendor);
+      if(vendor==='codex')end.payload.last_agent_message=question;
+      else if(vendor==='claude')end.message.content[0].text=question;
+      const w=worker(vendor,[started(vendor),end]);
+      show(w,question);
+      const waited=await waitWorker(w.id,0,ctx,runtime);
+      assert.equal(waited.state,'done'); assert.equal(waited.question,true); assert.equal(waited.text,question);
+      await sendWorker(w.id,'Yes',ctx,runtime);
+      assert.ok(inputCalls(w).some(a=>a.includes('send-key')),'completed choice text permits a reply');
+      clock=Math.max(clock,Date.now())+1000; permission(w,'new');
+      await assert.rejects(sendWorker(w.id,'not permission',ctx,runtime),/stuck/,'a new hook still blocks after completion');
+      const active=worker(vendor,[started(vendor)]); show(active,question);
+      await assert.rejects(sendWorker(active.id,'active dialog',ctx,runtime),/stuck/,'screen-only active approvals remain protected');
+      assert.equal(inputCalls(active).length,0);
+      for (const item of [w,active]) { const saved=record(item); saved.status='closed'; fs.writeFileSync(path.join(records,`${item.id}.json`),JSON.stringify(saved)); }
+    }
+  },
+  async x1() {
+    const approvalRuntime = { now: runtime.now, sleep: runtime.sleep };
+    clock = epoch;
+    const w = worker('claude',[started('claude'),tool()]);
+    clock += 610000;
+    permission(w);
+    show(w,'Do you want to make this edit to example.js?\n❯ 1. Yes\n  2. No');
+    await assert.rejects(sendWorker(w.id,'never approve',ctx,approvalRuntime),/stuck/);
+    assert.equal(inputCalls(w).length,0,'a newer approval cannot receive text or Enter behind an old command');
+    assert.equal((await waitWorker(w.id,0,ctx,approvalRuntime)).state,'stuck');
+    show(w,'Worker screen');
+    assert.equal((await waitWorker(w.id,0,ctx,approvalRuntime)).state,'long_command','observed dismissal retires the request');
+    clock += 1000; permission(w,'b');
+    await assert.rejects(sendWorker(w.id,'hook only',ctx,approvalRuntime),/stuck/);
+    assert.equal(inputCalls(w).length,0,'an unresolved hook blocks even without a recognized screen');
+    assert.equal((await waitWorker(w.id,0,ctx,approvalRuntime)).state,'stuck');
+    const postStartTrust = worker('claude',[started('claude')]);
+    show(postStartTrust,'Accessing workspace:\nYes, I trust this folder\nNo, exit');
+    assert.equal((await waitWorker(postStartTrust.id,0,ctx,approvalRuntime)).state,'timeout','session start invalidates the startup wait state');
+    await assert.rejects(sendWorker(postStartTrust.id,'do not trust',ctx,approvalRuntime),/stuck/);
+    assert.equal(inputCalls(postStartTrust).length,0,'sending still checks the visible dialog independently of wait state');
+    for (const question of ['Do you want to make this edit to example.js?', 'Do you want to create example.js?', 'Do you want to write to example.js?', 'Do you want to overwrite example.js?', 'Do you want to allow Claude to fetch this content?']) {
+      const screenOnly = worker('claude',[started('claude'),tool()]);
+      show(screenOnly,`${question}\n❯ 1. Yes\n  2. Yes, allow all edits during this session\n  3. No`);
+      await assert.rejects(sendWorker(screenOnly.id,'screen only',ctx,approvalRuntime),/stuck/);
+      assert.equal(inputCalls(screenOnly).length,0,question);
+      assert.equal((await waitWorker(screenOnly.id,0,ctx,approvalRuntime)).state,'stuck');
+    }
+  },
+  async x2() {
+    for (const output of ['Would you like to proceed?', 'Do you want to proceed?\n1. Yes\n2. No\n'+Array.from({length:30},(_,i)=>`Answer line ${i}`).join('\n')]) {
+      clock = Date.now(); const w = worker('claude',[started('claude'),done('claude')]);
+      show(w,output);
+      assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'done');
+      await sendWorker(w.id,'a normal follow-up',ctx,runtime);
+      assert.ok(inputCalls(w).some(a=>a.includes('send-key')),'ordinary answer and scrollback do not block submission');
+    }
+  },
+  async g1answer() {
+    clock = Date.now(); const w = worker('grok',[started('grok')]);
+    show(w,'An unfinished screen is not an answer');
+    assert.throws(()=>answerWorker(w.id,ctx),/no answer yet \(state running\)/);
+    const response=cli(['answer',w.id]);
+    assert.notEqual(response.status,0); assert.equal(response.stdout,''); assert.match(response.stderr,/no answer yet \(state running\)/);
+  },
+  async g1() {
+    clock = Date.now(); const w = worker('grok');
+    const saved=record(w); saved.session=null; saved.transcript=null; saved.openedAt=clock-150000;
+    fs.writeFileSync(path.join(records,`${w.id}.json`),JSON.stringify(saved));
+    show(w,fs.readFileSync(path.join(root,'tests/fixtures/agent-screens/grok-trust-narrow.txt'),'utf8'));
+    assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'stuck');
+    await assert.rejects(sendWorker(w.id,'never trust',ctx,runtime),/stuck/);
+    assert.equal(inputCalls(w).length,0);
+    assert.throws(()=>answerWorker(w.id,ctx),/no answer yet \(state stuck\)/);
+    const response=cli(['answer',w.id]);
+    assert.notEqual(response.status,0); assert.match(response.stderr,/no answer yet \(state stuck\)/); assert.equal(response.stdout,'');
+    for (const vendor of ['codex','claude','grok']) {
+      const active=worker(vendor,[started(vendor)]);
+      assert.throws(()=>answerWorker(active.id,ctx),/no answer yet \(state running\)/);
+      const unfinished=worker(vendor,[started(vendor),done(vendor),started(vendor)]);
+      assert.throws(()=>answerWorker(unfinished.id,ctx),/no answer yet \(state running\)/,'a prior turn is not the current answer');
+    }
+    const fallback=worker('grok',[started('grok'),done('grok')]); show(fallback,'Completed answer');
+    assert.equal(answerWorker(fallback.id,ctx),'Completed answer','screen fallback remains available after completion');
+  },
+
+  async f1() {
+    for (const [family, variable] of [['sol','CODEX_HOME'], ['opus','CLAUDE_CONFIG_DIR'], ['grok','GROK_HOME']]) {
+      const launchHome = path.join(home, `private ${family}`);
+      const w = json(cli(['open', family, '--cwd', home, 'task', '--json'], { [variable]: launchHome }));
+      const waited = cli(['wait', w.id, '--timeout','0','--json'], { [variable]: path.join(home,'wrong-home') });
+      assert.equal(waited.status, 0, `${variable}: ${waited.stdout} ${waited.stderr}`);
+      assert.equal(cli(['answer',w.id], { [variable]: path.join(home,'wrong-home') }).stdout, 'exact\nanswer  ');
+      assert.equal(record(w).harnessHome, launchHome);
+      const shell = spawnSync('/bin/sh', [w.launcher], { env: { ...env(), [variable]: path.join(home,'wrong-home') }, encoding: 'utf8' });
+      assert.equal(shell.status,0,shell.stderr); assert.equal(JSON.parse(fs.readFileSync(capture)).home, launchHome);
+    }
+    const defaults = json(cli(['open','opus','--cwd',home,'task','--json']));
+    assert.equal(spawnSync('/bin/sh',[defaults.launcher],{env:{...env(),CLAUDE_CONFIG_DIR:path.join(home,'inherited-wrong')},encoding:'utf8'}).status,0);
+    assert.equal(JSON.parse(fs.readFileSync(capture)).home,undefined,'an unset launch override stays unset');
+  },
+  async f2() {
+    for (const vendor of ['codex','claude','grok']) {
+      clock = epoch; const w = worker(vendor,[started(vendor),done(vendor)]);
+      assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'done');
+      clock = Date.now(); append(w,started(vendor));
+      if (vendor === 'claude') {
+        append(w,tool());
+        fs.appendFileSync(events,JSON.stringify({name:'agent.hook.Stop',surface_id:w.surface_id,occurred_at:new Date(clock+100).toISOString()})+'\n');
+        fs.appendFileSync(events,JSON.stringify({name:'agent.hook.Stop',surface_id:w.surface_id,occurred_at:new Date(clock+200).toISOString()})+'\n');
+      }
+      assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'timeout', `${vendor}: direct turn is running`);
+      assert.ok(record(w).lastActivityAt >= clock);
+      assert.equal(listWorkers(ctx).find(r=>r.id===w.id).status,'running');
+      clock += 11000;
+      if (vendor === 'claude') assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'long_command');
+      else { clock += 301000; assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'stalled','direct turns keep stall checks'); }
+      append(w,done(vendor));
+      assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'done');
+    }
+    const four=[];
+    for (let i=0;i<4;i++) {
+      clock=Date.now(); const w=worker('codex',[started('codex'),done('codex')]);
+      await waitWorker(w.id,0,ctx,runtime); append(w,started('codex')); four.push(w);
+    }
+    let opened=null;
+    const queued=openWorker('sol',{cwd:home,prompt:'queued task'},ctx).then(w=>opened=w);
+    try { await new Promise(resolve=>setTimeout(resolve,60)); assert.equal(opened,null,'four direct turns occupy all worker slots'); }
+    finally { const w=record(four[0]); w.status='closed'; fs.writeFileSync(path.join(records,`${w.id}.json`),JSON.stringify(w)); }
+    await queued; assert.ok(opened.id);
+  },
+  async f3() {
+    clock = epoch;
+    const w = worker('claude',[started('claude'),tool('a')]);
+    clock += 1000; permission(w,'a'); show(w,'Do you want to proceed?\n1. Yes\n2. No');
+    assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'stuck');
+    clock += 100; append(w,result('unrelated'));
+    assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'stuck','an unrelated result cannot resolve an identified request');
+    clock += 1000; append(w,result('a')); append(w,tool('b')); show(w,'Worker screen');
+    clock += 11000;
+    assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'long_command','resolved request cannot mask a later command');
+    clock += 1000; permission(w,'b'); show(w,'Do you want to proceed?\n1. Yes\n2. No');
+    assert.equal((await waitWorker(w.id,0,ctx,{...runtime,commandAfter:600})).state,'stuck','a later request must still block');
+    clock += 1000; append(w,started('claude')); show(w,'Worker screen');
+    assert.equal((await waitWorker(w.id,0,ctx,runtime)).state,'timeout','a later turn retires the obsolete request');
+    clock=Date.now(); const dismissed=worker('claude',[started('claude'),tool()]);
+    clock+=1000; permission(dismissed); show(dismissed,'Do you want to proceed?\n1. Yes\n2. No');
+    assert.equal((await waitWorker(dismissed.id,0,ctx,runtime)).state,'stuck');
+    show(dismissed,'Worker screen'); clock+=11000;
+    assert.equal((await waitWorker(dismissed.id,0,ctx,runtime)).state,'long_command','a dismissed dialog no longer hides its running command');
+    clock=Date.now(); const unlabelled=worker('claude',[started('claude'),tool()]);
+    clock+=1000; permission(unlabelled,null); show(unlabelled,'Do you want to proceed?\n1. Yes\n2. No');
+    assert.equal((await waitWorker(unlabelled.id,0,ctx,runtime)).state,'stuck');
+    clock+=1000; append(unlabelled,result()); append(unlabelled,tool('next')); show(unlabelled,'Worker screen'); clock+=11000;
+    assert.equal((await waitWorker(unlabelled.id,0,ctx,runtime)).state,'long_command','timestamped results also resolve hooks without call ids');
+  },
+  async s1() {
+    const prompt = '--config=mcp_servers.evil={command="sh",args=["-c","printf harmless"]}';
+    const file = path.join(home,'attacker-task.md'); fs.writeFileSync(file,prompt);
+    for (const family of ['sol','opus','grok']) {
+      const w = json(cli(['open',family,'--cwd',home,'--prompt-file',file,'--json']));
+      assert.equal(spawnSync('/bin/sh',[w.launcher],{env:env(),encoding:'utf8'}).status,0);
+      const argv = JSON.parse(fs.readFileSync(capture)).argv;
+      assert.equal(argv.at(-2),'--',`${family}: prompt must follow the option delimiter`);
+      assert.equal(argv.at(-1),prompt);
+      assert.ok(!argv.slice(0,argv.indexOf('--')).some(a=>a.includes('mcp_servers.evil')));
+    }
+  },
+  async s2() {
+    for (const vendor of ['claude','codex','grok']) for (const kind of ['trust','permission']) {
+      clock = Date.now();
+      const w = worker(vendor,[started(vendor)]);
+      if (kind === 'permission') { append(w,tool()); permission(w); show(w,'Do you want to proceed?\n1. Yes\n2. No'); }
+      else {
+        const saved=record(w); saved.session=null; saved.transcript=null; fs.writeFileSync(path.join(records,`${w.id}.json`),JSON.stringify(saved));
+        show(w,vendor==='codex'?'Trust this folder?\n1. Trust and continue\n2. Quit':vendor==='grok'?'Do you trust the contents of this directory?\ny  Yes, proceed\nn  No, quit':'Accessing workspace:\nQuick safety check: Is this a project you trust?\nYes, I trust this folder\nNo, exit');
+      }
+      await assert.rejects(sendWorker(w.id,'Do not approve anything',ctx,runtime),/stuck/);
+      assert.equal(inputCalls(w).length,0,`${vendor} ${kind}: no text or keys reach a dialog`);
+      const refused=cli(['send',w.id,'Do not approve anything']);
+      assert.equal(refused.status,3,refused.stderr); assert.match(refused.stderr,/stuck/);
+      assert.equal(inputCalls(w).length,0,'CLI refusal also sends nothing');
+      const saved=record(w); saved.status='closed'; fs.writeFileSync(path.join(records,`${w.id}.json`),JSON.stringify(saved));
+    }
+    for (const [flag, expectedKeys] of [['FAKE_PERMISSION_ON_SEND',0], ['FAKE_PERMISSION_AFTER_ENTER',1]]) {
+      clock=Date.now(); const w=worker('claude',[started('claude'),done('claude')]);
+      process.env[flag]='1';
+      try { await assert.rejects(sendWorker(w.id,'correction',ctx,runtime),/stuck/); }
+      finally { delete process.env[flag]; }
+      assert.equal(inputCalls(w).filter(a=>a.includes('send-key')).length,expectedKeys,'stop before Enter can answer the new dialog');
+    }
+  },
+};
+let failures=0;
+for (const [name, test] of Object.entries(cases)) {
+  if (process.env.FIX_CASE && process.env.FIX_CASE !== name) continue;
+  try { await test(); console.log(`PASS ${name}`); }
+  catch (error) { failures++; console.error(`FAIL ${name}: ${error.message}`); }
+  finally {
+    for (const f of fs.readdirSync(records).filter(f=>f.endsWith('.json'))) { const file=path.join(records,f),w=JSON.parse(fs.readFileSync(file)); w.status='closed'; fs.writeFileSync(file,JSON.stringify(w)); }
+  }
+}
+assert.equal(failures,0,'all review findings have regression coverage');
diff --git a/tests/agent-screens.mjs b/tests/agent-screens.mjs
new file mode 100644
index 0000000..92aab66
--- /dev/null
+++ b/tests/agent-screens.mjs
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-screens-'));
+process.env.HOME = home;
+const bin = path.join(home, 'bin');
+const screenPath = path.join(home, 'screen');
+const callsPath = path.join(home, 'calls');
+fs.mkdirSync(bin);
+fs.writeFileSync(screenPath, 'Starting');
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nconst fs=require('node:fs');fs.appendFileSync(${JSON.stringify(callsPath)},JSON.stringify(process.argv.slice(2))+'\\n');console.log(JSON.stringify(process.argv.includes('identify')?{caller:{workspace_ref:'workspace:1',pane_ref:'pane:1'}}:{text:fs.readFileSync(${JSON.stringify(screenPath)},'utf8')}));\n`, { mode: 0o755 });
+process.env.PATH = `${bin}:${process.env.PATH}`;
+const { waitWorker } = await import('../lib/agent.js');
+const ctx = { workspace: 'workspace:1', pane: 'pane:1' };
+const records = path.join(home, '.agent-config-studio/agents');
+fs.mkdirSync(records, { recursive: true });
+const events = path.join(home, '.cmuxterm/events.jsonl');
+fs.mkdirSync(path.dirname(events)); fs.writeFileSync(events, '');
+const epoch = 1800000000000;
+let clock = epoch;
+const runtime = { now: () => clock, sleep: async ms => { clock += ms; }, stallAfter: 30 };
+const fixture = (vendor, kind) => fs.readFileSync(path.join(root, 'tests/fixtures/agent-screens', `${vendor}-${kind}.txt`), 'utf8');
+const show = text => fs.writeFileSync(screenPath, text);
+function worker(vendor, started = false) {
+  const id = crypto.randomUUID(), runDir = path.join(records, id);
+  fs.mkdirSync(runDir);
+  const transcript = started ? path.join(runDir, 'events.jsonl') : null;
+  if (started) {
+    const entry = vendor === 'codex' ? { type: 'event_msg', payload: { type: 'task_started' } } : vendor === 'claude' ? { type: 'user', message: { content: 'task' } } : { type: 'turn_started' };
+    fs.writeFileSync(transcript, JSON.stringify(entry) + '\n');
+    fs.utimesSync(transcript, epoch / 1000, epoch / 1000);
+  }
+  const w = { id, vendor, cwd: runDir, workspace: ctx.workspace, orchestratorPane: ctx.pane, surface_ref: `surface:${id}`, surface_id: id, session: started ? id : null, transcript, runDir, status: 'running', openedAt: epoch, lastActivityAt: epoch, completed: 0, turnComplete: 0, eventStart: 0, baseline: [] };
+  fs.writeFileSync(path.join(records, `${id}.json`), JSON.stringify(w));
+  return w;
+}
+for (const vendor of ['codex', 'claude', 'grok']) {
+  clock = epoch; show('Starting');
+  const w = worker(vendor);
+  let appeared;
+  const r = await waitWorker(w.id, 12, ctx, { ...runtime, sleep: async ms => {
+    clock += ms;
+    if (!appeared && clock >= epoch + 3250) { appeared = clock; show(`\x1b[32m${fixture(vendor, 'trust')}\x1b[0m`); }
+  } });
+  assert.equal(r.state, 'stuck', vendor); assert.equal(r.kind, 'trust');
+  assert.ok(clock - appeared <= 3000, `${vendor}: dialog detection within one screen interval`);
+  assert.match(r.prompt, vendor === 'grok' ? /Yes, proceed/ : vendor === 'claude' ? /Yes, I trust this folder/ : /Trust and continue/);
+  assert.ok(!r.prompt.includes('\x1b'));
+  clock = epoch + 61000;
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).kind, 'trust', 'trust beats startup deadline');
+  show('The documentation mentions Trust this folder? as a prompt.');
+  clock += 3000;
+  assert.equal((await waitWorker(w.id, 0, ctx, runtime)).state, 'no_start');
+  show(fixture(vendor, 'running')); clock = epoch;
+  const active = worker(vendor, true);
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'timeout');
+  clock += 3000; show(fixture(vendor, 'running').replace('12s', '15s'));
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'timeout');
+  clock += 29000; show(fixture(vendor, 'running').replace('12s', '44s'));
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'timeout', `${vendor}: advancing elapsed prevents false stall`);
+  const saved = JSON.parse(fs.readFileSync(path.join(records, `${active.id}.json`)));
+  assert.equal(saved.indicator.advancedAt, clock, 'progress persists between wait invocations');
+  clock += 29999;
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'timeout');
+  clock++;
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'stalled', `${vendor}: frozen indicator eventually stalls`);
+  show('Waiting'); clock += 1;
+  assert.equal((await waitWorker(active.id, 0, ctx, runtime)).state, 'stalled', 'disappearing indicator does not reset the clock');
+  clock = epoch; show(fixture(vendor, 'running'));
+  const thinking = worker(vendor, true);
+  const moving = { ...runtime, sleep: async ms => {
+    clock += ms;
+    show(fixture(vendor, 'running').replace('12s', `${12 + Math.floor((clock - epoch) / 1000)}s`));
+  } };
+  assert.equal((await waitWorker(thinking.id, 65, ctx, moving)).state, 'timeout', 'continuous polling observes thinking beyond two stall windows');
+  assert.equal((await waitWorker(thinking.id, 31, ctx, runtime)).state, 'stalled', 'a timer that stops advancing wakes the waiter');
+}
+const calls = fs.readFileSync(callsPath, 'utf8').trim().split('\n').map(JSON.parse);
+assert.ok(calls.every(args => args.includes('read-screen')), 'dialog checks never type or answer');
+clock = epoch; show(fixture('claude', 'trust'));
+const cliWorker = worker('claude');
+const cli = spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), 'wait', cliWorker.id, '--timeout', '0', '--json'], { env: { ...process.env, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: ctx.workspace }, encoding: 'utf8' });
+assert.equal(cli.status, 3, cli.stderr); assert.equal(JSON.parse(cli.stdout).kind, 'trust');
+show('Allow this command?');
+const permitted = worker('claude', true);
+fs.appendFileSync(events, JSON.stringify({ name: 'agent.hook.PermissionRequest', surface_id: permitted.surface_id }) + '\n');
+assert.equal((await waitWorker(permitted.id, 0, ctx, runtime)).state, 'stuck', 'permission hook after session start');
+clock = epoch; show(fixture('claude', 'trust'));
+const trusting = worker('claude');
+assert.equal((await waitWorker(trusting.id, 0, ctx, runtime)).kind, 'trust');
+fs.appendFileSync(events, JSON.stringify({ name: 'agent.hook.SessionStart', surface_id: trusting.surface_id, session_id: trusting.id }) + '\n');
+assert.equal((await waitWorker(trusting.id, 0, ctx, runtime)).state, 'timeout', 'a session start invalidates the cached startup dialog');
+show('• Working (1m 2s • esc to interrupt)'); clock = epoch;
+const minute = worker('codex', true);
+await waitWorker(minute.id, 0, ctx, runtime);
+show('• Working (1m 5s • esc to interrupt)'); clock += 31000;
+assert.equal((await waitWorker(minute.id, 0, ctx, runtime)).state, 'timeout');
+show('• Working (1s • esc to interrupt)'); clock += 30000;
+assert.equal((await waitWorker(minute.id, 0, ctx, runtime)).state, 'stalled', 'a timer reset is not forward progress');
+console.log('agent pre-session trust dialogs, poll latency, CLI exit, post-start permission and advancing/frozen indicators passed');
diff --git a/tests/agent-sessions.mjs b/tests/agent-sessions.mjs
new file mode 100644
index 0000000..343155b
--- /dev/null
+++ b/tests/agent-sessions.mjs
@@ -0,0 +1,110 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-sessions-'));
+process.env.HOME = home;
+const bin = path.join(home, 'bin'); fs.mkdirSync(bin);
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nconsole.log(JSON.stringify(process.argv.includes('identify')?{caller:{workspace_ref:'workspace:1',pane_ref:'pane:1'}}:{text:'Worker screen'}));\n`, { mode: 0o755 });
+process.env.PATH = `${bin}:${process.env.PATH}`;
+const { waitWorker } = await import('../lib/agent.js');
+const ctx = { workspace: 'workspace:1', pane: 'pane:1' };
+const records = path.join(home, '.agent-config-studio/agents'); fs.mkdirSync(records, { recursive: true });
+const eventFile = path.join(home, '.cmuxterm/events.jsonl'); fs.mkdirSync(path.dirname(eventFile)); fs.writeFileSync(eventFile, '');
+const epoch = 1800000000000;
+let clock = epoch;
+const runtime = { now: () => clock, sleep: async ms => { clock += ms; }, commandAfter: 30 };
+const stamp = new Date(epoch).toISOString();
+const encode = (vendor, id) => `cmux-feed-v1:${Buffer.from(vendor).toString('base64')}:${Buffer.from(id).toString('base64')}`;
+const encoded = 'cmux-feed-v1:Y2xhdWRl:MDljZTA3N2ItYzUzNy00MjQ0LTkyZjktYWEyYTJlNGE0Zjgx';
+const exactId = '09ce077b-c537-4244-92f9-aa2a2e4a4f81';
+const put = (file, content) => { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, content); };
+const jsonl = entries => entries.map(e => JSON.stringify(e) + '\n').join('');
+function worker(vendor, fields = {}) {
+  const id = crypto.randomUUID(), cwd = path.join(home, `project.with punctuation_${id}`);
+  fs.mkdirSync(cwd);
+  const w = { id, vendor, cwd, surface_id: id, surface_ref: `surface:${id}`, workspace: ctx.workspace, orchestratorPane: ctx.pane, status: 'running', session: null, transcript: null, openedAt: epoch, lastActivityAt: epoch, completed: 0, turnComplete: 0, eventStart: 0, baseline: [], ...fields };
+  put(path.join(records, `${id}.json`), JSON.stringify(w)); return w;
+}
+const record = w => JSON.parse(fs.readFileSync(path.join(records, `${w.id}.json`)));
+function hook(w, session, payload = false, timestamp = stamp) {
+  fs.appendFileSync(eventFile, jsonl([{ name: 'agent.hook.SessionStart', surface_id: w.surface_id, occurred_at: timestamp, ...(payload ? { payload: { session_id: session } } : { session_id: session }) }]));
+}
+function transcript(w, session, entries = []) {
+  const file = w.vendor === 'claude' ? path.join(home, '.claude/projects', `different-project-encoding-${w.id}`, `${session}.jsonl`)
+    : w.vendor === 'codex' ? path.join(home, '.codex/sessions/2027/01/15', `rollout-${session}.jsonl`)
+      : path.join(home, '.grok/sessions', w.cwd.replace(/\//g, '%2F'), session, 'events.jsonl');
+  const initial = w.vendor === 'codex' ? [{ type: 'session_meta', payload: { id: session, cwd: w.cwd } }, { type: 'event_msg', payload: { type: 'task_started' } }]
+    : w.vendor === 'claude' ? [{ type: 'user', cwd: w.cwd, message: { content: 'task' } }] : [{ type: 'turn_started' }];
+  put(file, jsonl([...initial, ...entries])); fs.utimesSync(file, epoch / 1000, epoch / 1000); return file;
+}
+const claude = worker('claude');
+hook(claude, encoded);
+const file = transcript(claude, exactId, [{ type: 'assistant', timestamp: stamp, message: { content: [{ type: 'tool_use', id: 'sleep', name: 'Bash', input: { command: 'python3 -c "import time; time.sleep(600)"' } }] } }]);
+clock += 30000;
+const result = await waitWorker(claude.id, 0, ctx, runtime);
+assert.equal(result.state, 'long_command', 'exact live encoded session resolves the open tool');
+assert.match(result.command, /time.sleep/); assert.equal(record(claude).session, exactId); assert.equal(record(claude).transcript, file);
+assert.ok(!result.transcriptMissing);
+for (const vendor of ['codex', 'grok']) {
+  clock = epoch;
+  const w = worker(vendor), session = crypto.randomUUID();
+  hook(w, encode(vendor, session), true);
+  const file = transcript(w, session);
+  await waitWorker(w.id, 0, ctx, runtime);
+  assert.equal(record(w).session, session); assert.equal(record(w).transcript, file, `${vendor}: encoded hook before file discovery`);
+}
+clock = epoch;
+const late = worker('codex'), session = crypto.randomUUID();
+const rollout = transcript(late, session);
+await waitWorker(late.id, 0, ctx, runtime);
+assert.equal(record(late).transcript, rollout, 'Codex cwd discovery works before a hook exists');
+hook(late, encode('codex', session));
+await waitWorker(late.id, 0, ctx, runtime);
+assert.equal(record(late).session, session, 'late encoded hooks do not break pinned rollouts');
+const pinned = worker('codex'), pinnedSession = crypto.randomUUID();
+const pinnedFile = transcript(pinned, pinnedSession);
+put(path.join(records, `${pinned.id}.json`), JSON.stringify({ ...pinned, session: encode('codex', pinnedSession), transcript: pinnedFile }));
+await waitWorker(pinned.id, 0, ctx, runtime);
+assert.equal(record(pinned).session, pinnedSession, 'already pinned records also normalize encoded session ids');
+clock = epoch;
+const migrated = worker('claude', { session: encode('claude', exactId + '-saved') });
+const migratedFile = transcript(migrated, exactId + '-saved');
+await waitWorker(migrated.id, 0, ctx, runtime);
+assert.equal(record(migrated).session, exactId + '-saved'); assert.equal(record(migrated).transcript, migratedFile, 'existing encoded registry records recover');
+for (const vendor of ['claude', 'codex', 'grok']) {
+  clock = epoch;
+  const missing = worker(vendor), id = crypto.randomUUID(); hook(missing, encode(vendor, id));
+  clock += 29999;
+  assert.ok(!(await waitWorker(missing.id, 0, ctx, runtime)).transcriptMissing);
+  clock++;
+  assert.equal((await waitWorker(missing.id, 0, ctx, runtime)).transcriptMissing, true, `${vendor}: exact 30-second boundary`);
+  const file = transcript(missing, id);
+  assert.ok(!(await waitWorker(missing.id, 0, ctx, runtime)).transcriptMissing, 'a late transcript clears the diagnostic');
+  assert.equal(record(missing).transcript, file);
+}
+clock = epoch;
+const undated = worker('claude'); hook(undated, encode('claude', crypto.randomUUID()), false, 'invalid');
+assert.ok(!(await waitWorker(undated.id, 0, ctx, runtime)).transcriptMissing);
+clock += 30000;
+assert.equal((await waitWorker(undated.id, 0, ctx, runtime)).transcriptMissing, true, 'missing event timestamp uses persistent first observation');
+clock = epoch;
+const doneMissing = worker('claude'); hook(doneMissing, encode('claude', crypto.randomUUID()));
+fs.appendFileSync(eventFile, jsonl([{ name: 'agent.hook.Stop', surface_id: doneMissing.surface_id, occurred_at: stamp }]));
+clock += 30000;
+const doneResult = await waitWorker(doneMissing.id, 0, ctx, runtime);
+assert.equal(doneResult.state, 'done'); assert.equal(doneResult.transcriptMissing, true, 'completion from hooks still reports a missing transcript');
+for (const session of ['cmux-feed-v1:!!!:bad', encode('grok', 'foreign'), 'cmux-feed-v1:Y2xhdWRl:']) {
+  clock = epoch;
+  const malformed = worker('claude'); hook(malformed, session);
+  await waitWorker(malformed.id, 0, ctx, runtime);
+  assert.equal(record(malformed).session, null, 'invalid or foreign encodings cannot pin a session');
+}
+const cliWorker = worker('claude'); hook(cliWorker, encoded, false, new Date(Date.now() - 31000).toISOString());
+const cli = spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), 'wait', cliWorker.id, '--timeout', '0', '--json'], { env: { ...process.env, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: ctx.workspace }, encoding: 'utf8' });
+assert.equal(cli.status, 4, cli.stderr); assert.equal(JSON.parse(cli.stdout).transcriptMissing, true);
+console.log('agent encoded sessions, Claude filename discovery, Codex ordering, registry recovery and missing-transcript diagnostics passed');
diff --git a/tests/agent-surfaces.mjs b/tests/agent-surfaces.mjs
new file mode 100644
index 0000000..33cd7e5
--- /dev/null
+++ b/tests/agent-surfaces.mjs
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { tempDir } from './fixtures/cleanup.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const home = fs.realpathSync(tempDir('acs-agent-surfaces-'));
+const bin = path.join(home, 'bin'); fs.mkdirSync(bin);
+fs.writeFileSync(path.join(bin, 'cmux'), `#!${process.execPath}\nimport ${JSON.stringify(path.join(root, 'tests/fixtures/agent-cmux.mjs'))};\n`, { mode: 0o755 });
+const env = { ...process.env, HOME: home, PATH: `${bin}:${process.env.PATH}`, CMUX_SOCKET_PATH: 'fake', CMUX_WORKSPACE_ID: 'workspace:1' };
+const run = (args, extra = {}) => spawnSync(process.execPath, [path.join(root, 'bin/agent.mjs'), ...args], { env: { ...env, ...extra }, encoding: 'utf8', timeout: 10000 });
+const json = r => { assert.equal(r.status, 0, r.stderr); return JSON.parse(r.stdout); };
+const statePath = path.join(home, 'fake-cmux.json');
+const state = () => JSON.parse(fs.readFileSync(statePath));
+const mutate = fn => { const s = state(); fn(s); fs.writeFileSync(statePath, JSON.stringify(s)); };
+const calls = verb => state().calls.filter(a => a.includes(verb));
+const open = (extra = {}) => json(run(['open', 'sol', '--cwd', home, 'task', '--json'], extra));
+const first = open();
+mutate(s => { s.panes = s.panes.filter(p => p !== first.pane_ref); });
+const second = open();
+assert.notEqual(second.pane_ref, first.pane_ref, 'a manually removed workers pane is replaced');
+assert.equal(calls('new-pane').length, 2);
+assert.ok(calls('list-pane-surfaces').some(a => a.includes('--workspace') && a.includes('workspace:1') && a.includes('--pane')));
+const third = open();
+assert.equal(third.pane_ref, second.pane_ref, 'an existing pane is reused');
+let count = calls('new-pane').length;
+const raced = open({ FAKE_NEW_SURFACE_ERROR: 'not_found' });
+assert.notEqual(raced.pane_ref, third.pane_ref, 'a disappearing pane during tab creation is replaced once');
+assert.equal(calls('new-pane').length, count + 1);
+const callsBeforeDenied = calls('new-pane').length;
+const denied = run(['open', 'sol', '--cwd', home, 'task'], { FAKE_NEW_SURFACE_ERROR: 'permission_denied' });
+assert.equal(denied.status, 1); assert.match(denied.stderr, /permission_denied/);
+assert.equal(calls('new-pane').length, callsBeforeDenied, 'non-missing errors must not create panes');
+count = calls('new-pane').length;
+const failedRecovery = run(['open', 'sol', '--cwd', home, 'task'], { FAKE_NEW_SURFACE_ERROR: 'not_found', FAKE_NEW_PANE_ERROR: 'not_found', FAKE_ERROR_STYLE: 'stderr' });
+assert.equal(failedRecovery.status, 1); assert.equal(calls('new-pane').length, count + 1, 'recovery is bounded');
+const missing = run(['wait', first.id, '--timeout', '0', '--json']);
+assert.equal(missing.status, 8, missing.stderr); assert.equal(JSON.parse(missing.stdout).state, 'closed');
+assert.equal(JSON.parse(missing.stdout).closed, true);
+const record = id => JSON.parse(fs.readFileSync(path.join(home, '.agent-config-studio/agents', `${id}.json`)));
+assert.equal(record(first.id).status, 'closed');
+assert.equal(run(['wait', first.id, '--timeout', '0']).stdout.trim(), 'closed');
+assert.equal(run(['wait', first.id, '--timeout', '0']).status, 8);
+json(run(['close', first.id, '--json']));
+const explicit = open(); json(run(['close', explicit.id, '--json']));
+assert.equal(run(['wait', explicit.id, '--timeout', '0']).status, 8);
+mutate(s => { s.workers[third.surface_ref].closed = true; });
+json(run(['close', third.id, '--json']));
+assert.equal(record(third.id).status, 'closed', 'close is idempotent after manual surface removal');
+const idle = open();
+json(run(['wait', idle.id, '--timeout', '0', '--json']));
+const idlePath = path.join(home, '.agent-config-studio/agents', `${idle.id}.json`);
+const idleRecord = record(idle.id);
+idleRecord.lastActivityAt = Date.now() - 31 * 60000;
+idleRecord.finishedAt = idleRecord.lastActivityAt;
+fs.writeFileSync(idlePath, JSON.stringify(idleRecord));
+const expired = run(['wait', idle.id, '--timeout', '0', '--json']);
+assert.equal(expired.status, 8, expired.stderr);
+assert.equal(JSON.parse(expired.stdout).state, 'closed');
+assert.equal(JSON.parse(expired.stdout).closed, true);
+const moving = open({ FAKE_RUNNING: '1' });
+const vanished = run(['wait', moving.id, '--timeout', '3', '--json'], { FAKE_REMOVE_AFTER_READ: '1', FAKE_ERROR_STYLE: 'stderr' });
+assert.equal(vanished.status, 8, vanished.stderr); assert.equal(JSON.parse(vanished.stdout).state, 'closed');
+assert.equal(record(moving.id).status, 'closed');
+const offline = open({ FAKE_RUNNING: '1' });
+const screenError = run(['wait', offline.id, '--timeout', '0'], { FAKE_READ_SCREEN_ERROR: 'permission_denied' });
+assert.equal(screenError.status, 1); assert.match(screenError.stderr, /permission_denied/);
+assert.notEqual(record(offline.id).status, 'closed', 'unrelated screen errors must not close a worker');
+assert.equal(run(['wait', offline.id, '--timeout', '0'], { FAKE_OFFLINE: '1' }).status, 2, 'socket errors are not closure');
+assert.notEqual(record(offline.id).status, 'closed');
+console.log('agent stale-pane recovery, bounded race retry, missing surfaces, closure exit 8 and unrelated errors passed');
diff --git a/tests/fixtures/agent-cmux.mjs b/tests/fixtures/agent-cmux.mjs
new file mode 100644
index 0000000..aed52b9
--- /dev/null
+++ b/tests/fixtures/agent-cmux.mjs
@@ -0,0 +1,103 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+const home = process.env.HOME;
+const file = path.join(home, 'fake-cmux.json');
+const state = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : { n: 0, calls: [], workers: {} };
+const args = process.argv.slice(2);
+state.panes ||= ['pane:1'];
+const verbs = ['list-panes', 'identify', 'new-pane', 'new-surface', 'focus-pane', 'send', 'send-key', 'read-screen', 'close-surface', 'list-pane-surfaces'];
+const cmd = args.find(a => verbs.includes(a));
+const opt = k => args[args.indexOf(k) + 1];
+state.calls.push(args);
+const put = (f, data) => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, data); };
+const line = x => JSON.stringify(x) + '\n';
+function turn(w, text, complete = true) {
+  if (w.vendor === 'codex') {
+    fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'task_started' } }));
+    fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'user_message', message: text } }));
+    if (complete) fs.appendFileSync(w.transcript, line({ type: 'event_msg', payload: { type: 'task_complete', last_agent_message: 'exact\nanswer  ' } }));
+  } else if (w.vendor === 'claude') {
+    fs.appendFileSync(w.transcript, line({ type: 'user', message: { role: 'user', content: text } }));
+    if (complete) {
+      fs.appendFileSync(w.transcript, line({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: 'exact\nanswer  ' }] }, stop_reason: 'end_turn' }));
+      fs.appendFileSync(path.join(home, '.cmuxterm/events.jsonl'), line({ name: 'agent.hook.Stop', surface_id: w.surface_id, session_id: w.session, occurred_at: new Date().toISOString() }));
+    }
+  } else {
+    fs.appendFileSync(w.transcript, line({ type: 'turn_started' }));
+    fs.appendFileSync(w.history, line({ role: 'user', content: text }));
+    if (complete) {
+      fs.appendFileSync(w.history, line({ role: 'assistant', content: 'exact\nanswer  ' }));
+      fs.appendFileSync(w.transcript, line({ type: 'turn_ended' }));
+    }
+  }
+}
+if (process.env.FAKE_OFFLINE) { console.error('socket unreachable'); process.exit(1); }
+function fail(code) {
+  put(file, JSON.stringify(state));
+  if (process.env.FAKE_ERROR_STYLE === 'stderr') console.error(`Error: ${code}: Surface not found for the given surface_id`);
+  else console.log(JSON.stringify({ ok: false, error: { code, message: 'Surface not found for the given surface_id' } }));
+  process.exit(1);
+}
+let out = {};
+if (cmd === 'list-panes') out = { panes: state.panes.map(pane_ref => ({ pane_ref })) };
+if (cmd === 'new-surface' && process.env.FAKE_NEW_SURFACE_ERROR) fail(process.env.FAKE_NEW_SURFACE_ERROR);
+if (cmd === 'new-surface' && !state.panes.includes(opt('--pane'))) fail('not_found');
+if (cmd === 'new-pane' && process.env.FAKE_NEW_PANE_ERROR) fail(process.env.FAKE_NEW_PANE_ERROR);
+if (cmd === 'read-screen' && process.env.FAKE_READ_SCREEN_ERROR) fail(process.env.FAKE_READ_SCREEN_ERROR);
+if (cmd === 'list-pane-surfaces' && !state.panes.includes(opt('--pane'))) fail('not_found');
+if (cmd === 'identify') out = { caller: { workspace_ref: 'workspace:1', pane_ref: process.env.FAKE_PANE || 'pane:1' } };
+if (cmd === 'new-pane' || cmd === 'new-surface') {
+  const n = ++state.n;
+  const script = fs.readFileSync(opt('--command'), 'utf8');
+  const vendor = script.includes('exec codex ') ? 'codex' : script.includes('exec claude ') ? 'claude' : 'grok';
+  const cwd = script.match(/cd '((?:[^']|'\\'')*)'/)[1].replace(/'\\''/g, "'");
+  const session = `session-${n}`;
+  const w = { vendor, cwd, session, surface_id: `UUID-${n}`, surface_ref: `surface:${n + 10}` };
+  if (vendor === 'codex') {
+    w.transcript = path.join(process.env.CODEX_HOME || path.join(home, '.codex'), 'sessions/2026/11/14', `rollout-${session}.jsonl`);
+    put(w.transcript, line({ type: 'session_meta', payload: { id: session, cwd } }));
+  } else if (vendor === 'claude') {
+    w.transcript = path.join(process.env.CLAUDE_CONFIG_DIR || path.join(home, '.claude'), 'projects', cwd.replace(/\//g, '-'), `${session}.jsonl`);
+    put(w.transcript, '');
+  } else {
+    w.transcript = path.join(process.env.GROK_HOME || path.join(home, '.grok'), 'sessions', cwd.replace(/\//g, '%2F'), session, 'events.jsonl');
+    w.history = path.join(path.dirname(w.transcript), 'chat_history.jsonl');
+    put(w.transcript, ''); put(w.history, '');
+  }
+  const events = path.join(home, '.cmuxterm/events.jsonl');
+  if (!fs.existsSync(events)) put(events, '');
+  fs.appendFileSync(events, line({ name: 'agent.hook.SessionStart', surface_id: w.surface_id, session_id: session, occurred_at: new Date().toISOString() }));
+  turn(w, 'initial', !process.env.FAKE_RUNNING);
+  w.pane_ref = cmd === 'new-pane' ? `pane:${n + 10}` : opt('--pane');
+  if (cmd === 'new-pane') state.panes.push(w.pane_ref);
+  state.workers[w.surface_ref] = w;
+  out = { ...w };
+}
+function permission(w) {
+  w.screen = 'Do you want to proceed?\n1. Yes\n2. No';
+  fs.appendFileSync(path.join(home, '.cmuxterm/events.jsonl'), line({ name: 'agent.hook.PermissionRequest', surface_id: w.surface_id, occurred_at: new Date().toISOString() }));
+}
+if (cmd === 'send') {
+  const w = state.workers[opt('--surface')]; w.pending = (w.pending || '') + args.at(-1); w.enters = 0;
+  if (process.env.FAKE_PERMISSION_ON_SEND) permission(w);
+}
+if (cmd === 'send-key') {
+  const w = state.workers[opt('--surface')];
+  if (++w.enters === 1 && process.env.FAKE_PERMISSION_AFTER_ENTER) permission(w);
+  if (w.enters === 2 && !process.env.FAKE_NO_SUBMIT) { turn(w, w.pending); w.pending = ''; }
+}
+if (cmd === 'read-screen' || cmd === 'close-surface') {
+  const w = state.workers[opt('--surface')];
+  if (cmd === 'read-screen' && process.env.FAKE_REMOVE_AFTER_READ && (state.removalReads = (state.removalReads || 0) + 1) > 1) w.closed = true;
+  if (!w || w.closed || !state.panes.includes(w.pane_ref)) fail('not_found');
+  if (cmd === 'close-surface') w.closed = true;
+  else {
+    const events = fs.readFileSync(path.join(home, '.cmuxterm/events.jsonl'), 'utf8').split('\n').filter(Boolean).map(JSON.parse);
+    const pending = events.some(e => e.surface_id === w.surface_id && e.name === 'agent.hook.PermissionRequest');
+    out = { text: w.screen ?? (pending || w.vendor === 'grok' && !fs.existsSync(w.history) ? 'Allow this command?\n1. Yes' : 'Worker screen') };
+  }
+}
+if (cmd === 'list-pane-surfaces') out = { surfaces: Object.values(state.workers).filter(w => !w.closed && (!args.includes('--pane') || w.pane_ref === opt('--pane'))) };
+put(file, JSON.stringify(state));
+console.log(JSON.stringify(out));
