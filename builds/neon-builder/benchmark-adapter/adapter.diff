+function agyBuilderAvailable() {
+  if (process.platform !== 'darwin' || !fs.existsSync('/usr/bin/sandbox-exec') || !onPath('agy')) return false;
+  const r = spawnBg('ask-model', ['--help'], { encoding: 'utf8', timeout: 15_000 });
