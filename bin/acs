#!/bin/sh
# Launch Agent Config Studio and open it in the browser.
# If it is already running, just focus the tab.
#
# POSIX sh on purpose. This is the entry point people are told to run, so it has
# to work wherever node does — a zsh-only launcher fails on a stock Linux box
# (and in CI) with a bare "No such file or directory" that names zsh, not us.

set -e
DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)
PORT="${ACS_PORT:-8787}"
URL="http://localhost:$PORT"

# Identify the app by its health endpoint, never by "something owns the port" —
# otherwise `acs stop` could kill an unrelated listener.
is_acs() {
  curl -sf --max-time 2 "$URL/api/health" 2>/dev/null | grep -q agent-config-studio
}

# Port check without lsof: it is absent on many Linux images, and a launcher
# that mistakes "no lsof" for "port free" would start a second server.
port_busy() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti:"$PORT" >/dev/null 2>&1
  else
    curl -sf --max-time 1 -o /dev/null "$URL" 2>/dev/null
  fi
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1
  else echo "open $1 in your browser"
  fi
}

case "$1" in
  usage)
    # The studio's onboarding tells people to run `acs usage`, so it has to
    # exist. Everything after the subcommand is forwarded verbatim.
    shift
    exec node "$DIR/bin/usage.mjs" "$@"
    ;;
  install-model-id)
    # Copies the resolver out of this checkout and links ~/.local/bin/model-id,
    # so skills keep resolving when a worktree is removed. Re-run after a pull.
    exec node "$DIR/bin/model-id" --install
    ;;
  stop)
    if is_acs; then
      # Only kill processes LISTENING on the port, not clients connected to it.
      if command -v lsof >/dev/null 2>&1; then
        pids=$(lsof -t -sTCP:LISTEN -i:"$PORT" 2>/dev/null || true)
        if [ -n "$pids" ]; then
          # Unquoted on purpose: several pids must word-split into arguments.
          # shellcheck disable=SC2086
          kill $pids && echo "stopped."
        else
          echo "not running."
        fi
      else
        echo "cannot stop without lsof — quit the process that is serving $URL." >&2
        exit 1
      fi
    elif port_busy; then
      echo "port $PORT is in use by something else — not touching it." >&2
      exit 1
    else
      echo "not running."
    fi
    exit 0
    ;;
esac

if is_acs; then
  echo "already running → $URL"
  open_url "$URL"
  exit 0
fi

if port_busy; then
  echo "port $PORT is in use by another process. Set ACS_PORT to pick a different one." >&2
  exit 1
fi

echo "starting Agent Config Studio…"
PORT="$PORT" node "$DIR/server.js" &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null' INT TERM

# Wait for the port to accept connections before opening the browser.
n=0
while [ "$n" -lt 40 ]; do
  if port_busy; then break; fi
  n=$((n + 1))
  sleep 0.25
done
open_url "$URL"
wait $SERVER_PID
