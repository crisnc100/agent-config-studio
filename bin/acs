#!/bin/sh
# Launch Agent Config Studio and open it in the browser.
# If it is already running, just focus the tab.
#
# POSIX sh on purpose. This is the entry point people are told to run, so it has
# to work wherever node does — a zsh-only launcher fails on a stock Linux box
# (and in CI) with a bare "No such file or directory" that names zsh, not us.

set -e
DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)
PORT="${ACS_PORT:-8787}"
URL="http://localhost:$PORT"

# Identify the app by its health endpoint, never by "something owns the port" —
# otherwise `acs stop` could kill an unrelated listener.
is_acs() {
  curl -sf --max-time 2 "$URL/api/health" 2>/dev/null | grep -q agent-config-studio
}

# Port check without lsof: it is absent on many Linux images, and a launcher
# that mistakes "no lsof" for "port free" would start a second server.
port_busy() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti:"$PORT" >/dev/null 2>&1
  else
    curl -sf --max-time 1 -o /dev/null "$URL" 2>/dev/null
  fi
}

# Bring this checkout up to the remote's default branch before starting, so
# `acs` after a merge runs the merged code. Only a clean checkout sitting on
# that branch is fast-forwarded; a feature branch, local edits or no network
# start what is here, and the last two say why. Returns 10 when it moved HEAD.
update_checkout() {
  [ -z "${ACS_NO_UPDATE:-}" ] || return 0
  command -v git >/dev/null 2>&1 || return 0
  git -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  base=$(git -C "$DIR" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
  base=${base#origin/}
  branch=$(git -C "$DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [ "$branch" = "$base" ] || return 0
  if [ -n "$(git -C "$DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    echo "not updating: this checkout has local changes — starting it as it is."
    return 0
  fi
  before=$(git -C "$DIR" rev-parse HEAD)
  # GIT_TERMINAL_PROMPT=0 and the low-speed limit keep a dead network or a
  # credential prompt from hanging the launcher.
  if ! GIT_TERMINAL_PROMPT=0 git -C "$DIR" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
      pull --ff-only --quiet origin "$base" >/dev/null 2>&1; then
    echo "could not update from origin (offline, or $base has diverged) — starting $(git -C "$DIR" rev-parse --short HEAD) as it is."
    return 0
  fi
  after=$(git -C "$DIR" rev-parse HEAD)
  [ "$before" != "$after" ] || return 0
  echo "updated to $(git -C "$DIR" log -1 --format='%h %s' "$after")"
  # Installed copies live outside this checkout and do not follow a pull.
  if git -C "$DIR" diff --quiet "$before" "$after" -- tools/worktree; then :; else
    echo "  tools/worktree changed — run: acs install-worktree"
  fi
  if git -C "$DIR" diff --quiet "$before" "$after" -- bin/model-id models.default.json; then :; else
    echo "  the model-id resolver changed — run: acs install-model-id"
  fi
  return 10
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1
  else echo "open $1 in your browser"
  fi
}

case "$1" in
  usage)
    # The studio's onboarding tells people to run `acs usage`, so it has to
    # exist. Everything after the subcommand is forwarded verbatim.
    shift
    exec node "$DIR/bin/usage.mjs" "$@"
    ;;
  install-worktree)
    # Copies tools/worktree into ~/.config/worktree and makes ~/.zshrc source
    # it. Exits here: installing never starts the studio. Re-run after a pull.
    shift
    exec node "$DIR/bin/install-worktree.mjs" "$@"
    ;;
  install-model-id)
    # Copies the resolver out of this checkout and links ~/.local/bin/model-id,
    # so skills keep resolving when a worktree is removed. Re-run after a pull.
    exec node "$DIR/bin/model-id" --install
    ;;
  update)
    # Pull only; never starts the studio.
    update_checkout || [ $? -eq 10 ]
    exit 0
    ;;
  stop)
    if is_acs; then
      # Only kill processes LISTENING on the port, not clients connected to it.
      if command -v lsof >/dev/null 2>&1; then
        pids=$(lsof -t -sTCP:LISTEN -i:"$PORT" 2>/dev/null || true)
        if [ -n "$pids" ]; then
          # Unquoted on purpose: several pids must word-split into arguments.
          # shellcheck disable=SC2086
          kill $pids && echo "stopped."
        else
          echo "not running."
        fi
      else
        echo "cannot stop without lsof — quit the process that is serving $URL." >&2
        exit 1
      fi
    elif port_busy; then
      echo "port $PORT is in use by something else — not touching it." >&2
      exit 1
    else
      echo "not running."
    fi
    exit 0
    ;;
esac

if is_acs; then
  echo "already running → $URL"
  open_url "$URL"
  exit 0
fi

if port_busy; then
  echo "port $PORT is in use by another process. Set ACS_PORT to pick a different one." >&2
  exit 1
fi

rc=0
update_checkout || rc=$?
# The pull may have replaced this very script: start the new one, once.
if [ "$rc" -eq 10 ]; then ACS_NO_UPDATE=1 exec "$0" "$@"; fi

echo "starting Agent Config Studio…"
PORT="$PORT" node "$DIR/server.js" &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null' INT TERM

# Wait for the port to accept connections before opening the browser.
n=0
while [ "$n" -lt 40 ]; do
  if port_busy; then break; fi
  n=$((n + 1))
  sleep 0.25
done
open_url "$URL"
wait $SERVER_PID
