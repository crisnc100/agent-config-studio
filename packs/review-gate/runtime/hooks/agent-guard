#!/bin/sh
folder=${0%/*}
# node: the path pinned in node-path beside this file when it is executable, else node on PATH.
node=
if [ -r "$folder/node-path" ]; then IFS= read -r node < "$folder/node-path" || :; fi
{ [ -n "$node" ] && [ -x "$node" ]; } || node=node
if command -v "$node" >/dev/null 2>&1 && "$node" --version >/dev/null 2>&1; then
  exec "$node" "$folder/agent-guard.mjs"
fi
input=$(cat)
if printf '%s' "$input" | LC_ALL=C grep -Ei 'no-veri|hookspath|reviewgate' >/dev/null 2>&1 ||
   { printf '%s' "$input" | LC_ALL=C grep -i 'commit' >/dev/null 2>&1 &&
     printf '%s' "$input" | LC_ALL=C grep -E -- '-[[:alpha:]]*n' >/dev/null 2>&1; }; then
  printf '%s\n' 'review gate: agents may not bypass review hooks; node could not start' >&2
  exit 2
fi
printf '%s\n' 'review gate: warning: node could not start; command was not checked' >&2
exit 0
